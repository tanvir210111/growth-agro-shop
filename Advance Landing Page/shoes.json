.now{font-family:&#039;Tiro Bangla&#039;; font-size:19px; color:var(--forest); line-height:1;}\\r\\n.swing-tag .old{font-size:11px; color:var(--muted); text-decoration:line-through; margin-top:2px;}\\r\\n\\r\\n/* --- section generic --- */\\r\\nsection{padding:34px 20px;}\\r\\n.section-head{margin-bottom:20px;}\\r\\n.section-head .tag{\\r\\n  font-size:11.5px; font-weight:700; color:var(--gold);\\r\\n  text-transform:uppercase; letter-spacing:1.2px;\\r\\n}\\r\\n.section-head.light .tag{color:var(--gold-soft);}\\r\\n.section-head h2{font-size:23px; margin-top:6px; color:var(--ink);}\\r\\n.section-head.light h2{color:var(--cream);}\\r\\n\\r\\n/* --- swatches --- */\\r\\n.swatches{\\r\\n  display:flex; gap:12px; overflow-x:auto; padding-bottom:8px;\\r\\n  scrollbar-width:none;\\r\\n}\\r\\n.swatches::-webkit-scrollbar{display:none;}\\r\\n.swatch-card{\\r\\n  flex:0 0 122px;\\r\\n  background:var(--paper);\\r\\n  padding:10px;\\r\\n  border:1px solid var(--line);\\r\\n  border-radius:3px;\\r\\n  transition:transform .18s ease, box-shadow .18s ease;\\r\\n}\\r\\n.swatch-card:active{transform:translateY(-2px); box-shadow:0 10px 20px -8px #16241C33;}\\r\\n.swatch-img{\\r\\n  aspect-ratio:1/1; margin-bottom:10px; border-radius:2px;\\r\\n  position:relative; overflow:hidden;\\r\\n}\\r\\n.swatch-img::after{\\r\\n  content:&quot;&quot;;\\r\\n  position:absolute; inset:0;\\r\\n  background:repeating-linear-gradient(115deg, #ffffff14 0 2px, transparent 2px 10px);\\r\\n}\\r\\n.swatch-navy{background:#22344A;}\\r\\n.swatch-olive{background:#5C6B4F;}\\r\\n.swatch-maroon{background:#6E2B2B;}\\r\\n.swatch-charcoal{background:#26282A;}\\r\\n.swatch-card h4{font-size:13.5px; margin-bottom:2px; color:var(--ink);}\\r\\n.swatch-card .p{font-size:12.5px; color:var(--gold); font-weight:700;}\\r\\n\\r\\n/* --- dark band: why us --- */\\r\\n.dark-band{background:var(--forest);}\\r\\n.why-list{display:flex; flex-direction:column;}\\r\\n.why-item{\\r\\n  display:flex; align-items:flex-start; gap:18px;\\r\\n  padding:18px 0;\\r\\n  border-bottom:1px solid #F6F1E41a;\\r\\n}\\r\\n.why-item:last-child{border-bottom:none;}\\r\\n.num{\\r\\n  flex:0 0 auto;\\r\\n  font-family:&#039;Tiro Bangla&#039;;\\r\\n  font-size:28px;\\r\\n  color:transparent;\\r\\n  -webkit-text-stroke:1px var(--gold-soft);\\r\\n  min-width:44px;\\r\\n}\\r\\n.why-item h4{font-size:15px; margin-bottom:4px; color:var(--cream);}\\r\\n.why-item p{font-size:13px; color:#AEBAAB; line-height:1.6;}\\r\\n\\r\\n/* --- size chart --- */\\r\\n.size-table{\\r\\n  width:100%; border-collapse:collapse;\\r\\n  font-size:13px;\\r\\n  background:#fff;\\r\\n  border-radius:3px;\\r\\n  overflow:hidden;\\r\\n  box-shadow:0 1px 0 var(--line);\\r\\n}\\r\\n.size-table th{\\r\\n  background:var(--forest); color:var(--gold-soft);\\r\\n  padding:11px 6px; font-weight:600; font-size:12.5px;\\r\\n  letter-spacing:.3px;\\r\\n}\\r\\n.size-table td{\\r\\n  padding:12px 6px; text-align:center;\\r\\n  border-top:1px solid var(--line);\\r\\n}\\r\\n.size-table tr:nth-child(even) td{background:var(--cream);}\\r\\n\\r\\n/* --- reviews --- */\\r\\n.review-card{\\r\\n  position:relative;\\r\\n  background:var(--paper);\\r\\n  padding:20px 18px 16px;\\r\\n  margin-bottom:12px;\\r\\n  border:1px solid var(--line);\\r\\n  border-radius:3px;\\r\\n}\\r\\n.quote-mark{\\r\\n  position:absolute; top:6px; right:14px;\\r\\n  font-family:&#039;Tiro Bangla&#039;; font-size:44px; color:var(--gold);\\r\\n  opacity:.28; line-height:1;\\r\\n}\\r\\n.review-card .stars{color:var(--gold); font-size:13px; margin-bottom:8px;}\\r\\n.review-card p{font-size:13.5px; line-height:1.55; color:var(--ink); margin-bottom:8px; position:relative;}\\r\\n.review-card .who{font-size:12px; color:var(--muted); font-weight:600;}\\r\\n\\r\\n/* --- order box --- */\\r\\n.order-box{\\r\\n  position:relative;\\r\\n  background:linear-gradient(160deg,var(--forest),#0A150F);\\r\\n  padding:32px 24px;\\r\\n  color:var(--cream);\\r\\n}\\r\\n.order-box .corner{position:absolute; width:22px; height:22px; border:1px solid var(--gold);}\\r\\n.order-box .corner.tl{top:10px; left:10px; border-right:none; border-bottom:none;}\\r\\n.order-box .corner.tr{top:10px; right:10px; border-left:none; border-bottom:none;}\\r\\n.order-box .corner.bl{bottom:10px; left:10px; border-right:none; border-top:none;}\\r\\n.order-box .corner.br{bottom:10px; right:10px; border-left:none; border-top:none;}\\r\\n.order-box h2{font-size:23px; margin-bottom:8px; color:var(--cream);}\\r\\n.order-box p{font-size:13px; color:#B9C2B6; margin-bottom:18px;}\\r\\n.order-box .price-line{\\r\\n  display:flex; align-items:baseline; gap:10px; margin-bottom:18px;\\r\\n}\\r\\n.order-box .price-line .now{\\r\\n  font-family:&#039;Tiro Bangla&#039;; font-size:30px; color:var(--gold-soft);\\r\\n}\\r\\n.order-box .price-line .old{\\r\\n  font-size:15px; text-decoration:line-through; color:#7C8C79;\\r\\n}\\r\\n.final-cta{\\r\\n  display:flex; align-items:center; justify-content:center; gap:10px;\\r\\n  background:var(--gold);\\r\\n  color:var(--forest);\\r\\n  font-family:&#039;Hind Siliguri&#039;; font-weight:700; font-size:16px;\\r\\n  padding:16px;\\r\\n  border-radius:2px;\\r\\n  text-decoration:none;\\r\\n  box-shadow:0 10px 24px -8px #C9A24B77;\\r\\n}\\r\\n.pay-note{\\r\\n  text-align:center; font-size:11.5px; color:#8B9A88; margin-top:12px;\\r\\n}\\r\\n\\r\\n#order{padding-bottom:96px;}\\r\\n\\r\\n/* --- sticky mobile bar --- */\\r\\n.sticky-bar{\\r\\n  position:sticky; bottom:0; left:0; right:0;\\r\\n  max-width:480px; margin:0 auto;\\r\\n  background:#ffffffee;\\r\\n  backdrop-filter:blur(8px);\\r\\n  border-top:1px solid var(--line);\\r\\n  padding:10px 16px;\\r\\n  display:flex; align-items:center; gap:12px;\\r\\n  box-shadow:0 -6px 20px rgba(0,0,0,.1);\\r\\n}\\r\\n.sticky-bar .info{flex:1;}\\r\\n.sticky-bar .info .p{\\r\\n  font-family:&#039;Tiro Bangla&#039;; font-size:18px; color:var(--ink);\\r\\n}\\r\\n.sticky-bar .info .s{font-size:10.5px; color:var(--muted);}\\r\\n.sticky-bar a{\\r\\n  background:var(--forest); color:var(--gold-soft); text-decoration:none;\\r\\n  font-family:&#039;Hind Siliguri&#039;; font-weight:700; font-size:14px;\\r\\n  padding:11px 22px; border-radius:2px;\\r\\n}\\r\\n\\r\\n/* ============ TABLET / DESKTOP ============ */\\r\\n@media (min-width:900px){\\r\\n  .wrap{max-width:100%;}\\r\\n\\r\\n  header{padding:18px 48px;}\\r\\n  header .brand{font-size:22px;}\\r\\n  header .badge{font-size:11.5px; padding:6px 14px;}\\r\\n  .head-cta{display:block;}\\r\\n\\r\\n  .hero{\\r\\n    padding:0;\\r\\n    display:flex;\\r\\n    align-items:stretch;\\r\\n    min-height:560px;\\r\\n  }\\r\\n  .hero-bg{inset:0;}\\r\\n  .hero-content{\\r\\n    flex:1 1 50%; display:flex; flex-direction:column; justify-content:center;\\r\\n    padding:0 0 0 64px; max-width:620px;\\r\\n  }\\r\\n  .hero h1{font-size:50px; max-width:12ch;}\\r\\n  .hero p.sub{max-width:42ch; font-size:16.5px;}\\r\\n  .hero-cta{width:auto; padding:16px 32px;}\\r\\n  .trust-row{max-width:420px;}\\r\\n\\r\\n  .hero-img-frame{\\r\\n    flex:1 1 50%; margin:56px 64px 56px 40px; align-self:center;\\r\\n  }\\r\\n\\r\\n  section{padding:64px 48px;}\\r\\n  .section-head h2{font-size:30px;}\\r\\n  .section-head{max-width:640px; margin:0 auto 32px;}\\r\\n\\r\\n  .swatches{\\r\\n    display:grid; grid-template-columns:repeat(4,1fr);\\r\\n    overflow:visible; gap:22px;\\r\\n  }\\r\\n  .swatch-card{flex:none;}\\r\\n  .swatch-card:hover{transform:translateY(-4px); box-shadow:0 14px 26px -10px #16241C33;}\\r\\n\\r\\n  .why-list{\\r\\n    display:grid; grid-template-columns:repeat(3,1fr); gap:0 36px;\\r\\n  }\\r\\n  .why-item{border-bottom:none; border-top:1px solid #F6F1E41a; padding:26px 0;}\\r\\n\\r\\n  .size-table{max-width:600px; margin:0 auto; font-size:14.5px;}\\r\\n  .size-table th, .size-table td{padding:15px 10px;}\\r\\n\\r\\n  .review-card{margin-bottom:0;}\\r\\n  .reviews-grid{\\r\\n    display:grid; grid-template-columns:repeat(3,1fr); gap:18px;\\r\\n  }\\r\\n\\r\\n  .order-box{max-width:780px; margin:0 auto; padding:56px 64px;}\\r\\n  .order-box h2{font-size:30px;}\\r\\n  .order-box p{font-size:14.5px; max-width:50ch;}\\r\\n  .final-cta{width:auto; padding:16px 36px; display:inline-flex;}\\r\\n  .pay-note{text-align:left;}\\r\\n\\r\\n  #order{padding-bottom:64px;}\\r\\n\\r\\n  .sticky-bar{display:none;}\\r\\n}\\r\\n\\r\\n@media (min-width:1200px){\\r\\n  .hero h1{font-size:56px;}\\r\\n}\\r\\n\\r\\n@media (max-width:480px){\\r\\n  body{background:var(--paper);}\\r\\n}\\r\\n@media (min-width:481px) and (max-width:899px){\\r\\n  body{background:#E5E0D2;}\\r\\n  .wrap{max-width:600px; box-shadow:0 0 40px rgba(0,0,0,.15); margin:20px auto;}\\r\\n}\\r\\n\\r\\n@media (prefers-reduced-motion: reduce){\\r\\n  .reveal{opacity:1; transform:none; transition:none;}\\r\\n}\"],\"_elementor_page_assets\":[\"a:1:{s:7:\\\"scripts\\\";a:1:{i:0;s:18:\\\"elementor-frontend\\\";}}\"],\"wcf-pro-dynamic-css\":[\"\"],\"wcf-dynamic-css\":[\"\\n\\t\\t\\t.wcf-embed-checkout-form .woocommerce #payment #place_order:before{\\n\\t\\t\\t\\tcontent: \\\"\\\\e902\\\";\\n\\t\\t\\t\\tfont-family: \\\"cartflows-icon\\\" !important;\\n\\t\\t\\t\\tmargin-right: 10px;\\n\\t\\t\\t\\tfont-size: 16px;\\n\\t\\t\\t\\tfont-weight: 500;\\n\\t\\t\\t\\ttop: 0px;\\n    \\t\\t\\tposition: relative;\\n\\t\\t\\t\\topacity: 1;\\n\\t\\t\\t\\tdisplay: block;\\n\\t\\t\\t}\"],\"wcf-field-google-font-url\":[\"\"]},\"post_content\":\"<!DOCTYPE html>\\n<html lang=\\\"bn\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0, viewport-fit=cover\\\">\\n<title>AeroStep — প্রিমিয়াম কমফোর্ট স্নিকার্স</title>\\n<meta name=\\\"description\\\" content=\\\"সারাদিন হাঁটুন, একদম আরাম নিয়ে। AeroStep স্নিকার্স — হালকা, টেকসই, স্টাইলিশ।\\\">\\n<link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\">\\n<link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin>\\n<link href=\\\"https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap\\\" rel=\\\"stylesheet\\\">\\n<style>\\n  :root{\\n    --primary:#FF6B00;\\n    --primary-dark:#E35F00;\\n    --primary-tint:#FFF1E6;\\n    --ink:#111111;\\n    --ink-soft:#4B4B52;\\n    --bg:#FFFFFF;\\n    --bg-alt:#FAF9F8;\\n    --success:#22C55E;\\n    --danger:#EF4444;\\n    --accent:#2563EB;\\n    --line:#ECEAE7;\\n    --container:1200px;\\n    --radius:18px;\\n    --radius-btn:14px;\\n    --shadow-sm:0 2px 10px rgba(17,17,17,.05);\\n    --shadow-md:0 12px 32px rgba(17,17,17,.08);\\n    --shadow-lg:0 24px 60px rgba(17,17,17,.14);\\n    --shadow-primary:0 14px 30px rgba(255,107,0,.28);\\n    --font-display:'Hind Siliguri','Poppins', sans-serif;\\n    --font-body:'Hind Siliguri', sans-serif;\\n  }\\n  *{box-sizing:border-box;margin:0;padding:0;}\\n  html{scroll-behavior:smooth;}\\n  body{font-family:var(--font-body);color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased;line-height:1.65;overflow-x:hidden;}\\n  img{max-width:100%;display:block;}\\n  a{color:inherit;text-decoration:none;}\\n  ul{list-style:none;}\\n  button{font-family:inherit;cursor:pointer;border:none;background:none;}\\n  .container{width:100%;max-width:var(--container);margin:0 auto;padding:0 24px;}\\n  section{position:relative;}\\n  h1,h2,h3,h4{font-family:var(--font-display);font-weight:700;line-height:1.28;color:var(--ink);}\\n  .eng{font-family:'Poppins', sans-serif;}\\n  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:13px;font-weight:600;color:var(--primary-dark);background:var(--primary-tint);padding:7px 14px;border-radius:999px;}\\n  .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;font-weight:700;font-size:16.5px;padding:16px 30px;border-radius:var(--radius-btn);transition:transform .22s ease, box-shadow .22s ease;white-space:nowrap;}\\n  .btn-primary{background:linear-gradient(180deg,#FF7A1A,var(--primary));color:#fff;box-shadow:var(--shadow-primary);}\\n  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 18px 38px rgba(255,107,0,.36);}\\n  .btn-ghost{background:#fff;color:var(--ink);border:1.5px solid var(--line);}\\n  .btn-ghost:hover{border-color:var(--ink);transform:translateY(-2px);}\\n  .btn-block{width:100%;}\\n  .btn-lg{padding:19px 36px;font-size:19px;}\\n  .reveal{opacity:0;transform:translateY(26px);transition:opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1);}\\n  .reveal.in-view{opacity:1;transform:translateY(0);}\\n  .reveal-delay-1{transition-delay:.08s;}\\n  .reveal-delay-2{transition-delay:.16s;}\\n  .reveal-delay-3{transition-delay:.24s;}\\n  @media (prefers-reduced-motion: reduce){.reveal{opacity:1;transform:none;transition:none;}html{scroll-behavior:auto;}}\\n  /* NAV */\\n  .nav{position:sticky;top:0;z-index:60;background:rgba(255,255,255,.85);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line);}\\n  .nav-inner{display:flex;align-items:center;justify-content:space-between;height:74px;}\\n  .brand{display:flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:800;font-size:19px;}\\n  .brand-mark{width:32px;height:32px;border-radius:9px;background:linear-gradient(135deg,var(--primary),#FFB25C);display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px;font-weight:800;}\\n  .nav-cta{display:flex;align-items:center;gap:14px;}\\n  .nav-price{display:none;}\\n  @media(min-width:860px){.nav-price{display:inline-block;font-weight:700;color:var(--ink-soft);font-size:14px;}}\\n  /* HERO */\\n  .hero{padding:52px 0 60px;background:radial-gradient(680px 420px at 82% -8%, rgba(255,107,0,.10), transparent 60%),radial-gradient(520px 360px at -6% 30%, rgba(37,99,235,.06), transparent 60%),var(--bg);overflow:hidden;}\\n  .hero-grid{display:grid;grid-template-columns:1fr;gap:44px;align-items:center;}\\n  @media(min-width:960px){.hero-grid{grid-template-columns:.95fr 1.05fr;gap:56px;}}\\n  .badge-pulse{display:inline-flex;align-items:center;gap:8px;background:var(--ink);color:#fff;font-weight:600;font-size:13.5px;padding:8px 16px;border-radius:999px;margin-bottom:22px;}\\n  .badge-dot{width:7px;height:7px;border-radius:50%;background:var(--primary);animation:pulseDot 1.6s infinite;}\\n  @keyframes pulseDot{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.4;transform:scale(1.35);}}\\n  .hero h1{font-size:clamp(30px,4.4vw,46px);margin-bottom:16px;}\\n  .hero h1 .hl{color:var(--primary);}\\n  .hero-sub{font-size:18px;color:var(--ink-soft);max-width:480px;margin-bottom:22px;}\\n  .color-swatches{display:flex;gap:10px;margin-bottom:24px;}\\n  .swatch{width:34px;height:34px;border-radius:50%;border:2.5px solid #fff;box-shadow:0 0 0 2px var(--line);cursor:pointer;transition:box-shadow .2s ease, transform .2s ease;}\\n  .swatch.active{box-shadow:0 0 0 2px var(--primary);transform:scale(1.08);}\\n  .size-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px;}\\n  .size-chip{width:44px;height:44px;border:1.5px solid var(--line);border-radius:12px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13.5px;color:var(--ink-soft);cursor:pointer;transition:all .2s ease;}\\n  .size-chip.active{border-color:var(--primary);background:var(--primary-tint);color:var(--primary-dark);}\\n  .size-chip:hover{border-color:var(--ink);}\\n  .size-label{font-size:13px;font-weight:600;color:var(--ink-soft);margin-bottom:10px;display:block;}\\n  .price-box{background:#fff;border:1.5px solid var(--line);border-radius:var(--radius);padding:24px;box-shadow:var(--shadow-md);max-width:460px;}\\n  .price-row{display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap;margin-bottom:6px;}\\n  .price-old{font-size:19px;color:#9A9A9F;text-decoration:line-through;font-weight:600;}\\n  .price-now{font-size:34px;font-weight:800;font-family:var(--font-display);color:var(--ink);}\\n  .price-badge{background:rgba(34,197,94,.12);color:#158B44;font-weight:700;font-size:13px;padding:5px 11px;border-radius:999px;}\\n  .price-note{font-size:13.5px;color:var(--ink-soft);margin-bottom:16px;}\\n  .pay-icons{display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap;}\\n  .pay-icons span{font-size:11.5px;font-weight:700;padding:5px 10px;border-radius:8px;border:1px solid var(--line);color:var(--ink-soft);background:var(--bg-alt);}\\n  .trust-row{display:flex;flex-wrap:wrap;gap:14px;margin-top:16px;font-size:12.5px;color:var(--ink-soft);font-weight:600;}\\n  .trust-row span{display:flex;align-items:center;gap:6px;}\\n  /* hero product visual */\\n  .hero-visual{position:relative;display:flex;justify-content:center;align-items:center;min-height:340px;}\\n  .shoe-stage{position:relative;width:100%;max-width:460px;aspect-ratio:5/4;border-radius:24px;background:radial-gradient(closest-side, rgba(255,107,0,.14), transparent 70%),linear-gradient(160deg,#FAF9F8,#F1EFEC);border:1px solid var(--line);box-shadow:var(--shadow-lg);display:flex;align-items:center;justify-content:center;overflow:hidden;}\\n  .shoe-emoji{font-size:120px;transform:rotate(-8deg);filter:drop-shadow(0 22px 26px rgba(17,17,17,.18));transition:transform .5s cubic-bezier(.16,1,.3,1);}\\n  .shoe-stage:hover .shoe-emoji{transform:rotate(-2deg) scale(1.05);}\\n  .stage-tag{position:absolute;top:18px;left:18px;background:#fff;font-size:12px;font-weight:700;padding:6px 12px;border-radius:999px;box-shadow:var(--shadow-sm);}\\n  .stage-tag.right{left:auto;right:18px;top:auto;bottom:18px;background:var(--ink);color:#fff;}\\n  /* PROOF */\\n  .proof{padding:36px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--bg-alt);}\\n  .proof-inner{display:flex;flex-wrap:wrap;gap:28px;align-items:center;justify-content:space-between;}\\n  .stars{color:var(--primary);font-size:18px;letter-spacing:2px;}\\n  .proof-stat{display:flex;flex-direction:column;}\\n  .proof-stat b{font-family:var(--font-display);font-size:22px;}\\n  .proof-stat span{font-size:13px;color:var(--ink-soft);}\\n  .badge-row{display:flex;gap:22px;flex-wrap:wrap;color:var(--ink-soft);font-size:13px;font-weight:600;}\\n  .badge-row span{display:flex;align-items:center;gap:6px;}\\n  .sec{padding:84px 0;}\\n  .sec-head{max-width:640px;margin:0 auto 44px;text-align:center;}\\n  .sec-head h2{font-size:clamp(25px,3.4vw,36px);margin-top:14px;}\\n  .sec-head p{color:var(--ink-soft);font-size:16.5px;margin-top:12px;}\\n  .sec-alt{background:var(--bg-alt);}\\n  .grid{display:grid;gap:22px;}\\n  .grid-2{grid-template-columns:1fr;}\\n  .grid-3{grid-template-columns:1fr;}\\n  .grid-4{grid-template-columns:1fr;}\\n  @media(min-width:640px){.grid-2{grid-template-columns:1fr 1fr;}.grid-4{grid-template-columns:1fr 1fr;}}\\n  @media(min-width:900px){.grid-3{grid-template-columns:repeat(3,1fr);}.grid-4{grid-template-columns:repeat(4,1fr);}}\\n  .card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:28px;transition:transform .3s ease, box-shadow .3s ease, border-color .3s ease;}\\n  .card:hover{transform:translateY(-5px);box-shadow:var(--shadow-md);border-color:transparent;}\\n  .card-ic{width:48px;height:48px;border-radius:13px;display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:16px;}\\n  .ic-pain{background:rgba(239,68,68,.09);}\\n  .ic-good{background:var(--primary-tint);}\\n  .card h3{font-size:17.5px;margin-bottom:8px;}\\n  .card p{color:var(--ink-soft);font-size:14.5px;}\\n  /* gallery */\\n  .gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;}\\n  @media(min-width:700px){.gallery{grid-template-columns:repeat(4,1fr);}}\\n  .gallery-tile{aspect-ratio:1/1;border-radius:16px;background:linear-gradient(150deg,#F4F2EF,#FFF1E6);border:1px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:44px;box-shadow:var(--shadow-sm);transition:transform .3s ease;}\\n  .gallery-tile:hover{transform:scale(1.03);}\\n  /* features two-col */\\n  .feat-wrap{display:grid;grid-template-columns:1fr;gap:40px;align-items:center;}\\n  @media(min-width:900px){.feat-wrap{grid-template-columns:1fr 1.1fr;}}\\n  .feat-art{aspect-ratio:1/1;border-radius:var(--radius);background:conic-gradient(from 200deg, var(--primary-tint), #fff 30%, rgba(37,99,235,.08) 70%, var(--primary-tint));border:1px solid var(--line);box-shadow:var(--shadow-md);display:flex;align-items:center;justify-content:center;font-size:64px;}\\n  .feat-list li{display:flex;gap:14px;padding:16px 0;border-bottom:1px solid var(--line);}\\n  .feat-list li:last-child{border-bottom:none;}\\n  .feat-list h4{font-size:15.5px;margin-bottom:4px;}\\n  .feat-list p{font-size:14px;color:var(--ink-soft);}\\n  .check-ic{width:20px;height:20px;border-radius:50%;flex:none;background:rgba(34,197,94,.12);color:var(--success);display:flex;align-items:center;justify-content:center;font-size:12px;}\\n  /* comparison */\\n  .compare-table{width:100%;border-collapse:separate;border-spacing:0;background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm);border:1px solid var(--line);}\\n  .compare-table th,.compare-table td{padding:16px 18px;text-align:left;font-size:14.5px;border-bottom:1px solid var(--line);}\\n  .compare-table th{font-family:var(--font-display);font-size:14.5px;background:var(--bg-alt);}\\n  .compare-table th.win{background:var(--primary);color:#fff;}\\n  .compare-table tr:last-child td{border-bottom:none;}\\n  .yes{color:var(--success);font-weight:800;}\\n  .no{color:var(--danger);font-weight:800;}\\n  .compare-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;}\\n  /* testimonials */\\n  .test-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:26px;}\\n  .test-stars{color:var(--primary);font-size:14px;margin-bottom:12px;}\\n  .test-quote{font-size:15.5px;color:var(--ink);margin-bottom:18px;}\\n  .test-who{display:flex;align-items:center;gap:12px;}\\n  .test-av{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#6C9BFF);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;}\\n  .test-who b{font-size:13.5px;display:block;}\\n  .test-who span{font-size:12px;color:var(--ink-soft);}\\n  .video-badge{display:inline-flex;align-items:center;gap:6px;background:var(--ink);color:#fff;font-size:11.5px;font-weight:700;padding:4px 10px;border-radius:8px;margin-bottom:12px;}\\n  /* how it works */\\n  .timeline{display:grid;grid-template-columns:1fr;gap:28px;position:relative;}\\n  @media(min-width:800px){.timeline{grid-template-columns:repeat(3,1fr);}\\n    .timeline::before{content:\\\"\\\";position:absolute;top:26px;left:12%;right:12%;height:2px;background:repeating-linear-gradient(90deg,var(--line) 0 8px,transparent 8px 16px);}}\\n  .tl-step{position:relative;text-align:center;}\\n  .tl-num{width:52px;height:52px;border-radius:50%;background:var(--ink);color:#fff;display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:800;margin:0 auto 16px;position:relative;z-index:2;font-size:18px;}\\n  .tl-step:nth-child(2) .tl-num{background:var(--primary);}\\n  .tl-step h3{font-size:16.5px;margin-bottom:6px;}\\n  .tl-step p{font-size:14px;color:var(--ink-soft);max-width:230px;margin:0 auto;}\\n  /* FAQ */\\n  .faq-item{border-bottom:1px solid var(--line);}\\n  .faq-q{width:100%;display:flex;justify-content:space-between;align-items:center;gap:16px;padding:20px 4px;text-align:right;flex-direction:row-reverse;font-weight:600;font-size:15.5px;}\\n  .faq-q .plus{flex:none;width:26px;height:26px;border-radius:50%;background:var(--bg-alt);display:flex;align-items:center;justify-content:center;transition:transform .3s ease, background .3s ease;font-size:16px;color:var(--ink);}\\n  .faq-item.open .faq-q .plus{transform:rotate(45deg);background:var(--primary);color:#fff;}\\n  .faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease;}\\n  .faq-a-inner{padding:0 4px 20px;color:var(--ink-soft);font-size:14.5px;max-width:640px;text-align:right;margin-left:auto;}\\n  /* guarantee */\\n  .guarantee{background:linear-gradient(160deg,#11131A,#22252E);border-radius:var(--radius);padding:56px 24px;text-align:center;color:#fff;box-shadow:var(--shadow-lg);}\\n  .guarantee-badge{width:96px;height:96px;border-radius:50%;background:rgba(255,107,0,.15);border:2px solid var(--primary);display:flex;align-items:center;justify-content:center;font-size:40px;margin:0 auto 22px;}\\n  .guarantee h2{color:#fff;font-size:26px;margin-bottom:12px;}\\n  .guarantee p{color:#B9B9C2;max-width:480px;margin:0 auto 22px;font-size:15.5px;}\\n  /* final CTA */\\n  .final-cta{background:linear-gradient(155deg,var(--primary),#FF8A3D);border-radius:var(--radius);padding:56px 28px;text-align:center;color:#fff;position:relative;overflow:hidden;}\\n  .final-cta::after{content:\\\"\\\";position:absolute;inset:0;background:radial-gradient(400px 200px at 85% 0%, rgba(255,255,255,.22), transparent 70%);}\\n  .final-cta h2{color:#fff;font-size:clamp(23px,3.4vw,32px);margin-bottom:12px;}\\n  .final-cta p{color:rgba(255,255,255,.9);margin-bottom:26px;position:relative;}\\n  .stock-bar{max-width:420px;margin:0 auto 26px;position:relative;}\\n  .stock-track{height:9px;background:rgba(255,255,255,.28);border-radius:999px;overflow:hidden;}\\n  .stock-fill{height:100%;width:76%;background:#fff;border-radius:999px;}\\n  .stock-label{font-size:12.5px;margin-top:8px;color:rgba(255,255,255,.9);font-weight:600;}\\n  .final-cta .btn-primary{background:#111;box-shadow:0 14px 30px rgba(0,0,0,.28);}\\n  /* floating elements */\\n  .fab-stack{position:fixed;right:20px;bottom:96px;display:flex;flex-direction:column;gap:12px;z-index:70;}\\n  @media(min-width:860px){.fab-stack{bottom:28px;}}\\n  .fab{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:22px;color:#fff;box-shadow:var(--shadow-md);transition:transform .25s ease, opacity .25s ease;opacity:0;transform:translateY(14px) scale(.8);pointer-events:none;}\\n  .fab.show{opacity:1;transform:translateY(0) scale(1);pointer-events:auto;}\\n  .fab:hover{transform:translateY(-3px) scale(1.05);}\\n  .fab-wa{background:#25D366;}\\n  .fab-msg{background:linear-gradient(135deg,#0084FF,#00C6FF);}\\n  .fab-top{background:var(--ink);font-size:17px;}\\n  .sticky-cta{position:fixed;left:0;right:0;bottom:0;z-index:65;background:#fff;border-top:1px solid var(--line);box-shadow:0 -8px 24px rgba(17,17,17,.08);padding:12px 16px;display:flex;align-items:center;gap:14px;transform:translateY(110%);transition:transform .3s ease;}\\n  .sticky-cta.show{transform:translateY(0);}\\n  .sticky-cta .sc-price{flex:none;}\\n  .sticky-cta .sc-price b{display:block;font-family:var(--font-display);font-size:18px;}\\n  .sticky-cta .sc-price s{font-size:12px;color:#9A9A9F;}\\n  .sticky-cta .btn{flex:1;padding:14px 18px;font-size:15.5px;}\\n  @media(min-width:860px){.sticky-cta{display:none;}}\\n  .desktop-sticky-bar{position:fixed;top:0;left:0;right:0;z-index:59;background:#fff;border-bottom:1px solid var(--line);box-shadow:var(--shadow-sm);transform:translateY(-110%);transition:transform .3s ease;}\\n  .desktop-sticky-bar.show{transform:translateY(0);}\\n  .dsb-inner{display:flex;align-items:center;justify-content:space-between;height:70px;}\\n  .dsb-left{display:flex;align-items:center;gap:14px;}\\n  .dsb-left b{font-family:var(--font-display);font-size:15.5px;}\\n  .dsb-left span{font-size:13px;color:var(--ink-soft);}\\n  @media(max-width:859px){.desktop-sticky-bar{display:none;}}\\n  .mt-32{margin-top:32px;}\\n  a:focus-visible,button:focus-visible{outline:2.5px solid var(--accent);outline-offset:3px;border-radius:8px;}\\n</style>\\n</head>\\n<body>\\n      AS\\n      <b>AeroStep</b>প্রিমিয়াম কমফোর্ট স্নিকার্স\\n    <a href=\\\"#buy\\\">অর্ডার করুন — ৳২,২৯০</a>\\n<nav>\\n    ASAeroStep\\n      <s style=\\\"color:#9A9A9F;font-weight:500;\\\">৳৩,৯৯০</s>&nbsp; ৳২,২৯০\\n      <a href=\\\"#buy\\\">অর্ডার করুন</a>\\n</nav>\\n<!-- HERO -->\\n<header>\\n       &#x1f525; লঞ্চ অফার — ৪২% ছাড়\\n      <h1>সারাদিন হাঁটুন, একদম আরাম নিয়ে</h1>\\n      <p>AeroStep স্নিকার্স — হালকা কুশন সোল, শ্বাস-প্রশ্বাসযোগ্য মেশ আপার আর টেকসই গ্রিপ। অফিস থেকে আড্ডা, সবখানে মানিয়ে যায়।</p>\\n      কালার বেছে নিন\\n      সাইজ বেছে নিন (EU)\\n        ৩৯\\n        ৪০\\n        ৪১\\n        ৪২\\n        ৪৩\\n        ৪৪\\n          ৳৩,৯৯০\\n          ৳২,২৯০\\n          ৪২% সাশ্রয়\\n        <p>সারাদেশে ডেলিভারি। ক্যাশ অন ডেলিভারি সুবিধা আছে।</p>\\n          bKashNagadRocketCardCOD\\n        <a href=\\\"#buy-final\\\">অর্ডার করুন</a>\\n          &#x1f512; সিকিউর পেমেন্ট\\n          &#x1f69a; ২৪–৭২ ঘণ্টায় ডেলিভারি\\n          &#x21a9;&#xfe0f; ৭ দিনে এক্সচেঞ্জ\\n        &#x1f45f; নতুন কালেকশন\\n        &#x1f45f;\\n        ৪.৮ ★ ২,৪০০+ রিভিউ\\n</header>\\n<!-- PROOF -->\\n<section>\\n    ★★★★★\\n    <b>৪.৮/৫</b>গড় রেটিং\\n    <b>৫,০০০+</b>জোড়া বিক্রি\\n      &#x1f69a; ফ্রি ডেলিভারি (২০০০+)\\n      &#x21a9;&#xfe0f; ৭ দিনে এক্সচেঞ্জ\\n      &#x1f6e1;&#xfe0f; অথেন্টিক প্রোডাক্ট\\n</section>\\n<!-- PROBLEM -->\\n<section>\\n      সমস্যা\\n      <h2>প্রতিদিনের জুতার এই সমস্যাগুলো চেনা লাগছে?</h2>\\n      <p>বেশিরভাগ জুতা দেখতে ভালো লাগলেও সারাদিন পরার মতো আরামদায়ক হয় না।</p>\\n      &#x1f9b6;<h3>পায়ে ব্যথা</h3><p>কয়েক ঘণ্টা হাঁটলেই পায়ের পাতা আর গোড়ালিতে ব্যথা শুরু হয়ে যায়।</p>\\n      &#x1f4a7;<h3>ঘাম আর গন্ধ</h3><p>মেশ ঠিকমতো শ্বাস না নিলে সারাদিন পা ঘেমে থাকে।</p>\\n      &#x1f9f5;<h3>তাড়াতাড়ি নষ্ট হওয়া</h3><p>কয়েক মাসেই সোল ক্ষয়ে যায়, সেলাই খুলে যায়।</p>\\n      &#x1f45e;<h3>সব পোশাকে মানায় না</h3><p>একটা জুতা অফিস, ঘোরাঘুরি সব জায়গায় ফিট বসে না।</p>\\n</section>\\n<!-- WHAT'S INCLUDED / FEATURES GRID -->\\n<section>\\n      AeroStep কেন আলাদা\\n      <h2>প্রতিটা ডিটেইল আরামের জন্য ডিজাইন করা</h2>\\n      <p>বক্স খোলার প্রথম মুহূর্ত থেকেই পার্থক্যটা টের পাবেন।</p>\\n      &#x2601;&#xfe0f;<h3>ক্লাউড কুশন সোল</h3><p>প্রতিটা পদক্ষেপে সফট