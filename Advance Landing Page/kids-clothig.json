"[{\"title\":\"kids clothig\",\"flow_type\":\"flows\",\"flow_meta\":{\"wcf-flow-indexing\":\"\",\"wcf-testing\":\"no\",\"wcf-enable-analytics\":\"yes\",\"wcf-flow-custom-script\":\"\",\"wcf-flow-custom-js\":\"\",\"wcf-flow-custom-css\":\"\",\"wcf-enable-gcp-styling\":\"no\",\"wcf-gcp-primary-color\":\"#f16334\",\"wcf-gcp-secondary-color\":\"#000000\",\"wcf-gcp-text-color\":\"#4B5563\",\"wcf-gcp-accent-color\":\"#1F2937\",\"wcf-gcp-primary-base-font-family\":\"\",\"instant-layout-style\":\"no\",\"wcf-instant-checkout-header-logo-width\":\"\",\"wcf-instant-checkout-header-logo\":\"\",\"wcf-instant-checkout-header-logo-height\":\"\",\"wcf-instant-checkout-header-color\":\"\"},\"steps\":[{\"title\":\"Sales Landing\",\"type\":\"landing\",\"meta\":{\"wcf-flow-id\":[\"3327\"],\"wcf-step-type\":[\"landing\"],\"_wp_page_template\":[\"cartflows-default\"]},\"post_content\":\"\\\"\\\"\\\"\\\"\\\"\\\"\"},{\"title\":\"chakout\",\"type\":\"checkout\",\"meta\":{\"wcf-flow-id\":[\"3327\"],\"wcf-step-type\":[\"checkout\"],\"_wp_page_template\":[\"cartflows-canvas\"],\"_elementor_edit_mode\":[\"builder\"],\"_elementor_template_type\":[\"wp-post\"],\"_elementor_version\":[\"4.1.5\"],\"_elementor_pro_version\":[\"3.27.5\"],\"wcf-pro-dynamic-css-version\":[\"1783899472\"],\"wcf-dynamic-css-version\":[\"1783899472\"],\"_elementor_data\":[\"[{\\\"id\\\":\\\"7e38733\\\",\\\"elType\\\":\\\"section\\\",\\\"settings\\\":[],\\\"elements\\\":[{\\\"id\\\":\\\"a1f6bb4\\\",\\\"elType\\\":\\\"column\\\",\\\"settings\\\":{\\\"_column_size\\\":100,\\\"_inline_size\\\":100,\\\"space_between_widgets\\\":0,\\\"space_between_widgets_mobile\\\":0},\\\"elements\\\":[{\\\"id\\\":\\\"4259dac\\\",\\\"elType\\\":\\\"widget\\\",\\\"settings\\\":{\\\"html\\\":\\\"<!DOCTYPE html>\\\\n<html lang=\\\\\\\"bn\\\\\\\">\\\\n<head>\\\\n<meta charset=\\\\\\\"UTF-8\\\\\\\">\\\\n<meta name=\\\\\\\"viewport\\\\\\\" content=\\\\\\\"width=device-width, initial-scale=1.0, viewport-fit=cover\\\\\\\">\\\\n<title>TinyTrendy — বাচ্চাদের প্রিমিয়াম কটন টি-শার্ট কালেকশন</title>\\\\n<meta name=\\\\\\\"description\\\\\\\" content=\\\\\\\"১০০% পিওর কটন কমফোর্ট টি-শার্ট। বাচ্চার ত্বকে কোমল, দীর্ঘস্থায়ী রং এবং আরামদায়ক ফিটিং। ক্যাশ অন ডেলিভারি সারাদেশে।\\\\\\\">\\\\n<link rel=\\\\\\\"preconnect\\\\\\\" href=\\\\\\\"https://fonts.googleapis.com\\\\\\\">\\\\n<link rel=\\\\\\\"preconnect\\\\\\\" href=\\\\\\\"https://fonts.gstatic.com\\\\\\\" crossorigin>\\\\n<link href=\\\\\\\"https://fonts.googleapis.com/css2?family=Baloo+Da+2:wght@500;600;700;800&family=Hind+Siliguri:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap\\\\\\\" rel=\\\\\\\"stylesheet\\\\\\\">\\\\n<style>\\\\n  :root{\\\\n    --primary:#FF5E36;--primary-dark:#D94118;--primary-tint:#FFF1ED;\\\\n    --secondary:#0EA5E9;--accent:#F59E0B;\\\\n    --ink:#1E293B;--ink-soft:#64748B;--bg:#FAFCFF;--bg-alt:#F1F5F9;\\\\n    --success:#10B981;--danger:#EF4444;--line:#E2E8F0;\\\\n    --container:1200px;--radius:20px;--radius-btn:14px;\\\\n    --shadow-sm:0 2px 10px rgba(15,23,42,.05);--shadow-md:0 12px 30px rgba(15,23,42,.08);\\\\n    --shadow-lg:0 20px 50px rgba(255,94,54,.16);--shadow-primary:0 14px 28px rgba(255,94,54,.28);\\\\n    --font-display:'Baloo Da 2','Hind Siliguri', sans-serif;--font-body:'Hind Siliguri', sans-serif;\\\\n  }\\\\n  *{box-sizing:border-box;margin:0;padding:0;}\\\\n  html{scroll-behavior:smooth;}\\\\n  body{font-family:var(--font-body);color:var(--ink);background:var(--bg);-webkit-font-smoothing:antialiased;line-height:1.65;overflow-x:hidden;}\\\\n  img{max-width:100%;display:block;}\\\\n  a{color:inherit;text-decoration:none;}\\\\n  ul{list-style:none;}\\\\n  button{font-family:inherit;cursor:pointer;border:none;background:none;}\\\\n  .container{width:100%;max-width:var(--container);margin:0 auto;padding:0 24px;}\\\\n  section{position:relative;}\\\\n  h1,h2,h3{font-family:var(--font-display);font-weight:700;line-height:1.25;color:var(--ink);}\\\\n  .eng{font-family:'Poppins', sans-serif;}\\\\n  .eyebrow{display:inline-flex;align-items:center;gap:8px;font-size:13.5px;font-weight:700;color:var(--primary-dark);background:var(--primary-tint);padding:7px 16px;border-radius:999px;}\\\\n\\\\n  .btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;font-weight:700;font-size:16.5px;padding:16px 30px;border-radius:var(--radius-btn);transition:transform .22s ease, box-shadow .22s ease;white-space:nowrap;}\\\\n  .btn-primary{background:linear-gradient(180deg,#FF734E,var(--primary));color:#fff;box-shadow:var(--shadow-primary);}\\\\n  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 18px 36px rgba(255,94,54,.36);}\\\\n  .btn-block{width:100%;}\\\\n  .btn-lg{padding:18px 36px;font-size:19px;}\\\\n\\\\n  .reveal{opacity:0;transform:translateY(24px);transition:opacity .6s cubic-bezier(.16,1,.3,1), transform .6s cubic-bezier(.16,1,.3,1);}\\\\n  .reveal.in-view{opacity:1;transform:translateY(0);}\\\\n  .reveal-delay-1{transition-delay:.08s;}\\\\n  .reveal-delay-2{transition-delay:.16s;}\\\\n  .reveal-delay-3{transition-delay:.24s;}\\\\n  @media (prefers-reduced-motion: reduce){.reveal{opacity:1;transform:none;transition:none;}html{scroll-behavior:auto;}}\\\\n\\\\n  .desktop-sticky-bar{position:fixed;top:0;left:0;right:0;z-index:59;background:#fff;border-bottom:1px solid var(--line);box-shadow:var(--shadow-sm);transform:translateY(-110%);transition:transform .3s ease;}\\\\n  .desktop-sticky-bar.show{transform:translateY(0);}\\\\n  .dsb-inner{display:flex;align-items:center;justify-content:space-between;height:68px;}\\\\n  .dsb-left{display:flex;align-items:center;gap:14px;}\\\\n  .dsb-left b{font-family:var(--font-display);font-size:16px;}\\\\n  .dsb-left span{font-size:12.5px;color:var(--ink-soft);}\\\\n  @media(max-width:859px){.desktop-sticky-bar{display:none;}}\\\\n\\\\n  .nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.9);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-bottom:1px solid var(--line);}\\\\n  .nav-inner{display:flex;align-items:center;justify-content:space-between;height:74px;}\\\\n  .brand{display:flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:800;font-size:21px;}\\\\n  .brand-mark{width:36px;height:36px;border-radius:10px;background:linear-gradient(135deg,var(--primary),#FFA07A);display:flex;align-items:center;justify-content:center;color:#fff;font-size:16px;font-weight:800;}\\\\n  .nav-cta{display:flex;align-items:center;gap:14px;}\\\\n  .nav-price{display:none;}\\\\n  @media(min-width:860px){.nav-price{display:inline-block;font-weight:700;color:var(--ink-soft);font-size:14px;}}\\\\n\\\\n  .hero{padding:50px 0 60px;background:radial-gradient(650px 420px at 85% -5%, rgba(255,94,54,.10), transparent 65%),radial-gradient(550px 380px at -5% 35%, rgba(14,165,233,.08), transparent 60%),var(--bg);overflow:hidden;}\\\\n  .hero-grid{display:grid;grid-template-columns:1fr;gap:40px;align-items:center;}\\\\n  @media(min-width:960px){.hero-grid{grid-template-columns:.95fr 1.05fr;gap:56px;}}\\\\n  .badge-pulse{display:inline-flex;align-items:center;gap:8px;background:var(--ink);color:#fff;font-weight:600;font-size:13.5px;padding:8px 16px;border-radius:999px;margin-bottom:20px;}\\\\n  .badge-dot{width:7px;height:7px;border-radius:50%;background:var(--primary);animation:pulseDot 1.6s infinite;}\\\\n  @keyframes pulseDot{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.4;transform:scale(1.35);}}\\\\n  .hero h1{font-size:clamp(30px,4.5vw,46px);margin-bottom:14px;color:var(--ink);}\\\\n  .hero h1 .hl{color:var(--primary);}\\\\n  .hero-sub{font-size:17.5px;color:var(--ink-soft);max-width:480px;margin-bottom:24px;}\\\\n\\\\n  .hero-points{display:grid;grid-template-columns:1fr 1fr;gap:10px 18px;margin-bottom:24px;max-width:450px;}\\\\n  .hero-point{display:flex;align-items:center;gap:10px;font-weight:600;font-size:14.5px;}\\\\n  .check-ic{width:20px;height:20px;border-radius:50%;flex:none;background:rgba(16,185,129,.12);color:var(--success);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:800;}\\\\n\\\\n  .price-box{background:#fff;border:1.5px solid var(--line);border-radius:var(--radius);padding:24px;box-shadow:var(--shadow-md);max-width:440px;}\\\\n  .price-row{display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap;margin-bottom:6px;}\\\\n  .price-old{font-size:18px;color:#94A3B8;text-decoration:line-through;font-weight:600;}\\\\n  .price-now{font-size:34px;font-weight:800;font-family:var(--font-display);color:var(--primary);}\\\\n  .price-badge{background:rgba(16,185,129,.12);color:#059669;font-weight:700;font-size:13px;padding:5px 12px;border-radius:999px;}\\\\n  .price-note{font-size:13.5px;color:var(--ink-soft);margin-bottom:16px;}\\\\n  .pay-icons{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;}\\\\n  .pay-icons span{font-size:11.5px;font-weight:700;padding:5px 10px;border-radius:8px;border:1px solid var(--line);color:var(--ink-soft);background:var(--bg-alt);}\\\\n  .trust-row{display:flex;flex-wrap:wrap;gap:14px;margin-top:14px;font-size:12.5px;color:var(--ink-soft);font-weight:600;}\\\\n  .trust-row span{display:flex;align-items:center;gap:6px;}\\\\n\\\\n  .hero-visual{position:relative;display:flex;justify-content:center;align-items:center;min-height:320px;}\\\\n  .kids-stage{position:relative;width:100%;max-width:450px;aspect-ratio:5/4;border-radius:24px;background:radial-gradient(closest-side, rgba(255,94,54,.15), transparent 75%),linear-gradient(160deg,#FFF8F5,#F1F5F9);border:1px solid var(--line);box-shadow:var(--shadow-lg);display:flex;align-items:center;justify-content:center;overflow:hidden;}\\\\n  .kids-emoji{font-size:115px;transform:rotate(-4deg);filter:drop-shadow(0 20px 24px rgba(15,23,42,.15));transition:transform .5s cubic-bezier(.16,1,.3,1);}\\\\n  .kids-stage:hover .kids-emoji{transform:rotate(0deg) scale(1.06);}\\\\n  .stage-tag{position:absolute;top:16px;left:16px;background:#fff;font-size:12.5px;font-weight:700;padding:7px 14px;border-radius:999px;box-shadow:var(--shadow-sm);}\\\\n  .stage-tag.right{left:auto;right:16px;top:auto;bottom:16px;background:var(--ink);color:#fff;}\\\\n\\\\n  .proof{padding:32px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--bg-alt);}\\\\n  .proof-inner{display:flex;flex-wrap:wrap;gap:24px;align-items:center;justify-content:space-between;}\\\\n  .stars{color:var(--accent);font-size:17px;letter-spacing:2px;}\\\\n  .proof-stat{display:flex;flex-direction:column;}\\\\n  .proof-stat b{font-family:var(--font-display);font-size:22px;color:var(--ink);}\\\\n  .proof-stat span{font-size:12.5px;color:var(--ink-soft);}\\\\n  .badge-row{display:flex;gap:20px;flex-wrap:wrap;color:var(--ink-soft);font-size:13px;font-weight:600;}\\\\n  .badge-row span{display:flex;align-items:center;gap:6px;}\\\\n\\\\n  .sec{padding:64px 0;}\\\\n  .sec-head{max-width:620px;margin:0 auto 36px;text-align:center;}\\\\n  .sec-head h2{font-size:clamp(24px,3.2vw,34px);margin-top:12px;}\\\\n  .sec-head p{color:var(--ink-soft);font-size:16px;margin-top:10px;}\\\\n  .sec-alt{background:var(--bg-alt);}\\\\n\\\\n  .grid{display:grid;gap:20px;}\\\\n  .grid-3{grid-template-columns:1fr;}\\\\n  .grid-4{grid-template-columns:1fr 1fr;}\\\\n  @media(min-width:900px){.grid-3{grid-template-columns:repeat(3,1fr);}.grid-4{grid-template-columns:repeat(4,1fr);}}\\\\n\\\\n  .card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:24px;transition:transform .3s ease, box-shadow .3s ease, border-color .3s ease;}\\\\n  .card:hover{transform:translateY(-4px);box-shadow:var(--shadow-md);border-color:transparent;}\\\\n  .card-ic{width:48px;height:48px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:22px;margin-bottom:14px;background:var(--primary-tint);}\\\\n  .card h3{font-size:17px;margin-bottom:8px;}\\\\n  .card p{color:var(--ink-soft);font-size:14px;}\\\\n\\\\n  .swatches-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;}\\\\n  @media(min-width:768px){.swatches-grid{grid-template-columns:repeat(4,1fr);}}\\\\n  .swatch-box{background:#fff;border:1.5px solid var(--line);border-radius:var(--radius);padding:16px;text-align:center;box-shadow:var(--shadow-sm);transition:all .3s ease;}\\\\n  .swatch-box:hover{transform:translateY(-4px);box-shadow:var(--shadow-md);border-color:var(--primary);}\\\\n  .swatch-visual{height:120px;border-radius:14px;display:flex;align-items:center;justify-content:center;font-size:48px;margin-bottom:12px;}\\\\n  .swatch-box h4{font-size:15.5px;margin-bottom:4px;}\\\\n  .swatch-box .p{font-family:var(--font-display);font-size:17px;font-weight:700;color:var(--primary);}\\\\n\\\\n  .test-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:24px;}\\\\n  .test-stars{color:var(--accent);font-size:14px;margin-bottom:10px;}\\\\n  .test-quote{font-size:15px;color:var(--ink);margin-bottom:14px;line-height:1.6;}\\\\n  .test-who{display:flex;align-items:center;gap:12px;}\\\\n  .test-av{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--primary),#FFA07A);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;}\\\\n  .test-who b{font-size:14px;display:block;}\\\\n  .test-who span{font-size:12px;color:var(--ink-soft);}\\\\n\\\\n  .faq-item{border-bottom:1px solid var(--line);}\\\\n  .faq-q{width:100%;display:flex;justify-content:space-between;align-items:center;gap:14px;padding:18px 4px;font-weight:600;font-size:16px;color:var(--ink);}\\\\n  .faq-q .plus{flex:none;width:26px;height:26px;border-radius:50%;background:var(--bg-alt);display:flex;align-items:center;justify-content:center;transition:transform .3s ease, background .3s ease;font-size:16px;color:var(--ink);}\\\\n  .faq-item.open .faq-q .plus{transform:rotate(45deg);background:var(--primary);color:#fff;}\\\\n  .faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease;}\\\\n  .faq-a-inner{padding:0 4px 18px;color:var(--ink-soft);font-size:14.5px;max-width:680px;}\\\\n\\\\n  .final-cta{background:linear-gradient(155deg,var(--primary),#FF8A3D);border-radius:var(--radius);padding:50px 28px;text-align:center;color:#fff;position:relative;overflow:hidden;}\\\\n  .final-cta::after{content:\\\\\\\"\\\\\\\";position:absolute;inset:0;background:radial-gradient(420px 220px at 85% 0%, rgba(255,255,255,.24), transparent 70%);}\\\\n  .final-cta h2{color:#fff;font-size:clamp(22px,3.2vw,32px);margin-bottom:12px;}\\\\n  .final-cta p{color:rgba(255,255,255,.92);margin-bottom:22px;position:relative;font-size:15px;}\\\\n  .stock-bar{max-width:420px;margin:0 auto 24px;position:relative;}\\\\n  .stock-track{height:9px;background:rgba(255,255,255,.3);border-radius:999px;overflow:hidden;}\\\\n  .stock-fill{height:100%;width:82%;background:#fff;border-radius:999px;}\\\\n  .stock-label{font-size:12.5px;margin-top:8px;color:rgba(255,255,255,.92);font-weight:600;}\\\\n  .final-cta .btn-primary{background:#1E293B;color:#fff;box-shadow:0 14px 30px rgba(0,0,0,.25);}\\\\n\\\\n  .fab-stack{position:fixed;right:20px;bottom:96px;display:flex;flex-direction:column;gap:12px;z-index:70;}\\\\n  @media(min-width:860px){.fab-stack{bottom:28px;}}\\\\n  .fab{width:50px;height:50px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:21px;color:#fff;box-shadow:var(--shadow-md);transition:transform .25s ease, opacity .25s ease;opacity:0;transform:translateY(14px) scale(.8);pointer-events:none;}\\\\n  .fab.show{opacity:1;transform:translateY(0) scale(1);pointer-events:auto;}\\\\n  .fab:hover{transform:translateY(-3px) scale(1.05);}\\\\n  .fab-wa{background:#25D366;}\\\\n  .fab-msg{background:linear-gradient(135deg,#0084FF,#00C6FF);}\\\\n  .fab-top{background:var(--ink);font-size:16px;}\\\\n\\\\n  .sticky-cta{position:fixed;left:0;right:0;bottom:0;z-index:65;background:#fff;border-top:1px solid var(--line);box-shadow:0 -8px 24px rgba(15,23,42,.08);padding:12px 16px;display:flex;align-items:center;gap:14px;transform:translateY(110%);transition:transform .3s ease;}\\\\n  .sticky-cta.show{transform:translateY(0);}\\\\n  .sticky-cta .sc-price b{display:block;font-family:var(--font-display);font-size:18px;color:var(--primary);}\\\\n  .sticky-cta .sc-price s{font-size:12px;color:#94A3B8;}\\\\n  .sticky-cta .btn{flex:1;padding:13px 16px;font-size:15.5px;}\\\\n  @media(min-width:860px){.sticky-cta{display:none;}}\\\\n\\\\n  .mt-24{margin-top:24px;}\\\\n  a:focus-visible,button:focus-visible{outline:2.5px solid var(--accent);outline-offset:3px;border-radius:8px;}\\\\n</style>\\\\n</head>\\\\n<body>\\\\n\\\\n<div class=\\\\\\\"desktop-sticky-bar\\\\\\\" id=\\\\\\\"desktopBar\\\\\\\">\\\\n  <div class=\\\\\\\"container dsb-inner\\\\\\\">\\\\n    <div class=\\\\\\\"dsb-left\\\\\\\">\\\\n      <span class=\\\\\\\"brand-mark eng\\\\\\\" style=\\\\\\\"width:28px;height:28px;font-size:12px;\\\\\\\">TT</span>\\\\n      <div><b>TinyTrendy</b><span>বাচ্চাদের প্রিমিয়াম টি-শার্ট</span></div>\\\\n    </div>\\\\n    <a href=\\\\\\\"#buy\\\\\\\" class=\\\\\\\"btn btn-primary\\\\\\\">অর্ডার করুন — ৳৩৯০</a>\\\\n  </div>\\\\n</div>\\\\n\\\\n<nav class=\\\\\\\"nav\\\\\\\">\\\\n  <div class=\\\\\\\"container nav-inner\\\\\\\">\\\\n    <div class=\\\\\\\"brand\\\\\\\"><span class=\\\\\\\"brand-mark eng\\\\\\\">TT</span><span>TinyTrendy</span></div>\\\\n    <div class=\\\\\\\"nav-cta\\\\\\\">\\\\n      <span class=\\\\\\\"nav-price\\\\\\\"><s style=\\\\\\\"color:#94A3B8;font-weight:500;\\\\\\\">৳৫৫০</s>&nbsp; ৳৩৯০</span>\\\\n      <a href=\\\\\\\"#buy\\\\\\\" class=\\\\\\\"btn btn-primary\\\\\\\">অর্ডার করুন</a>\\\\n    </div>\\\\n  </div>\\\\n</nav>\\\\n\\\\n<!-- HERO -->\\\\n<header class=\\\\\\\"hero\\\\\\\">\\\\n  <div class=\\\\\\\"container hero-grid\\\\\\\">\\\\n    <div>\\\\n      <span class=\\\\\\\"badge-pulse\\\\\\\"><span class=\\\\\\\"badge-dot\\\\\\\"></span> 👶 ১-১২ বছর বয়সীদের জন্য স্পেশাল অফার</span>\\\\n      <h1>বাচ্চার গায়ে <span class=\\\\\\\"hl\\\\\\\">আরাম</span>, মায়ের মনে <span class=\\\\\\\"hl\\\\\\\">শান্তি</span></h1>\\\\n      <p class=\\\\\\\"hero-sub\\\\\\\">১০০% পিওর কটন কম্বড ফেব্রিক — ঘাম শুষে নেয়, ত্বকে র‍্যাশ ফেলে না, বারবার ধুলেও রং নষ্ট হয় না। আপনার সোনামণির সেরা সঙ্গ।</p>\\\\n\\\\n      <div class=\\\\\\\"hero-points\\\\\\\">\\\\n        <div class=\\\\\\\"hero-point\\\\\\\"><span class=\\\\\\\"check-ic\\\\\\\">✓</span> ১০০% প্রিমিয়াম কটন</div>\\\\n        <div class=\\\\\\\"hero-point\\\\\\\"><span class=\\\\\\\"check-ic\\\\\\\">✓</span> স্কিন-ফ্রেন্ডলি সফট ফেব্রিক</div>\\\\n        <div class=\\\\\\\"hero-point\\\\\\\"><span class=\\\\\\\"check-ic\\\\\\\">✓</span> ডাবল-স্টিচ মজবুত সেলাই</div>\\\\n        <div class=\\\\\\\"hero-point\\\\\\\"><span class=\\\\\\\"check-ic\\\\\\\">✓</span> ৭ দিনে সহজ এক্সচেঞ্জ</div>\\\\n      </div>\\\\n\\\\n      <div class=\\\\\\\"price-box\\\\\\\" id=\\\\\\\"buy\\\\\\\">\\\\n        <div class=\\\\\\\"price-row\\\\\\\">\\\\n          <span class=\\\\\\\"price-old\\\\\\\">৳৫৫০</span>\\\\n          <span class=\\\\\\\"price-now\\\\\\\">৳৩৯০</span>\\\\n          <span class=\\\\\\\"price-badge\\\\\\\">২৯% ছাড়</span>\\\\n        </div>\\\\n        <p class=\\\\\\\"price-note\\\\\\\">সারাদেশে হোম ডেলিভারি। পণ্য হাতে পেয়ে চেক করে পেমেন্ট করার সুবিধা রয়েছে।</p>\\\\n        <div class=\\\\\\\"pay-icons\\\\\\\">\\\\n          <span>bKash</span><span>Nagad</span><span>Rocket</span><span>Card</span><span>Cash on Delivery</span>\\\\n        </div>\\\\n        <a href=\\\\\\\"#buy-final\\\\\\\" class=\\\\\\\"btn btn-primary btn-block btn-lg\\\\\\\">অর্ডার করতে ক্লিক করুন</a>\\\\n        <div class=\\\\\\\"trust-row\\\\\\\">\\\\n          <span>🔒 ১০০% নিরাপদ পেমেন্ট</span>\\\\n          <span>🚚 ২৪–৭২ ঘণ্টায় দ্রুত ডেলিভারি</span>\\\\n        </div>\\\\n      </div>\\\\n    </div>\\\\n\\\\n    <div class=\\\\\\\"hero-visual\\\\\\\">\\\\n      <div class=\\\\\\\"kids-stage\\\\\\\">\\\\n        <span class=\\\\\\\"stage-tag\\\\\\\">🌟 নতুন কিডস কালেকশন</span>\\\\n        <span class=\\\\\\\"kids-emoji\\\\\\\">👕</span>\\\\n        <span class=\\\\\\\"stage-tag right\\\\\\\">৪.৯ ★ ২,৮৫০+ রিভিউ</span>\\\\n      </div>\\\\n    </div>\\\\n  </div>\\\\n</header>\\\\n\\\\n<!-- PROOF -->\\\\n<section class=\\\\\\\"proof\\\\\\\">\\\\n  <div class=\\\\\\\"container proof-inner\\\\\\\">\\\\n    <div class=\\\\\\\"proof-stat\\\\\\\"><span class=\\\\\\\"stars\\\\\\\">★★★★★</span></div>\\\\n    <div class=\\\\\\\"proof-stat\\\\\\\"><b>৪.৯/৫</b><span>গড় কাস্টমার রেটিং</span></div>\\\\n    <div class=\\\\\\\"proof-stat\\\\\\\"><b>৮,৫০০+</b><span>টি-শার্ট ডেলিভারি সম্পন্ন</span></div>\\\\n    <div class=\\\\\\\"badge-row\\\\\\\">\\\\n      <span>🚚 ৩ পিস নিলে ফ্রি ডেলিভারি</span>\\\\n      <span>↩️ ৭ দিনে রিটার্ন/এক্সচেঞ্জ</span>\\\\n      <span>🛡️ ১০০% কটন নিশ্চয়তা</span>\\\\n    </div>\\\\n  </div>\\\\n</section>\\\\n\\\\n<!-- COLOR SWATCHES / PRODUCTS -->\\\\n<section class=\\\\\\\"sec sec-alt\\\\\\\">\\\\n  <div class=\\\\\\\"container\\\\\\\">\\\\n    <div class=\\\\\\\"sec-head reveal\\\\\\\">\\\\n      <span class=\\\\\\\"eyebrow\\\\\\\">কালার ও ডিজাইন অপশন</span>\\\\n      <h2>পছন্দের ডিজাইন বেছে নিন</h2>\\\\n      <p>১ থেকে ১২ বছর বয়সী বাচ্চাদের জন্য আকর্ষণীয় ও উজ্জ্বল রঙের ভ্যারিয়েন্ট</p>\\\\n    </div>\\\\n    <div class=\\\\\\\"swatches-grid\\\\\\\">\\\\n      <div class=\\\\\\\"swatch-box reveal\\\\\\\">\\\\n        <div class=\\\\\\\"swatch-visual\\\\\\\" style=\\\\\\\"background:linear-gradient(135deg,#E0F2FE,#BAE6FD);\\\\\\\">🦕</div>\\\\n        <h4>ডাইনো প্রিন্ট (স্কাই ব্লু)</h4>\\\\n        <div class=\\\\\\\"p\\\\\\\">৳৩৯০</div>\\\\n      </div>\\\\n      <div class=\\\\\\\"swatch-box reveal reveal-delay-1\\\\\\\">\\\\n        <div class=\\\\\\\"swatch-visual\\\\\\\" style=\\\\\\\"background:linear-gradient(135deg,#FFE4E6,#FECDD3);\\\\\\\">🦁</div>\\\\n        <h4>সাফারি প্রিন্ট (কোরাল)</h4>\\\\n        <div class=\\\\\\\"p\\\\\\\">৳৩৯০</div>\\\\n      </div>\\\\n      <div class=\\\\\\\"swatch-box reveal reveal-delay-2\\\\\\\">\\\\n        <div class=\\\\\\\"swatch-visual\\\\\\\" style=\\\\\\\"background:linear-gradient(135deg,#FEF3C7,#FDE68A);\\\\\\\">🚀</div>\\\\n        <h4>স্পেস রকেট (সান ইয়েলো)</h4>\\\\n        <div class=\\\\\\\"p\\\\\\\">৳৩৯০</div>\\\\n      </div>\\\\n      <div class=\\\\\\\"swatch-box reveal reveal-delay-3\\\\\\\">\\\\n        <div class=\\\\\\\"swatch-visual\\\\\\\" style=\\\\\\\"background:linear-gradient(135deg,#DCFCE7,#BBF7D0);\\\\\\\">🌿</div>\\\\n        <h4>ক্লাসিক প্লেইন (গ্রাস গ্রিন)</h4>\\\\n        <div class=\\\\\\\"p\\\\\\\">৳৩৫০</div>\\\\n      </div>\\\\n    </div>\\\\n  </div>\\\\n</section>\\\\n\\\\n<!-- FEATURES -->\\\\n<section class=\\\\\\\"sec\\\\\\\">\\\\n  <div class=\\\\\\\"container\\\\\\\">\\\\n    <div class=\\\\\\\"sec-head reveal\\\\\\\">\\\\n      <span class=\\\\\\\"eyebrow\\\\\\\">কেন TinyTrendy সেরা?</span>\\\\n      <h2>প্রতিটি পোশাকে সর্বোচ্চ যত্ন</h2>\\\\n    </div>\\\\n    <div class=\\\\\\\"grid grid-4\\\\\\\">\\\\n      <div class=\\\\\\\"card reveal\\\\\\\">\\\\n        <div class=\\\\\\\"card-ic\\\\\\\">🧵</div>\\\\n        <h3>ডাবল-স্টিচ সেলাই</h3>\\\\n        <p>বাচ্চাদের দুরন্তপনাতেও সেলাই খোলে না, বারবার ওয়াশেও টেকসই থাকে।</p>\\\\n      </div>\\\\n      <div class=\\\\\\\"card reveal reveal-delay-1\\\\\\\">\\\\n        <div class=\\\\\\\"card-ic\\\\\\\">🌿</div>\\\\n        <h3>১০০% কম্বড কটন</h3>\\\\n        <p>বায়ো-ওয়াশড ফেব্রিক যা অত্যন্ত নরম এবং বাচ্চার কোমল ত্বকে চুলকানি মুক্ত।</p>\\\\n      </div>\\\\n      <div class=\\\\\\\"card reveal reveal-delay-2\\\\\\\">\\\\n        <div class=\\\\\\\"card-ic\\\\\\\">💧</div>\\\\n        <h3>ঘাম শোষণ ক্ষমতা</h3>\\\\n        <p>গরমেও ঘাম দ্রুত শুষে নেয়, ফলে সর্দি লাগার ভয় থাকে না।</p>\\\\n      </div>\\\\n      <div class=\\\\\\\"card reveal reveal-delay-3\\\\\\\">\\\\n        <div class=\\\\\\\"card-ic\\\\\\\">🎨</div>\\\\n        <h3>রং ও প্রিন্ট গ্যারান্টি</h3>\\\\n        <p>ইকো-ফ্রেন্ডলি নন-টক্সিক কালার, যা ধোয়ার পরেও নতুনের মতো উজ্জ্বল থাকে।</p>\\\\n      </div>\\\\n    </div>\\\\n  </div>\\\\n</section>\\\\n\\\\n<!-- TESTIMONIALS -->\\\\n<section class=\\\\\\\"sec sec-alt\\\\\\\">\\\\n  <div class=\\\\\\\"container\\\\\\\">\\\\n    <div class=\\\\\\\"sec-head reveal\\\\\\\">\\\\n      <span class=\\\\\\\"eyebrow\\\\\\\">অভিভাবকদের রিভিউ</span>\\\\n      <h2>মায়েদের আস্থার নাম TinyTrendy</h2>\\\\n    </div>\\\\n    <div class=\\\\\\\"grid grid-3\\\\\\\">\\\\n      <div class=\\\\\\\"test-card reveal\\\\\\\">\\\\n        <div class=\\\\\\\"test-stars\\\\\\\">★★★★★</div>\\\\n        <p class=\\\\\\\"test-quote\\\\\\\">\\\\\\\"কাপড়ের কোয়ালিটি মাশাল্লাহ অনেক ভালো। বাবু পরে খুব আরাম পায়, ৩ বার ধুয়েছি এক ফোঁটাও রং ওঠেনি।\\\\\\\"</p>\\\\n        <div class=\\\\\\\"test-who\\\\\\\"><span class=\\\\\\\"test-av\\\\\\\">নাজ</span><div><b>নাজমিন আক্তার</b><span>গৃহিণী, ঢাকা</span></div></div>\\\\n      </div>\\\\n      <div class=\\\\\\\"test-card reveal reveal-delay-1\\\\\\\">\\\\n        <div class=\\\\\\\"test-stars\\\\\\\">★★★★★</div>\\\\n        <p class=\\\\\\\"test-quote\\\\\\\">\\\\\\\"ডেলিভারি খুব দ্রুত পেয়েছি। সাইজ একদম পারফেক্ট ছিল। প্যাকেজিং এবং প্রোডাক্ট দুটোই প্রিমিয়াম।\\\\\\\"</p>\\\\n        <div class=\\\\\\\"test-who\\\\\\\"><span class=\\\\\\\"test-av\\\\\\\">ফার</span><div><b>ফারহানা চৌধুরী</b><span>শিক্ষক, চট্টগ্রাম</span></div></div>\\\\n      </div>\\\\n      <div class=\\\\\\\"test-card reveal reveal-delay-2\\\\\\\">\\\\n        <div class=\\\\\\\"test-stars\\\\\\\">★★★★★</div>\\\\n        <p class=\\\\\\\"test-quote\\\\\\\">\\\\\\\"দাম অনুযায়ী ফেব্রিক সত্যিই অসাধারণ। বাবুর জন্মদিনের জন্য নিয়েছিলাম, সবাই প্রশংসা করেছে।\\\\\\\"</p>\\\\n        <div class=\\\\\\\"test-who\\\\\\\"><span class=\\\\\\\"test-av\\\\\\\">তান</span><div><b>তানিয়া সুলতানা</b><span>ব্যাংকার, সিলেট</span></div></div>\\\\n      </div>\\\\n    </div>\\\\n  </div>\\\\n</section>\\\\n\\\\n<!-- FAQ -->\\\\n<section class=\\\\\\\"sec\\\\\\\">\\\\n  <div class=\\\\\\\"container\\\\\\\" style=\\\\\\\"max-width:740px;\\\\\\\">\\\\n    <div class=\\\\\\\"sec-head reveal\\\\\\\">\\\\n      <span class=\\\\\\\"eyebrow\\\\\\\">সাধারণ জিজ্ঞাসা</span>\\\\n      <h2>সচরাচর জিজ্ঞাসিত প্রশ্ন</h2>\\\\n    </div>\\\\n    <div id=\\\\\\\"faqList\\\\\\\">\\\\n      <div class=\\\\\\\"faq-item reveal\\\\\\\">\\\\n        <button class=\\\\\\\"faq-q\\\\\\\" aria-expanded=\\\\\\\"false\\\\\\\"><span>ক্যাশ অন ডেলিভারি সুবিধা আছে কি?</span> <span class=\\\\\\\"plus\\\\\\\">+</span></button>\\\\n        <div class=\\\\\\\"faq-a\\\\\\\"><div class=\\\\\\\"faq-a-inner\\\\\\\">হ্যাঁ, সারাদেশে ক্যাশ অন ডেলিভারি সুবিধা রয়েছে। পণ্য হাতে পেয়ে চেক করে মূল্য পরিশোধ করতে পারবেন।</div></div>\\\\n      </div>\\\\n      <div class=\\\\\\\"faq-item reveal\\\\\\\">\\\\n        <button class=\\\\\\\"faq-q\\\\\\\" aria-expanded=\\\\\\\"false\\\\\\\"><span>সাইজ না মিললে এক্সচেঞ্জ করা যাবে?</span> <span class=\\\\\\\"plus\\\\\\\">+</span></button>\\\\n        <div class=\\\\\\\"faq-a\\\\\\\"><div class=\\\\\\\"faq-a-inner\\\\\\\">হ্যাঁ! ডেলিভারি পাওয়ার ৭ দিনের মধ্যে আপনি সহজেই সাইজ বা কালার এক্সচেঞ্জ করে নিতে পারবেন।</div></div>\\\\n      </div>\\\\n      <div class=\\\\\\\"faq-item reveal\\\\\\\">\\\\n        <button class=\\\\\\\"faq-q\\\\\\\" aria-expanded=\\\\\\\"false\\\\\\\"><span>ডেলিভারি চার্জ কত এবং কতদিনে পাব?</span> <span class=\\\\\\\"plus\\\\\\\">+</span></button>\\\\n        <div class=\\\\\\\"faq-a\\\\\\\"><div class=\\\\\\\"faq-a-inner\\\\\\\">ঢাকার ভেতরে ডেলিভারি ৬০ টাকা (২৪-৪৮ ঘণ্টা), এবং ঢাকার বাইরে ১২০ টাকা (৪৮-৭২ ঘণ্টা)। ৩টি বা তার বেশি নিলে ফ্রি ডেলিভারি!</div></div>\\\\n      </div>\\\\n      <div class=\\\\\\\"faq-item reveal\\\\\\\">\\\\n        <button class=\\\\\\\"faq-q\\\\\\\" aria-expanded=\\\\\\\"false\\\\\\\"><span>কাপড় কি ১০০% কটন?</span> <span class=\\\\\\\"plus\\\\\\\">+</span></button>\\\\n        <div class=\\\\\\\"faq-a\\\\\\\"><div class=\\\\\\\"faq-a-inner\\\\\\\">হ্যাঁ, আমাদের সব বাচ্চাদের টি-শার্ট ১০০% কম্বড সুতি কাপড় দিয়ে তৈরি, যা শিশুদের সংবেদনশীল ত্বকের জন্য সম্পূর্ণ নিরাপদ।<