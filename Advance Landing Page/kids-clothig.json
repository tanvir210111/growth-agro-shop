\n    font-size:32px;\\r\\n    color:var(--navy);\\r\\n    margin-bottom:8px;\\r\\n  }\\r\\n  .hero h1 em{\\r\\n    font-style:normal;\\r\\n    color:var(--coral);\\r\\n    position:relative;\\r\\n  }\\r\\n  .hero p.sub{\\r\\n    font-size:15px;\\r\\n    color:#4a5670;\\r\\n    line-height:1.55;\\r\\n    max-width:34ch;\\r\\n    margin-bottom:18px;\\r\\n  }\\r\\n  .hero-img{\\r\\n    position:relative;\\r\\n    border-radius:18px;\\r\\n    overflow:hidden;\\r\\n    aspect-ratio:4/3;\\r\\n    background:linear-gradient(135deg,var(--sky),#7dd3e8);\\r\\n    display:flex; align-items:center; justify-content:center;\\r\\n    margin-bottom:16px;\\r\\n  }\\r\\n  .hero-img .placeholder-note{\\r\\n    color:#fff; font-size:13px; text-align:center; padding:20px;\\r\\n    font-weight:600; opacity:.9;\\r\\n  }\\r\\n  .price-tag{\\r\\n    position:absolute; top:14px; right:14px;\\r\\n    background:var(--sun);\\r\\n    color:var(--navy);\\r\\n    padding:8px 14px;\\r\\n    border-radius:10px;\\r\\n    font-family:&#039;Baloo Da 2&#039;; font-weight:800; font-size:15px;\\r\\n    box-shadow:0 4px 10px rgba(0,0,0,.15);\\r\\n    transform:rotate(4deg);\\r\\n  }\\r\\n  .price-tag::after{\\r\\n    content:&quot;&quot;;\\r\\n    position:absolute; top:-5px; right:14px;\\r\\n    width:9px; height:9px; background:var(--navy); border-radius:50%;\\r\\n  }\\r\\n\\r\\n  .hero-cta{\\r\\n    display:block; text-align:center;\\r\\n    background:var(--grass);\\r\\n    color:#fff;\\r\\n    font-family:&#039;Baloo Da 2&#039;; font-weight:700; font-size:17px;\\r\\n    padding:15px;\\r\\n    border-radius:14px;\\r\\n    text-decoration:none;\\r\\n    box-shadow:0 6px 0 #3f8a3f;\\r\\n    letter-spacing:.3px;\\r\\n  }\\r\\n  .hero-cta:active{ box-shadow:0 2px 0 #3f8a3f; transform:translateY(4px); }\\r\\n  .trust-row{\\r\\n    display:flex; justify-content:space-between;\\r\\n    margin-top:12px; font-size:11.5px; color:#5a6580; font-weight:600;\\r\\n  }\\r\\n  .trust-row span{display:flex; align-items:center; gap:4px;}\\r\\n\\r\\n  /* --- section generic --- */\\r\\n  section{padding:26px 20px;}\\r\\n  .section-head{margin-bottom:16px;}\\r\\n  .section-head .tag{\\r\\n    font-size:12px; font-weight:700; color:var(--sky);\\r\\n    text-transform:uppercase; letter-spacing:.6px;\\r\\n  }\\r\\n  .section-head h2{font-size:23px; margin-top:4px;}\\r\\n\\r\\n  /* --- fabric swatch strip (signature motif reused) --- */\\r\\n  .swatches{\\r\\n    display:flex; gap:10px; overflow-x:auto; padding-bottom:6px;\\r\\n    scrollbar-width:none;\\r\\n  }\\r\\n  .swatches::-webkit-scrollbar{display:none;}\\r\\n  .swatch-card{\\r\\n    flex:0 0 128px;\\r\\n    background:var(--cream);\\r\\n    border-radius:14px;\\r\\n    padding:10px;\\r\\n    border:1.5px solid var(--line);\\r\\n  }\\r\\n  .swatch-img{\\r\\n    aspect-ratio:1/1; border-radius:10px; margin-bottom:8px;\\r\\n    display:flex; align-items:center; justify-content:center;\\r\\n    font-size:11px; color:#fff; font-weight:700; text-align:center; padding:6px;\\r\\n  }\\r\\n  .swatch-card h4{font-size:13.5px; margin-bottom:2px;}\\r\\n  .swatch-card .p{font-size:12.5px; color:var(--coral); font-weight:700;}\\r\\n\\r\\n  /* --- why us: stitched ticket rows --- */\\r\\n  .why-list{display:flex; flex-direction:column;}\\r\\n  .why-item{\\r\\n    display:flex; align-items:flex-start; gap:12px;\\r\\n    padding:14px 0;\\r\\n  }\\r\\n  .why-item .ic{\\r\\n    flex:0 0 40px; height:40px; border-radius:11px;\\r\\n    display:flex; align-items:center; justify-content:center;\\r\\n    font-size:19px;\\r\\n  }\\r\\n  .why-item h4{font-size:15px; margin-bottom:2px;}\\r\\n  .why-item p{font-size:13px; color:#5a6580; line-height:1.5;}\\r\\n\\r\\n  /* --- size chart --- */\\r\\n  .size-table{\\r\\n    width:100%; border-collapse:collapse;\\r\\n    font-size:13px;\\r\\n    background:#fff;\\r\\n    border-radius:12px;\\r\\n    overflow:hidden;\\r\\n    border:1.5px solid var(--line);\\r\\n  }\\r\\n  .size-table th{\\r\\n    background:va