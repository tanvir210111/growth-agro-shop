\r\\\\n    const qtyEl = document.getElementById('qty');\\\\r\\\\n    const sumItem = document.getElementById('sum-item');\\\\r\\\\n    const sumQty = document.getElementById('sum-qty');\\\\r\\\\n    const sumPrice = document.getElementById('sum-price');\\\\r\\\\n    const sumTotal = document.getElementById('sum-total');\\\\r\\\\n    const mobilePrice = document.getElementById('mobile-price');\\\\r\\\\n    function fmt(n){ return '৳' + toBn(Number(n).toLocaleString('en-IN')); }\\\\r\\\\n    function update(){\\\\r\\\\n      const price = parseInt(variantEl.value, 10);\\\\r\\\\n      const qty = Math.max(1, parseInt(qtyEl.value || '1', 10));\\\\r\\\\n      const label = variantEl.options[variantEl.selectedIndex].text.split('—')[0].trim();\\\\r\\\\n      sumItem.textContent = label;\\\\r\\\\n      sumQty.textContent = toBn(qty);\\\\r\\\\n      sumPrice.textContent = fmt(price);\\\\r\\\\n      sumTotal.textContent = fmt(price * qty);\\\\r\\\\n      mobilePrice.textContent = fmt(price);\\\\r\\\\n    }\\\\r\\\\n    variantEl.addEventListener('change', update);\\\\r\\\\n    qtyEl.addEventListener('input', update);\\\\r\\\\n    update();\\\\r\\\\n    document.getElementById('orderForm').addEventListener('submit', function(e){\\\\r\\\\n      e.preventDefault();\\\\r\\\\n      alert('ধন্যবাদ! আপনার অর্ডার রিকোয়েস্ট পেয়েছি। শীঘ্রই কল করে কনফার্ম করা হবে।');\\\\r\\\\n      this.reset();\\\\r\\\\n      update();\\\\r\\\\n    });\\\\r\\\\n  })();\\\\r\\\\n</script>\\\\r\\\\n\\\\r\\\\n</body>\\\\r\\\\n</html>\\\"},\\\"elements\\\":[],\\\"widgetType\\\":\\\"html\\\"}],\\\"isInner\\\":false}],\\\"isInner\\\":false},{\\\"id\\\":\\\"be570b3\\\",\\\"elType\\\":\\\"section\\\",\\\"settings\\\":{\\\"gap\\\":\\\"no\\\",\\\"border_border\\\":\\\"none\\\",\\\"padding\\\":{\\\"unit\\\":\\\"px\\\",\\\"top\\\":\\\"30\\\",\\\"right\\\":\\\"0\\\",\\\"bottom\\\":\\\"50\\\",\\\"left\\\":\\\"0\\\",\\\"isLinked\\\":false},\\\"padding_tablet\\\":{\\\"unit\\\":\\\"px\\\",\\\"top\\\":\\\"20\\\",\\\"