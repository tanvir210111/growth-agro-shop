\\\"chev\\\\\\\" width=\\\\\\\"16\\\\\\\" height=\\\\\\\"16\\\\\\\" viewBox=\\\\\\\"0 0 24 24\\\\\\\" fill=\\\\\\\"none\\\\\\\" stroke=\\\\\\\"currentColor\\\\\\\" stroke-width=\\\\\\\"2\\\\\\\"><path d=\\\\\\\"M6 9l6 6 6-6\\\\\\\"/></svg></summary>\\\\r\\\\n          <p>সিল্ক ভ্যারিয়েন্টের জন্য ড্রাই ক্লিন সুপারিশ করা হয়; কটন ও জর্জেটের জন্য ঠান্ডা পানিতে হালকা হাতে ধোয়া যাবে।</p>\\\\r\\\\n        </details>\\\\r\\\\n        <details>\\\\r\\\\n          <summary>ডেলিভারি সময় <svg class=\\\\\\\"chev\\\\\\\" width=\\\\\\\"16\\\\\\\" height=\\\\\\\"16\\\\\\\" viewBox=\\\\\\\"0 0 24 24\\\\\\\" fill=\\\\\\\"none\\\\\\\" stroke=\\\\\\\"currentColor\\\\\\\" stroke-width=\\\\\\\"2\\\\\\\"><path d=\\\\\\\"M6 9l6 6 6-6\\\\\\\"/></svg></summary>\\\\r\\\\n          <p>ঢাকার ভিতরে ১-২ দিন, দেশের অন্যান্য জেলায় ২-৪ দিনের মধ্যে কুরিয়ারের মাধ্যমে ডেলিভারি পৌঁছে যাবে।</p>\\\\r\\\\n        </details>\\\\r\\\\n      </div>\\\\r\\\\n    </div>\\\\r\\\\n  </section>\\\\r\\\\n\\\\r\\\\n  <!-- ৮. সীমিত সময়ের অফার -->\\\\r\\\\n  <section class=\\\\\\\"offer-section\\\\\\\" aria-labelledby=\\\\\\\"offer-heading\\\\\\\">\\\\r\\\\n    <div class=\\\\\\\"container reveal\\\\\\\">\\\\r\\\\n      <span class=\\\\\\\"offer-badge\\\\\\\">সীমিত সময়ের অফার</span>\\\\r\\\\n      <h2 id=\\\\\\\"offer-heading\\\\\\\">৩০% পর্যন্ত ছাড় — শীঘ্রই শেষ</h2>\\\\r\\\\n      <p class=\\\\\\\"sub\\\\\\\">উৎসবের ডিজাইনগুলোতে স্টক সীমিত। অফার শেষ হওয়ার আগেই আপনার শাড়িটি নিশ্চিত করুন।</p>\\\\r\\\\n      <div class=\\\\\\\"countdown\\\\\\\" id=\\\\\\\"countdown\\\\\\\" role=\\\\\\\"timer\\\\\\\" aria-live=\\\\\\\"polite\\\\\\\">\\\\r\\\\n        <div class=\\\\\\\"cd-box\\\\\\\"><div class=\\\\\\\"num\\\\\\\" id=\\\\\\\"cd-hours\\\\\\\">৪৮</div><div class=\\\\\\\"lbl\\\\\\\">ঘণ্টা</div></div>\\\\r\\\\n        <div class=\\\\\\\"cd-box\\\\\\\"><div class=\\\\\\\"num\\\\\\\" id=\\\\\\\"cd-minutes\\\\\\\">০০</div><div class=\\\\\\\"lbl\\\\\\\">মিনিট</div></div>\\\\r\\\\n        <div class=\\\\\\\"cd-box\\\\\