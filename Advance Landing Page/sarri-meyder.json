\\\\n    const mEl = document.getElementById('cd-minutes');\\\\r\\\\n    const sEl = document.getElementById('cd-seconds');\\\\r\\\\n    function tick(){\\\\r\\\\n      const diff = Math.max(0, end - Date.now());\\\\r\\\\n      hEl.textContent = toBn(String(Math.floor(diff\\\\/3600000)).padStart(2,'0'));\\\\r\\\\n      mEl.textContent = toBn(String(Math.floor((diff%3600000)\\\\/60000)).padStart(2,'0'));\\\\r\\\\n      sEl.textContent = toBn(String(Math.floor((diff%60000)\\\\/1000)).padStart(2,'0'));\\\\r\\\\n    }\\\\r\\\\n    tick(); setInterval(tick, 1000);\\\\r\\\\n  })();\\\\r\\\\n\\\\r\\\\n  (function(){\\\\r\\\\n    const variantEl = document.getElementById('variant');\\\\r\\\\n    const qtyEl = document.getElementById('qty');\\\\r\\\\n    const sumItem = document.getElementById('sum-item');\\\\r\\\\n    const sumQty = document.getElementById('sum-qty');\\\\r\\\\n    const sumPrice = document.getElementById('sum-price');\\\\r\\\\n    const sumTotal = document.getElementById('sum-total');\\\\r\\\\n    const mobilePrice = document.getElementById('mobile-price');\\\\r\\\\n    function fmt(n){ return '\\\\u09f3' + toBn(Number(n).toLocaleString('en-IN')); }\\\\r\\\\n    function update(){\\\\r\\\\n      const price = parseInt(variantEl.value, 10);\\\\r\\\\n      const qty = Math.max(1, parseInt(qtyEl.value || '1', 10));\\\\r\\\\n      const label = variantEl.options[variantEl.selectedIndex].text.split('\\\\u2014')[0].trim();\\\\r\\\\n      sumItem.textContent = label;\\\\r\\\\n      sumQty.textContent = toBn(qty);\\\\r\\\\n      sumPrice.textContent = fmt(price);\\\\r\\\\n      sumTotal.textContent = fmt(price * qty);\\\\r\\\\n      mobilePrice.textContent = fmt(price);\\\\r\\\\n    }\\\\r\\\\n    variantEl.addEventListener('change', update);\\\\r\\\\n    qtyEl.addEventListener('input', update);\\\\r\\\\n    update();\\\\r\\\\n    document.getElementById('orderForm').addEventListener('submit', function(e){\\\\r\\\\n      e.preventDefault();\\\\r\\\\n      alert('\\\\u09a7\\\\u09a8\\\\u09cd\\\\u09af\\\\u09ac\\\\u09be\\\\u09a6! \\\\u0986\\\\u09aa\\\\u09a8\\\\u09be\\\\u09b0 \\\\u0985\\\\u09b0\\\\u09cd\\\\u09a1\\\\u09be\\\\u09b0 \\\\u09b0\\\\u09bf\\\\u0995\\\\u09cb\\\\u09af\\\\u09bc\\\\u09c7\\\\u09b8\\\\u09cd\\\\u099f \\\\u09aa\\\\u09c7\\\\u09af\\\\u09bc\\\\u09c7\\\\u099b\\\\u09bf\\\\u0964 \\\\u09b6\\\\u09c0\\\\u0998\\\\u09cd\\\\u09b0\\\\u0987 \\\\u0995\\\\u09b2 \\\\u0995\\\\u09b0\\\\u09c7 \\\\u0995\\\\u09a8\\\\u09ab\\\\u09be\\\\u09b0\\\\u09cd\\\\u09ae \\\\u0995\\\\u09b0\\\\u09be \\\\u09b9\\\\u09ac\\\\u09c7\\\\u0964');\\\\r\\\\n      this.reset();\\\\r\\\\n      update();\\\\r\\\\n    });\\\\r\\\\n  })();\\\\r\\\\n<\\\\/script>\\\\r\\\\n\\\\r\\\\n<\\\\/body>\\\\r\\\\n<\\\\/html>\\\\t\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t<\\\\/section>\\\\n\\\\t\\\\t\\\\t\\\\t<section class=\\\\\\\"elementor-section elementor-top-section elementor-element elementor-element-be570b3 order elementor-section-boxed elementor-section-height-default elementor-section-height-default\\\\\\\" data-id=\\\\\\\"be570b3\\\\\\\" data-element_type=\\\\\\\"section\\\\\\\" data-e-type=\\\\\\\"section\\\\\\\" id=\\\\\\\"order-form\\\\\\\">\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t<div class=\\\\\\\"elementor-container elementor-column-gap-no\\\\\\\">\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t<div class=\\\\\\\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-4bea656d\\\\\\\" data-id=\\\\\\\"4bea656d\\\\\\\" data-element_type=\\\\\\\"column\\\\\\\" data-e-type=\\\\\\\"column\\\\\\\" data-settings=\\\\\\\"{&quot;background_background&quot;:&quot;classic&quot;}\\\\\\\">\\\\n\\\\t\\\\t\\\\t<div class=\\\\\\\"elementor-widget-wrap elementor-element-populated\\\\\\\">\\\\n\\\\t\\\\t\\\\t\\\\t[elementor-element k=\\\\\\\"92e4ac0eb02027586a495999807932b9\\\\\\\" data=\\\\\\\"eyJpZCI6ImEwM2RlNjIiLCJlbFR5cGUiOiJ3aWRnZXQiLCJzZXR0aW5ncyI6eyJsYXlvdXQiOiJ0d28tY29sdW1uIiwibm90ZV90ZXh0IjoiR2V0IFlvdXIgRlJFRSBjb3B5IG9mIENhcnRGbG93cyBpbiBqdXN0IGZldyBzdGVwcy4iLCJzdGVwX29uZV90aXRsZV90ZXh0IjoiU2hpcHBpbmciLCJzdGVwX29uZV9zdWJfdGl0bGVfdGV4dCI6IldoZXJlIHRvIHNoaXAgaXQ\\\\\\\\\\\"]\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t<\\\\/section>\\\\n\\\\t\\\\t\\\\t\\\\t<section class=\\\\\\\"elementor-section elementor-top-section elementor-element elementor-element-62ac697 elementor-section-boxed elementor-section-height-default elementor-section-height-default\\\\\\\" data-id=\\\\\\\"62ac697\\\\\\\" data-element_type=\\\\\\\"section\\\\\\\" data-e-type=\\\\\\\"section\\\\\\\" data-settings=\\\\\\\"{&quot;background_background&quot;:&quot;classic&quot;}\\\\\\\">\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t<div class=\\\\\\\"elementor-container elementor-column-gap-default\\\\\\\">\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t<div class=\\\\\\\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-1d12cb75\\\\\\\" data-id=\\\\\\\"1d12cb75\\\\\\\" data-element_type=\\\\\\\"column\\\\\\\" data-e-type=\\\\\\\"column\\\\\\\">\\\\n\\\\t\\\\t\\\\t<div class=\\\\\\\"elementor-widget-wrap elementor-element-populated\\\\\\\">\\\\n\\\\t\\\\t\\\\t\\\\t[elementor-element k=\\\\\\\"92e4ac0eb02027586a495999807932b9\\\\\\\" data=\\\\\\\"\\\\\\\"]\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t<\\\\/section>\\\\n\\\\t\\\\t\\\",\\\"scripts\\\":[],\\\"styles\\\":[]}}\"]},\"post_content\":\"<!DOCTYPE html>\\n<html lang=\\\"bn\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\">\\n<title>প্রতিটি অনুষ্ঠানে অভিজাত শাড়ি | প্রিমিয়াম শাড়ি কালেকশন</title>\\n<meta name=\\\"description\\\" content=\\\"জামদানি, টাঙ্গাইল তাঁত, রাজশাহী সিল্কসহ প্রিমিয়াম শাড়ি কালেকশন। ১০০% মান পরীক্ষিত, ক্যাশ অন ডেলিভারি, সারাদেশে ডেলিভারি। এখনই অর্ডার করুন।\\\">\\n<meta name=\\\"theme-color\\\" content=\\\"#FBF6EE\\\">\\n<link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\">\\n<link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin>\\n<link href=\\\"https://fonts.googleapis.com/css2?family=Tiro+Bangla&family=Hind+Siliguri:wght@400;500;600;700&display=swap\\\" rel=\\\"stylesheet\\\">\\n<style>\\n  :root{\\n    --cream:#FBF6EE;\\n    --cream-2:#F3E9D8;\\n    --ink:#2B241D;\\n    --muted:#8A7F6F;\\n    --gold:#C9A24B;\\n    --gold-dark:#A9822F;\\n    --gold-soft:#E8D5A8;\\n    --maroon:#7A1F2B;\\n    --maroon-dark:#5E1620;\\n    --paper:#FFFFFF;\\n  }\\n  *{box-sizing:border-box; margin:0; padding:0;}\\n  html{scroll-behavior:smooth;}\\n  body{font-family:'Hind Siliguri', sans-serif; background:var(--cream); color:var(--ink); -webkit-font-smoothing:antialiased;}\\n  img{max-width:100%; display:block;}\\n  a{color:inherit; text-decoration:none;}\\n  .container{max-width:1180px; margin:0 auto; padding:0 20px;}\\n  h1,h2,h3,.display{font-family:'Tiro Bangla', serif; font-weight:400; line-height:1.25;}\\n  .reveal{opacity:0; transform:translateY(22px); transition:opacity .7s ease, transform .7s ease;}\\n  .reveal.in{opacity:1; transform:translateY(0);}\\n  @media (prefers-reduced-motion: reduce){ .reveal{opacity:1; transform:none; transition:none;} }\\n  .zari{height:14px; background-image:radial-gradient(circle at 7px 7px, var(--gold) 2px, transparent 2.4px); background-size:14px 14px; background-position:center; opacity:.5;}\\n  .zari-line{height:1px; max-width:700px; margin:0 auto; background:linear-gradient(90deg, transparent, var(--gold) 15%, var(--gold) 85%, transparent);}\\n  header{position:sticky; top:0; z-index:40; background:rgba(251,246,238,.95); backdrop-filter:blur(6px); border-bottom:1px solid rgba(201,162,75,.2);}\\n  .header-inner{display:flex; align-items:center; justify-content:space-between; padding:14px 0;}\\n  .brand{font-size:23px; letter-spacing:.3px;}\\n  .brand em{font-style:normal; color:var(--gold-dark);}\\n  .btn{display:inline-flex; align-items:center; justify-content:center; gap:8px; font-family:'Hind Siliguri'; font-weight:600; border-radius:2px; text-align:center; cursor:pointer; border:none;}\\n  .btn-primary{background:var(--maroon); color:var(--cream); padding:12px 24px; font-size:14px;}\\n  .btn-primary:hover{background:var(--maroon-dark);}\\n  .head-cta{display:none;}\\n  .hero{position:relative; overflow:hidden; background:linear-gradient(160deg, var(--cream-2), var(--cream) 60%);}\\n  .hero-blob{position:absolute; top:-90px; right:-90px; width:340px; height:340px; border-radius:50%; background:rgba(201,162,75,.12); filter:blur(50px);}\\n  .hero-grid{position:relative; display:grid; gap:38px; padding:40px 0 52px;}\\n  .eyebrow{color:var(--gold-dark); font-size:12px; letter-spacing:2px; font-weight:500; margin-bottom:14px;}\\n  .hero h1{font-size:34px; margin-bottom:18px;}\\n  .hero h1 b{color:var(--maroon); font-weight:400;}\\n  .hero-sub{color:var(--muted); font-size:15.5px; margin-bottom:26px; max-width:420px; line-height:1.6;}\\n  .shimmer{background:linear-gradient(110deg, var(--maroon) 40%, #9c2a3a 50%, var(--maroon) 60%); background-size:200% 100%; animation:shimmer 3.2s infinite linear; color:var(--cream); font-size:16px; padding:16px 34px; box-shadow:0 12px 26px -8px rgba(122,31,43,.35);}\\n  @keyframes shimmer{0%{background-position:-200% 0;}100%{background-position:200% 0;}}\\n  @media (prefers-reduced-motion: reduce){.shimmer{animation:none;}}\\n  .hero-stats{display:flex; align-items:center; gap:22px; margin-top:36px; font-size:12px; color:var(--muted);}\\n  .hero-stats .div{width:1px; height:16px; background:rgba(201,162,75,.3);}\\n  .hero-image{position:relative;}\\n  .hero-frame{position:absolute; inset:-12px; border:1px solid rgba(201,162,75,.5); border-radius:2px;}\\n  .hero-img-wrap{position:relative; aspect-ratio:4/5; border-radius:2px; overflow:hidden; box-shadow:0 30px 60px -20px rgba(43,36,29,.25);}\\n  .hero-img-wrap img{width:100%; height:100%; object-fit:cover;}\\n  .price-badge{position:absolute; left:-18px; bottom:-18px; background:var(--paper); border:1px solid rgba(201,162,75,.4); border-radius:2px; box-shadow:0 12px 26px rgba(0,0,0,.1); padding:12px 20px;}\\n  .price-badge .now{font-size:22px; color:var(--maroon); line-height:1;}\\n  .price-badge .label{font-size:11px; color:var(--muted); margin-top:4px;}\\n  .trust-bar{background:var(--ink); color:var(--cream);}\\n  .trust-grid{display:grid; grid-template-columns:1fr 1fr; gap:20px 16px; padding:22px 0;}\\n  .trust-item{display:flex; align-items:center; gap:12px; font-size:13px;}\\n  .trust-item svg{color:var(--gold-soft); flex:none;}\\n  section{padding:56px 0;}\\n  .section-head{text-align:center; max-width:520px; margin:0 auto 44px;}\\n  .section-head .tag{color:var(--gold-dark); font-size:12px; letter-spacing:2px; font-weight:500; margin-bottom:10px;}\\n  .section-head h2{font-size:27px;}\\n  .section-head.light .tag{color:var(--gold-soft);}\\n  .section-head.light h2{color:var(--cream);}\\n  .products-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:16px;}\\n  .product-card{display:block;}\\n  .product-img-wrap{position:relative; aspect-ratio:3/4; border-radius:2px; overflow:hidden; background:var(--cream-2);}\\n  .product-img-wrap img{width:100%; height:100%; object-fit:cover; transition:transform .5s ease;}\\n  .product-card:hover .product-img-wrap img{transform:scale(1.07);}\\n  .discount-badge{position:absolute; top:10px; left:10px; background:var(--maroon); color:var(--cream); font-size:11px; font-weight:500; padding:4px 10px; border-radius:2px;}\\n  .product-name{font-family:'Hind Siliguri'; font-weight:500; font-size:13.5px; margin:12px 0 6px;}\\n  .price-row{display:flex; align-items:center; gap:8px; margin-bottom:12px;}\\n  .price-row .now{color:var(--maroon); font-size:17px; font-weight:400; font-family:'Tiro Bangla',serif;}\\n  .price-row .old{color:var(--muted); font-size:12px; text-decoration:line-through;}\\n  .btn-outline{display:block; text-align:center; border:1px solid rgba(43,36,29,.15); font-size:13px; padding:10px; border-radius:2px; transition:border-color .15s ease, color .15s ease;}\\n  .btn-outline:hover{border-color:var(--maroon); color:var(--maroon);}\\n  .why-band{background:rgba(243,233,216,.6);}\\n  .why-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:26px 20px;}\\n  .why-item{text-align:center;}\\n  .why-icon{width:56px; height:56px; margin:0 auto 14px; border-radius:50%; background:var(--paper); border:1px solid rgba(201,162,75,.4); display:flex; align-items:center; justify-content:center; color:var(--gold-dark);}\\n  .why-item h3{font-family:'Hind Siliguri'; font-size:14.5px; font-weight:500; margin-bottom:4px;}\\n  .why-item p{font-size:12.5px; color:var(--muted);}\\n  .gallery-grid{display:grid; grid-template-columns:repeat(2,1fr); gap:10px;}\\n  .gallery-item{aspect-ratio:1/1; border-radius:2px; overflow:hidden;}\\n  .gallery-item img{width:100%; height:100%; object-fit:cover; transition:transform .5s ease;}\\n  .gallery-item:hover img{transform:scale(1.08);}\\n  .reviews-section{background:var(--ink);}\\n  .reviews-scroll{display:flex; gap:14px; overflow-x:auto; padding-bottom:8px; scroll-snap-type:x mandatory; scrollbar-width:none;}\\n  .reviews-scroll::-webkit-scrollbar{display:none;}\\n  .review-card{scroll-snap-align:start; flex:0 0 78%; background:rgba(255,255,255,.05); border:1px solid rgba(201,162,75,.15); border-radius:2px; padding:20px;}\\n  .review-top{display:flex; align-items:center; gap:12px; margin-bottom:12px;}\\n  .review-top img{width:40px; height:40px; border-radius:50%; object-fit:cover;}\\n  .review-top .name{color:var(--cream); font-size:13.5px; font-weight:500;}\\n  .review-top .stars{color:var(--gold-soft); font-size:12px; margin-top:2px;}\\n  .review-card p{color:rgba(251,246,238,.8); font-size:13.5px; line-height:1.6;}\\n  .accordion{border-top:1px solid rgba(201,162,75,.2);}\\n  .accordion details{border-bottom:1px solid rgba(201,162,75,.2); padding:16px 0;}\\n  .accordion summary{display:flex; align-items:center; justify-content:space-between; cursor:pointer; font-weight:500; font-size:14px; list-style:none;}\\n  .accordion summary::-webkit-details-marker{display:none;}\\n  .accordion summary .chev{transition:transform .2s ease; color:var(--gold-dark); flex:none; margin-left:12px;}\\n  .accordion details[open] summary .chev{transform:rotate(180deg);}\\n  .accordion details p{color:var(--muted); font-size:13.5px; margin-top:10px; line-height:1.65;}\\n  .offer-section{background:linear-gradient(150deg, var(--maroon), var(--maroon-dark)); text-align:center;}\\n  .offer-badge{display:inline-block; background:var(--gold); color:var(--maroon-dark); font-size:11px; font-weight:600; padding:6px 16px; border-radius:20px; margin-bottom:16px;}\\n  .offer-section h2{color:var(--cream); font-size:27px; margin-bottom:10px;}\\n  .offer-section .sub{color:rgba(251,246,238,.7); font-size:14px; margin-bottom:30px;}\\n  .countdown{display:flex; align-items:center; justify-content:center; gap:12px;}\\n  .cd-box{background:var(--ink); color:var(--gold-soft); border-radius:2px; padding:12px 18px; min-width:68px; font-family:'Tiro Bangla',serif;}\\n  .cd-box .num{font-size:24px; font-weight:400; line-height:1;}\\n  .cd-box .lbl{font-size:9px; color:rgba(232,213,168,.7); margin-top:4px; font-family:'Hind Siliguri';}\\n  .offer-cta{display:inline-flex; background:var(--gold); color:var(--maroon-dark); font-weight:600; padding:14px 32px; border-radius:2px; margin-top:34px; font-size:14.5px;}\\n  .offer-cta:hover{background:var(--gold-soft);}\\n  .order-section{background:rgba(243,233,216,.6);}\\n  .order-layout{display:grid; gap:26px;}\\n  .order-form{background:var(--paper); border:1px solid rgba(201,162,75,.2); border-radius:2px; padding:24px;}\\n  .field{margin-bottom:18px;}\\n  .field label{display:block; font-size:13.5px; font-weight:500; margin-bottom:6px;}\\n  .field input, .field select, .field textarea{width:100%; border:1px solid rgba(43,36,29,.15); border-radius:2px; padding:12px 14px; font-size:13.5px; font-family:'Hind Siliguri'; background:rgba(251,246,238,.4);}\\n  .field input:focus, .field select:focus, .field textarea:focus{outline:none; border-color:var(--gold);}\\n  .field-row{display:grid; grid-template-columns:1fr 1fr; gap:16px;}\\n  .submit-btn{width:100%; padding:16px; font-size:15px;}\\n  .cod-note{text-align:center; font-size:12px; color:var(--muted); margin-top:14px; line-height:1.6;}\\n  .pay-badges{display:flex; justify-content:center; gap:8px; margin-top:10px; flex-wrap:wrap;}\\n  .pay-badges span{font-size:11px; border:1px solid rgba(43,36,29,.15); padding:4px 10px; border-radius:20px; color:var(--muted);}\\n  .order-summary{background:var(--ink); color:var(--cream); border-radius:2px; padding:22px; height:fit-content;}\\n  .order-summary h3{font-size:19px; margin-bottom:14px;}\\n  .sum-row{display:flex; justify-content:space-between; font-size:13.5px; padding:10px 0; border-bottom:1px solid rgba(255,255,255,.1);}\\n  .sum-row .k{color:rgba(251,246,238,.6);}\\n  .sum-total{display:flex; justify-content:space-between; font-size:16px; font-weight:600; padding:14px 0 4px;}\\n  .sum-total .v{color:var(--gold-soft); font-family:'Tiro Bangla',serif; font-weight:400;}\\n  .sum-note{font-size:10.5px; color:rgba(251,246,238,.45); margin-top:8px; line-height:1.6;}\\n  .fab-stack{position:fixed; right:16px; bottom:96px; z-index:50; display:flex; flex-direction:column; gap:12px;}\\n  .fab{width:48px; height:48px; border-radius:50%; display:flex; align-items:center; justify-content:center; color:#fff; box-shadow:0 8px 18px rgba(0,0,0,.2); transition:transform .15s ease;}\\n  .fab:hover{transform:scale(1.06);}\\n  .fab-whatsapp{background:#25D366;}\\n  .fab-messenger{background:#0084FF;}\\n  .fab-call{background:var(--maroon);}\\n  .sticky-bar{position:fixed; left:0; right:0; bottom:0; z-index:45; background:rgba(255,255,255,.96); backdrop-filter:blur(6px); border-top:1px solid rgba(201,162,75,.25); padding:12px 16px; display:flex; align-items:center; gap:12px; box-shadow:0 -8px 22px rgba(0,0,0,.08);}\\n  .sticky-bar .info{flex:1;}\\n  .sticky-bar .price{font-family:'Tiro Bangla',serif; font-size:18px; line-height:1;}\\n  .sticky-bar .note{font-size:10px; color:var(--muted); margin-top:3px;}\\n  .sticky-bar .btn-primary{padding:12px 22px; font-size:13.5px;}\\n  #order-form{scroll-margin-top:70px;}\\n  @media (min-width:900px){\\n    .head-cta{display:inline-flex;}\\n    .hero-grid{grid-template-columns:1fr 1fr; align-items:center; padding:70px 0 90px; gap:70px;}\\n    .hero h1{font-size:48px;}\\n    .hero-sub{font-size:16.5px; max-width:460px;}\\n    section{padding:88px 0;}\\n    .section-head h2{font-size:32px;}\\n    .trust-grid{grid-template-columns:repeat(4,1fr); padding:26px 0;}\\n    .products-grid{grid-template-columns:repeat(3,1fr); gap:26px;}\\n    .why-grid{grid-template-columns:repeat(3,1fr); gap:40px;}\\n    .gallery-grid{grid-template-columns:repeat(4,1fr); gap:18px;}\\n    .reviews-scroll{overflow:visible; display:grid; grid-template-columns:repeat(4,1fr); gap:16px;}\\n    .review-card{flex:none;}\\n    .accordion{max-width:720px; margin:0 auto;}\\n    .cd-box{min-width:88px; padding:16px 24px;}\\n    .cd-box .num{font-size:30px;}\\n    .order-layout{grid-template-columns:2fr 1fr;}\\n    .order-form{padding:36px;}\\n    .order-summary{position:sticky; top:96px;}\\n    .submit-btn{width:auto; padding:16px 40px;}\\n    .sticky-bar{display:none;}\\n    .fab-stack{bottom:28px;}\\n  }\\n  @media (min-width:1200px){ .hero h1{font-size:52px;} }\\n</style>\\n</head>\\n<body>\\n<header>\\n    <a href=\\\"#\\\">বিদেশী<em>শাড়ি</em></a>\\n    <a href=\\\"#order-form\\\">অর্ডার করুন</a>\\n</header>\\n<main>\\n  <!-- ১. হিরো সেকশন -->\\n  <section aria-labelledby=\\\"hero-heading\\\">\\n        <p>— নতুন উৎসব কালেকশন —</p>\\n    