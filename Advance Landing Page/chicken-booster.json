rge=\\\\\\\"120\\\\\\\" checked>\\\\n                            ঢাকার বাইরে (৳১২০)\\\\n                          </span>\\\\n                        </label>\\\\n                      </div>\\\\n                    </td>\\\\n                    <td class=\\\\\\\"text-right\\\\\\\" id=\\\\\\\"review-delivery-charge\\\\\\\" style=\\\\\\\"vertical-align: top; padding-top: 14px;\\\\\\\">৳০.০০</td>\\\\n                  </tr>\\\\n                  <tr class=\\\\\\\"total-row\\\\\\\">\\\\n                    <td>সর্বমোট</td>\\\\n                    <td class=\\\\\\\"text-right\\\\\\\" id=\\\\\\\"review-grand-total\\\\\\\">৳২,১০০.০০</td>\\\\n                  </tr>\\\\n                </tbody>\\\\n              </table>\\\\n\\\\n              <!-- Cash On Delivery Notice -->\\\\n              <div class=\\\\\\\"payment-badge-box\\\\\\\">\\\\n                <b>ক্যাশ অন ডেলিভারি (Cash on delivery)</b><br>\\\\n                পণ্য হাতে পেয়ে চেক করে সম্পূর্ণ মূল্য পরিশোধ করুন। অগ্রিম কোনো টাকা দিতে হবে না।\\\\n              </div>\\\\n\\\\n              <!-- Google and Gemini Privacy Standards Compliance Notice -->\\\\n              <div class=\\\\\\\"privacy-standard-badge\\\\\\\">\\\\n                <span class=\\\\\\\"privacy-icon\\\\\\\">🛡️</span>\\\\n                <div class=\\\\\\\"privacy-text\\\\\\\">\\\\n                  <b>Google & Gemini Data Privacy Standard</b>\\\\n                  আপনার তথ্য শতভাগ নিরাপদ ও এনক্রিপ্টেড। আপনার ফোন নম্বর ও ঠিকানা শুধুমাত্র কুরিয়ার ডেলিভারির কাজে সুরক্ষিতভাবে ব্যবহৃত হবে, কোনো তৃতীয় পক্ষের সাথে শেয়ার করা হয় না।\\\\n                </div>\\\\n              </div>\\\\n\\\\n              <!-- Big Red Order Button -->\\\\n              <button type=\\\\\\\"button\\\\\\\" class=\\\\\\\"btn-submit-order\\\\\\\" id=\\\\\\\"btn-submit-order\\\\\\\">\\\\n                <span id=\\\\\\\"btn-order-text\\\\\\\">অর্ডার করুন ৳ ২,১০০.০০</span>\\\\n                <span class=\\\\\\\"spinner-icon\\\\\\\" id=\\\\\\\"order-spinner\\\\\\\"></span>\\\\n              </button>\\\\n            </div>\\\\n          </div>\\\\n        </div>\\\\n      </div>\\\\n    </section>\\\\n  </main>\\\\n\\\\n  <!-- ==========================================================================\\\\n       8. SITE FOOTER\\\\n       ========================================================================== -->\\\\n  <footer class=\\\\\\\"site-footer\\\\\\\">\\\\n    <div class=\\\\\\\"container footer-inner\\\\\\\">\\\\n      <div>\\\\n        © 2026 <b>Growth Agro (Chicken Booster)</b>. All rights reserved.\\\\n      </div>\\\\n      <div>\\\\n        <a href=\\\\\\\"tel:01864444411\\\\\\\" style=\\\\\\\"color:var(--brand-teal); font-weight:700;\\\\\\\">📞 হেল্পলাইন: 01864-444411</a>\\\\n      </div>\\\\n    </div>\\\\n  </footer>\\\\n\\\\n  <!-- Floating WhatsApp Hotline Button -->\\\\n  <a href=\\\\\\\"https://wa.me/8801864444411\\\\\\\" target=\\\\\\\"_blank\\\\\\\" class=\\\\\\\"floating-helpline\\\\\\\" title=\\\\\\\"WhatsApp এ যোগাযোগ করুন\\\\\\\" rel=\\\\\\\"noopener noreferrer\\\\\\\">\\\\n    💬\\\\n  </a>\\\\n\\\\n  <!-- ==========================================================================\\\\n       9. SUCCESS MODAL\\\\n       ========================================================================== -->\\\\n  <div class=\\\\\\\"order-modal-backdrop\\\\\\\" id=\\\\\\\"success-modal\\\\\\\" role=\\\\\\\"dialog\\\\\\\" aria-modal=\\\\\\\"true\\\\\\\">\\\\n    <div class=\\\\\\\"order-modal-card\\\\\\\">\\\\n      <div class=\\\\\\\"success-checkmark\\\\\\\">✓</div>\\\\n      <h3 style=\\\\\\\"font-size: 22px; font-weight: 800; color: #0f172a; margin-bottom: 6px;\\\\\\\">আপনার অর্ডারটি সফল হয়েছে!</h3>\\\\n      <p style=\\\\\\\"font-size: 14.5px; color: #475569; margin-bottom: 20px;\\\\\\\">অর্ডারটি নিশ্চিত করতে আমাদের প্রতিনিধি শীঘ্রই আপনার সাথে ফোনে যোগাযোগ করবেন।</p>\\\\n\\\\n      <div style=\\\\\\\"background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 14px; text-align: left; font-size: 13.5px; margin-bottom: 20px;\\\\\\\">\\\\n        <div style=\\\\\\\"display: flex; justify-content: space-between; padding: 4px 0;\\\\\\\">\\\\n          <span>অর্ডার নাম্বার:</span>\\\\n          <b id=\\\\\\\"modal-order-number\\\\\\\" style=\\\\\\\"color:var(--brand-teal);\\\\\\\">CB-2026-XXXX</b>\\\\n        </div>\\\\n        <div style=\\\\\\\"display: flex; justify-content: space-between; padding: 4px 0;\\\\\\\">\\\\n          <span>পণ্য:</span>\\\\n          <span id=\\\\\\\"modal-product-name\\\\\\\">-</span>\\\\n        </div>\\\\n        <div style=\\\\\\\"display: flex; justify-content: space-between; padding: 4px 0;\\\\\\\">\\\\n          <span>সর্বমোট বিল:</span>\\\\n          <b id=\\\\\\\"modal-total-amount\\\\\\\" style=\\\\\\\"color:var(--btn-red);\\\\\\\">-</b>\\\\n        </div>\\\\n      </div>\\\\n\\\\n      <button type=\\\\\\\"button\\\\\\\" class=\\\\\\\"btn-red-cta\\\\\\\" style=\\\\\\\"width: 100%; font-size: 16px; padding: 12px;\\\\\\\" onclick=\\\\\\\"document.getElementById('success-modal').classList.remove('active')\\\\\\\">\\\\n        ঠিক আছে, ধন্যবাদ\\\\n      </button>\\\\n    </div>\\\\n  </div>\\\\n\\\\n  <!-- ==========================================================================\\\\n       10. CLIENT-SIDE EVENT DISPATCHER & PRIVACY-COMPLIANT ORDER ENGINE\\\\n       ========================================================================== -->\\\\n  <script>\\\\n  (function() {\\\\n    \\\\\\\"use strict\\\\\\\";\\\\n\\\\n    // Products catalog\\\\n    const CATALOG = {\\\\n      \\\\\\\"broiler-1kg\\\\\\\": {\\\\n        productId: \\\\\\\"chicken-booster\\\\\\\",\\\\n        variantId: \\\\\\\"broiler-1kg\\\\\\\",\\\\n        name: \\\\\\\"Broiler Booster (১ কেজি)\\\\\\\",\\\\n        price: 1150,\\\\n        freeDelivery: false\\\\n      },\\\\n      \\\\\\\"layer-1kg\\\\\\\": {\\\\n        productId: \\\\\\\"chicken-booster\\\\\\\",\\\\n        variantId: \\\\\\\"layer-1kg\\\\\\\",\\\\n        name: \\\\\\\"Layer Booster (১ কেজি)\\\\\\\",\\\\n        price: 1150,\\\\n        freeDelivery: false\\\\n      },\\\\n      \\\\\\\"combo-2kg\\\\\\\": {\\\\n        productId: \\\\\\\"chicken-booster\\\\\\\",\\\\n        variantId: \\\\\\\"combo-2kg\\\\\\\",\\\\n        name: \\\\\\\"সুপার কম্বো অফার (Broiler 1KG + Layer 1KG)\\\\\\\",\\\\n        price: 2100,\\\\n        freeDelivery: true\\\\n      }\\\\n    };\\\\n\\\\n    // State\\\\n    let currentVariantKey = \\\\\\\"combo-2kg\\\\\\\";\\\\n    let currentDeliveryZone = \\\\\\\"outside\\\\\\\";\\\\n\\\\n    // UI references\\\\n    const optionCards = document.querySelectorAll('.product-option-card');\\\\n    const deliveryRadios = document.querySelectorAll('input[name=\\\\\\\"delivery-zone\\\\\\\"]');\\\\n    const reviewProductName = document.getElementById('review-product-name');\\\\n    const reviewSubtotal = document.getElementById('review-subtotal');\\\\n    const reviewSubtotalRow = document.getElementById('review-subtotal-row');\\\\n    const reviewDeliveryCharge = document.getElementById('review-delivery-charge');\\\\n    const reviewGrandTotal = document.getElementById('review-grand-total');\\\\n    const btnOrderText = document.getElementById('btn-order-text');\\\\n    const btnSubmit = document.getElementById('btn-submit-order');\\\\n    const orderSpinner = document.getElementById('order-spinner');\\\\n\\\\n    const form = document.getElementById('order-form');\\\\n    const nameInput = document.getElementById('customer-name');\\\\n    const addressInput = document.getElementById('customer-address');\\\\n    const phoneInput = document.getElementById('customer-phone');\\\\n\\\\n    const successModal = document.getElementById('success-modal');\\\\n    const modalOrderNumber = document.getElementById('modal-order-number');\\\\n    const modalProductName = document.getElementById('modal-product-name');\\\\n    const modalTotalAmount = document.getElementById('modal-total-amount');\\\\n\\\\n    // Google & Gemini Privacy Standard Event Dispatcher (Vendor-Neutral, Zero PII)\\\\n    function emitDataLayerEvent(name, data) {\\\\n      window.dataLayer = window.dataLayer || [];\\\\n      const eventObj = {\\\\n        event: name,\\\\n        event_id: (data && data.event_id) ? data.event_id : ('evt_' + Date.now().toString(36) + '_' + Math.random().toString(36).substring(2, 8)),\\\\n        event_time: new Date().toISOString(),\\\\n        page: {\\\\n          url: window.location.href,\\\\n          title: document.title\\\\n        },\\\\n        ...data\\\\n      };\\\\n      window.dataLayer.push(eventObj);\\\\n      return eventObj;\\\\n    }\\\\n\\\\n    // TrackingBus Engine (Vendor-Neutral, Strict Privacy Standards)\\\\n    const TrackingBus = {\\\\n      isDebug: false,\\\\n      hasViewedContent: false,\\\\n      hasInitiatedCheckout: false,\\\\n      completedPurchases: new Set(),\\\\n\\\\n      enableDebug: function(enabled) { this.isDebug = Boolean(enabled); },\\\\n      emit: function(eventName, payload) { return emitDataLayerEvent(eventName, payload); },\\\\n      trackPageView: function() { return this.emit(\\\\\\\"page_view\\\\\\\"); },\\\\n      trackViewContent: function(variant) {\\\\n        if (this.hasViewedContent) return null;\\\\n        this.hasViewedContent = true;\\\\n        return this.emit(\\\\\\\"view_content\\\\\\\", {\\\\n          ecommerce: {\\\\n            currency: 'BDT',\\\\n            value: (variant && variant.price) ? variant.price : 2100,\\\\n            items: [{ item_id: 'CB-AGRO-01', item_name: 'Chicken Booster', price: (variant && variant.price) ? variant.price : 2100, quantity: 1 }]\\\\n          }\\\\n        });\\\\n      },\\\\n      trackCtaClick: function(ctaName, targetSection) {\\\\n        return this.emit(\\\\\\\"cta_click\\\\\\\", { cta_name: ctaName || \\\\\\\"Order CTA\\\\\\\", target_section: targetSection || \\\\\\\"#checkout-form-section\\\\\\\" });\\\\n      },\\\\n      trackSelectItem: function(variant) {\\\\n        return this.emit(\\\\\\\"select_item\\\\\\\", {\\\\n          ecommerce: {\\\\n            currency: 'BDT',\\\\n            value: (variant && variant.price) ? variant.price : 2100,\\\\n            items: [{ item_id: 'CB-AGRO-01', item_name: (variant && variant.name) ? variant.name : 'Chicken Booster', price: (variant && variant.price) ? variant.price : 2100, quantity: 1 }]\\\\n          }\\\\n        });\\\\n      },\\\\n      trackInitiateCheckout: function(variant, totalAmount) {\\\\n        if (this.hasInitiatedCheckout) return null;\\\\n        this.hasInitiatedCheckout = true;\\\\n        return this.emit(\\\\\\\"initiate_checkout\\\\\\\", {\\\\n          ecommerce: {\\\\n            currency: 'BDT',\\\\n            value: totalAmount || 2100,\\\\n            items: [{ item_id: 'CB-AGRO-01', item_name: 'Chicken Booster', price: totalAmount || 2100, quantity: 1 }]\\\\n          }\\\\n        });\\\\n      },\\\\n      trackPurchase: function(order) {\\\\n        if (!order || !order.order_number) return null;\\\\n        if (this.completedPurchases.has(order.order_number)) return null;\\\\n        this.completedPurchases.add(order.order_number);\\\\n\\\\n        const eventId = 'evt_pur_' + order.order_number.replace(/[^A-Za-z0-9]/g, '_');\\\\n        return this.emit(\\\\\\\"purchase\\\\\\\", {\\\\n          event_id: eventId,\\\\n          transaction_id: order.order_number,\\\\n          order_number: order.order_number,\\\\n          ecommerce: {\\\\n            transaction_id: order.order_number,\\\\n            value: order.total || 2100,\\\\n            currency: order.currency || 'BDT',\\\\n            shipping: order.delivery_charge || 0,\\\\n            items: [{\\\\n              item_id: 'CB-AGRO-01',\\\\n              item_name: order.product || 'Chicken Booster',\\\\n              price: order.subtotal || order.total || 2100,\\\\n              quantity: order.quantity || 1\\\\n            }]\\\\n          }\\\\n        });\\\\n      }\\\\n    };\\\\n    window.trackingEvents = TrackingBus;\\\\n\\\\n    // Initial View Events\\\\n    TrackingBus.trackPageView();\\\\n    TrackingBus.trackViewContent({ price: 2100 });\\\\n\\\\n    // Update Live Calculation\\\\n    function recalculate() {\\\\n      const selected = CATALOG[currentVariantKey] || CATALOG[\\\\\\\"combo-2kg\\\\\\\"];\\\\n      let deliveryCost = 0;\\\\n\\\\n      if (!selected.freeDelivery) {\\\\n        deliveryCost = currentDeliveryZone === 'inside' ? 60 : 120;\\\\n      }\\\\n\\\\n      const total = selected.price + deliveryCost;\\\\n\\\\n      // Update Order Review\\\\n      reviewProductName.textContent = selected.name + \\\\\\\" × 1\\\\\\\";\\\\n      reviewSubtotal.textContent = \\\\\\\"৳\\\\\\\" + selected.price.toLocaleString('en-US') + \\\\\\\".00\\\\\\\";\\\\n      reviewSubtotalRow.textContent = \\\\\\\"৳\\\\\\\" + selected.price.toLocaleString('en-US') + \\\\\\\".00\\\\\\\";\\\\n\\\\n      if (deliveryCost === 0) {\\\\n        reviewDeliveryCharge.textContent = \\\\\\\"ফ্রি ডেলিভারি\\\\\\\";\\\\n        reviewDeliveryCharge.style.color = \\\\\\\"#16a34a\\\\\\\";\\\\n      } else {\\\\n        reviewDeliveryCharge.textContent = \\\\\\\"৳\\\\\\\" + deliveryCost + \\\\\\\".00\\\\\\\";\\\\n        reviewDeliveryCharge.style.color = \\\\\\\"inherit\\\\\\\";\\\\n      }\\\\n\\\\n      reviewGrandTotal.textContent = \\\\\\\"৳\\\\\\\" + total.toLocaleString('en-US') + \\\\\\\".00\\\\\\\";\\\\n      btnOrderText.textContent = \\\\\\\"অর্ডার করুন ৳ \\\\\\\" + total.toLocaleString('en-US') + \\\\\\\".00\\\\\\\";\\\\n    }\\\\n\\\\n    // Switch Product Variant\\\\n    optionCards.forEach(card => {\\\\n      card.addEventListener('click', function() {\\\\n        optionCards.forEach(c => c.classList.remove('selected'));\\\\n        this.classList.add('selected');\\\\n        const radio = this.querySelector('input[type=\\\\\\\"radio\\\\\\\"]');\\\\n        if (radio) radio.checked = true;\\\\n\\\\n        currentVariantKey = this.getAttribute('data-variant');\\\\n        recalculate();\\\\n\\\\n        // Dispatch select_item without PII\\\\n        const sel = CATALOG[currentVariantKey];\\\\n        emitDataLayerEvent('select_item', {\\\\n          ecommerce: {\\\\n            currency: 'BDT',\\\\n            value: sel.price,\\\\n            items: [{\\\\n              item_id: sel.productId,\\\\n              item_variant: sel.variantId,\\\\n              item_name: sel.name,\\\\n              price: sel.price,\\\\n              quantity: 1\\\\n            }]\\\\n          }\\\\n        });\\\\n      });\\\\n    });\\\\n\\\\n    // Delivery Radio Change\\\\n    deliveryRadios.forEach(radio => {\\\\n      radio.addEventListener('change', function() {\\\\n        currentDeliveryZone = this.value;\\\\n        recalculate();\\\\n      });\\\\n    });\\\\n\\\\n    // Validation helpers (strict BD phone & XSS protection)\\\\n    function sanitize(str) {\\\\n      return String(str || '').replace(/[<>]/g, '').trim();\\\\n    }\\\\n\\\\n    function validatePhone(phone) {\\\\n      const cleaned = phone.replace(/[^0-9]/g, '');\\\\n      return /^01[3-9]\\\\\\\\d{8}$/.test(cleaned);\\\\n    }\\\\n\\\\n    function validateForm() {\\\\n      let valid = true;\\\\n\\\\n      const name = sanitize(nameInput.value);\\\\n      const nameGroup = document.getElementById('group-customer-name');\\\\n      if (!name || name.length < 2) {\\\\n        nameGroup.classList.add('has-error');\\\\n        valid = false;\\\\n      } else {\\\\n        nameGroup.classList.remove('has-error');\\\\n      }\\\\n\\\\n      const addr = sanitize(addressInput.value);\\\\n      const addrGroup = document.getElementById('group-customer-address');\\\\n      if (!addr || addr.length < 5) {\\\\n        addrGroup.classList.add('has-error');\\\\n        valid = false;\\\\n      } else {\\\\n        addrGroup.classList.remove('has-error');\\\\n      }\\\\n\\\\n      const phone = phoneInput.value.trim();\\\\n      const phoneGroup = document.getElementById('group-customer-phone');\\\\n      if (!validatePhone(phone)) {\\\\n        phoneGroup.classList.add('has-error');\\\\n        valid = false;\\\\n      } else {\\\\n        phoneGroup.classList.remove('has-error');\\\\n      }\\\\n\\\\n      return valid;\\\\n    }\\\\n\\\\n    // Submit Order\\\\n    btnSubmit.addEventListener('click', async function() {\\\\n      if (!validateForm()) {\\\\n        const firstErr = document.querySelector('.has-error input, .has-error textarea');\\\\n        if (firstErr) firstErr.focus();\\\\n        return;\\\\n      }\\\\n\\\\n      const selected = CATALOG[currentVariantKey] || CATALOG[\\\\\\\"combo-2kg\\\\\\\"];\\\\n      const customerName = sanitize(nameInput.value);\\\\n      const customerPhone = phoneInput.value.trim().replace(/[^0-9]/g, '');\\\\n      const customerAddress = sanitize(addressInput.value);\\\\n\\\\n      // Loading state\\\\n      btnSubmit.disabled = true;\\\\n      orderSpinner.style.display = 'inline-block';\\\\n      btnOrderText.textContent = \\\\\\\"অর্ডার প্রসেস হচ্ছে...\\\\\\\";\\\\n\\\\n      // Authoritative payload\\\\n      const orderPayload = {\\\\n        productId: selected.productId,\\\\n        product_id: selected.productId,\\\\n        variantId: selected.variantId,\\\\n        variant_id: selected.variantId,\\\\n        quantity: 1,\\\\n        deliveryZone: currentDeliveryZone,\\\\n        delivery_zone: currentDeliveryZone,\\\\n        customerName: customerName,\\\\n        customer_name: customerName,\\\\n        name: customerName,\\\\n        phone: customerPhone,\\\\n        customer_phone: customerPhone,\\\\n        address: customerAddress,\\\\n        shipping_address: customerAddress,\\\\n        customer: {\\\\n          name: customerName,\\\\n          phone: customerPhone,\\\\n          address: customerAddress,\\\\n          delivery_zone: currentDeliveryZone\\\\n        },\\\\n        paymentMethod: \\\\\\\"Cash on Delivery\\\\\\\",\\\\n        notes: \\\\\\\"Growth Agro Cloned Landing Page\\\\\\\"\\\\n      };\\\\n\\\\n      try {\\\\n        const res = await fetch('/api/orders', {\\\\n          method: 'POST',\\\\n          headers: { 'Content-Type': 'application/json' },\\\\n          body: JSON.stringify(orderPayload)\\\\n        });\\\\n\\\\n        const data = await res.json();\\\\n\\\\n        if (res.ok && data.success) {\\\\n          const order = data.order || {};\\\\n          const orderNo = order.order_number || data.order_number || ('CB-' + Date.now().toString().slice(-6));\\\\n          const totalVal = order.total || (selected.price + (selected.freeDelivery ? 0 : (currentDeliveryZone === 'inside' ? 60 : 120)));\\\\n\\\\n          // Google & Gemini Privacy Compliant Purchase Event (Strictly No Customer PII)\\\\n          TrackingBus.trackPurchase(order);\\\\n\\\\n          // Show Success Modal\\\\n          modalOrderNumber.textContent = orderNo;\\\\n          modalProductName.textContent = selected.name;\\\\n          modalTotalAmount.textContent = \\\\\\\"৳\\\\\\\" + totalVal.toLocaleString('en-US') + \\\\\\\" (ক্যাশ অন ডেলিভারি)\\\\\\\";\\\\n          successModal.classList.add('active');\\\\n\\\\n          // Reset Form\\\\n          form.reset();\\\\n          currentVariantKey = \\\\\\\"combo-2kg\\\\\\\";\\\\n          optionCards.forEach(c => c.classList.remove('selected'));\\\\n          const comboCard = document.querySelector('[data-variant=\\\\\\\"combo-2kg\\\\\\\"]');\\\\n          if (comboCard) {\\\\n            comboCard.classList.add('selected');\\\\n            comboCard.querySelector('input').checked = true;\\\\n          }\\\\n          recalculate();\\\\n        } else {\\\\n          alert('অর্ডার সম্পন্ন করা যায়নি: ' + (data.error || 'অনুগ্রহ করে আবার চেষ্টা করুন।'));\\\\n        }\\\\n      } catch (err) {\\\\n        console.error('[Order Error]', err);\\\\n        alert('সার্ভারের সাথে সংযোগ স্থাপন করা সম্ভব হয়নি। অনুগ্রহ করে একটু পর চেষ্টা করুন।');\\\\n      } finally {\\\\n        btnSubmit.disabled = false;\\\\n        orderSpinner.style.display = 'none';\\\\n        recalculate();\\\\n      }\\\\n    });\\\\n\\\\n    // Select and scroll helper for interactive hero cards\\\\n    window.selectAndScroll = function(variantKey) {\\\\n      const card = document.querySelector('.product-option-card[data-variant=\\\\\\\"' + variantKey + '\\\\\\\"]');\\\\n      if (card) card.click();\\\\n      const checkout = document.getElementById('checkout-form-section');\\\\n      if (checkout) checkout.scrollIntoView({ behavior: 'smooth' });\\\\n    };\\\\n\\\\n    // Initial calculation\\\\n    recalculate();\\\\n  })();\\\\n  </script>\\\\n</body>\\\\n</html>\\\\n\\\"},\\\"elements\\\":[],\\\"widgetType\\\":\\\"html\\\"}],\\\"isInner\\\":false}],\\\"isInner\\\":false}]\"]}}]}]"