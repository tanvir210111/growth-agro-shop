in-top:6px; color:var(--ink);}\\r\\n.section-head.light h2{color:var(--cream);}\\r\\n\\r\\n/* --- swatches --- */\\r\\n.swatches{\\r\\n  display:flex; gap:12px; overflow-x:auto; padding-bottom:8px;\\r\\n  scrollbar-width:none;\\r\\n}\\r\\n.swatches::-webkit-scrollbar{display:none;}\\r\\n.swatch-card{\\r\\n  flex:0 0 122px;\\r\\n  background:var(--paper);\\r\\n  padding:10px;\\r\\n  border:1px solid var(--line);\\r\\n  border-radius:3px;\\r\\n  transition:transform .18s ease, box-shadow .18s ease;\\r\\n}\\r\\n.swatch-card:active{transform:translateY(-2px); box-shadow:0 10px 20px -8px #16241C33;}\\r\\n.swatch-img{\\r\\n  aspect-ratio:1/1; margin-bottom:10px; border-radius:2px;\\r\\n  position:relative; overflow:hidden;\\r\\n}\\r\\n.swatch-img::after{\\r\\n  content:&quot;&quot;;\\r\\n  position:absolute; inset:0;\\r\\n  background:repeating-linear-gradient(115deg, #ffffff14 0 2px, transparent 2px 10px);\\r\\n}\\r\\n.swatch-navy{background:#22344A;}\\r\\n.swatch-olive{background:#5C6B4F;}\\r\\n.swatch-maroon{background:#6E2B2B;}\\r\\n.swatch-charcoal{background:#26282A;}\\r\\n.swatch-card h4{font-size:13.5px; margin-bottom:2px; color:var(--ink);}\\r\\n.swatch-card .p{font-size:12.5px; color:var(--gold); font-weight:700;}\\r\\n\\r\\n/* --- dark band: why us --- */\\r\\n.dark-band{background:var(--forest);}\\r\\n.why-list{display:flex; flex-direction:column;}\\r\\n.why-item{\\r\\n  display:flex; align-items:flex-start; gap:18px;\\r\\n  padding:18px 0;\\r\\n  border-bottom:1px solid #F6F1E41a;\\r\\n}\\r\\n.why-item:last-child{border-bottom:none;}\\r\\n.num{\\r\\n  flex:0 0 auto;\\r\\n  font-family:&#039;Tiro Bangla&#039;;\\r\\n  font-size:28px;\\r\\n  color:transparent;\\r\\n  -webkit-text-stroke:1px var(--gold-soft);\\r\\n  min-width:44px;\\r\\n}\\r\\n.why-item h4{font-size:15px; margin-bottom:4px; color:var(--cream);}\\r\\n.why-item p{font-size:13px; color:#AEBAAB; line-height:1.6;}\\r\\n\\r\\n/* --- size chart --- */\\r\\n.size-table{\\r\\n  width:100%; border-collapse:collapse;\\r\\n  font-size:13px;\\r\\n  background:#fff;\\r\\n  border-radius:3px;\\r\\n  overflow:hidden;\\r\\n  box-shadow:0 1px 0 var(--line);\\r\\n}\\r\\n.size-table th{\\r\\n  background:var(--forest); color:var(--gold-soft);\\r\\n  padding:11px 6px; font-weight:600; font-size:12.5px;\\r\\n  letter-spacing:.3px;\\r\\n}\\r\\n.size-table td{\\r\\n  padding:12px 6px; text-align:center;\\r\\n  border-top:1px solid var(--line);\\r\\n}\\r\\n.size-table tr:nth-child(even) td{background:var(--cream);}\\r\\n\\r\\n/* --- reviews --- */\\r\\n.review-card{\\r\\n  position:relative;\\r\\n  background:var(--paper);\\r\\n  padding:20px 18px 16px;\\r\\n  margin-bottom:12px;\\r\\n  border:1px solid var(--line);\\r\\n  border-radius:3px;\\r\\n}\\r\\n.quote-mark{\\r\\n  position:absolute; top:6px; right:14px;\\r\\n  font-family:&#039;Tiro Bangla&#039;; font-size:44px; color:var(--gold);\\r\\n  opacity:.28; line-height:1;\\r\\n}\\r\\n.review-card .stars{color:var(--gold); font-size:13px; margin-bottom:8px;}\\r\\n.review-card p{font-size:13.5px; line-height:1.55; color:var(--ink); margin-bottom:8px; position:relative;}\\r\\n.review-card .who{font-size:12px; color:var(--muted); font-weight:600;}\\r\\n\\r\\n/* --- order box --- */\\r\\n.order-box{\\r\\n  position:relative;\\r\\n  background:linear-gradient(160deg,var(--forest),#0A150F);\\r\\n  padding:32px 24px;\\r\\n  color:var(--cream);\\r\\n}\\r\\n.order-box .corner{position:absolute; width:22px; height:22px; border:1px solid var(--gold);}\\r\\n.order-box .corner.tl{top:10px; left:10px; border-right:none; border-bottom:none;}\\r\\n.order-box .corner.tr{top:10px; right:10px; border-left:none; border-bottom:none;}\\r\\n.order-box .corner.bl{bottom:10px; left:10px; border-right:none; border-top:none;}\\r\\n.order-box .corner.br{bottom:10px; right:10px; border-left:none; border-top:none;}\\r\\n.order-box h2{font-size:23px; margin-bottom:8px; color:var(--cream);}\\r\\n.order-box p{font-size:13px; color:#B9C2B6; margin-bottom:18px;}\\r\\n.order-box .price-line{\\r\\n  display:flex; align-items:baseline; gap:10px; margin-bottom:18px;\\r\\n}\\r\\n.order-box .price-line .now{\\r\\n  font-family:&#039;Tiro Bangla&#039;; font-size:30px; color:var(--gold-soft);\\r\\n}\\r\\n.order-box .price-line .old{\\r\\n  font-size:15px; text-decoration:line-through; color:#7C8C79;\\r\\n}\\r\\n.final-cta{\\r\\n  display:flex; align-items:center; justify-content:center; gap:10px;\\r\\n  background:var(--gold);\\r\\n  color:var(--forest);\\r\\n  font-family:&#039;Hind Siliguri&#039;; font-weight:700; font-size:16px;\\r\\n  padding:16px;\\r\\n  border-radius:2px;\\r\\n  text-decoration:none;\\r\\n  box-shadow:0 10px 24px -8px #C9A24B77;\\r\\n}\\r\\n.pay-note{\\r\\n  text-align:center; font-size:11.5px; color:#8B9A88; margin-top:12px;\\r\\n}\\r\\n\\r\\n#order{padding-bottom:96px;}\\r\\n\\r\\n/* --- sticky mobile bar --- */\\r\\n.sticky-bar{\\r\\n  position:sticky; bottom:0; left:0; right:0;\\r\\n  max-width:480px; margin:0 auto;\\r\\n  background:#ffffffee;\\r\\n  backdrop-filter:blur(8px);\\r\\n  border-top:1px solid var(--line);\\r\\n  padding:10px 16px;\\r\\n  display:flex; align-items:center; gap:12px;\\r\\n  box-shadow:0 -6px 20px rgba(0,0,0,.1);\\r\\n}\\r\\n.sticky-bar .info{flex:1;}\\r\\n.sticky-bar .info .p{\\r\\n  font-family:&#039;Tiro Bangla&#039;; font-size:18px; color:var(--ink);\\r\\n}\\r\\n.sticky-bar .info .s{font-size:10.5px; color:var(--muted);}\\r\\n.sticky-bar a{\\r\\n  background:var(--forest); color:var(--gold-soft); text-decoration:none;\\r\\n  font-family:&#039;Hind Siliguri&#039;; font-weight:700; font-size:14px;\\r\\n  padding:11px 22px; border-radius:2px;\\r\\n}\\r\\n\\r\\n/* ============ TABLET / DESKTOP ============ */\\r\\n@media (min-width:900px){\\r\\n  .wrap{max-width:100%;}\\r\\n\\r\\n  header{padding:18px 48px;}\\r\\n  header .brand{font-size:22px;}\\r\\n  header .badge{font-size:11.5px; padding:6px 14px;}\\r\\n  .head-cta{display:block;}\\r\\n\\r\\n  .hero{\\r\\n    padding:0;\\r\\n  