n{color:var(--gold-soft);}\\r\\nheader .badge{\\r\\n  font-size:10.5px;\\r\\n  letter-spacing:.8px;\\r\\n  border:1px solid var(--gold);\\r\\n  color:var(--gold-soft);\\r\\n  padding:5px 10px;\\r\\n  border-radius:2px;\\r\\n  font-weight:600;\\r\\n  text-transform:uppercase;\\r\\n}\\r\\nheader .head-right{display:flex; align-items:center; gap:14px;}\\r\\n.head-cta{\\r\\n  display:none;\\r\\n  background:var(--gold); color:var(--forest); text-decoration:none;\\r\\n  font-family:&#039;Hind Siliguri&#039;; font-weight:700; font-size:13.5px;\\r\\n  padding:9px 18px; border-radius:2px;\\r\\n}\\r\\n\\r\\n/* --- hero --- */\\r\\n.hero{\\r\\n  position:relative;\\r\\n  padding:34px 20px 26px;\\r\\n  overflow:hidden;\\r\\n}\\r\\n.hero-bg{\\r\\n  position:absolute; inset:0 0 38% 0;\\r\\n  background:\\r\\n    radial-gradient(circle at 100% 0%, #2a4a34 0%, transparent 55%),\\r\\n    linear-gradient(180deg, var(--forest) 0%, var(--forest-2) 100%);\\r\\n  z-index:0;\\r\\n}\\r\\n.hero-content{position:relative; z-index:1;}\\r\\n.hero .eyebrow{\\r\\n  display:inline-block;\\r\\n  font-size:12px; font-weight:600; color:var(--gold-soft);\\r\\n  letter-spacing:1.5px;\\r\\n  margin-bottom:14px;\\r\\n}\\r\\n.hero h1{\\r\\n  font-size:36px;\\r\\n  color:var(--cream);\\r\\n  margin-bottom:12px;\\r\\n}\\r\\n.hero h1 em{\\r\\n  font-style:italic;\\r\\n  color:var(--gold-soft);\\r\\n}\\r\\n.hero p.sub{\\r\\n  font-size:15px;\\r\\n  color:#C6CFC5;\\r\\n  line-height:1.65;\\r\\n  max-width:36ch;\\r\\n  margin-bottom:20px;\\r\\n}\\r\\n.hero-cta{\\r\\n  display:inline-flex; align-items:center; gap:10px;\\r\\n  background:var(--gold);\\r\\n  color:var(--forest);\\r\\n  font-family:&#039;Hind Siliguri&#039;; font-weight:700; font-size:16px;\\r\\n  padding:15px 22px;\\r\\n  border-radius:2px;\\r\\n  text-decoration:none;\\r\\n  letter-spacing:.3px;\\r\\n  width:100%;\\r\\n  justify-content:center;\\r\\n  transition:transform .15s ease, box-shadow .15s ease;\\r\\n  box-shadow:0 8px 22px -6px #C9A24