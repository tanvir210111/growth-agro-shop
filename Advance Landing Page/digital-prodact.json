9be\\\\u099f \\\\u0995\\\\u09b0\\\\u09c1\\\\u09a8\\\\\\\">\\\\ud83d\\\\udcac<\\\\/a>\\\\r\\\\n  <a href=\\\\\\\"#\\\\\\\" class=\\\\\\\"fab fab-msg\\\\\\\" aria-label=\\\\\\\"\\\\u09ae\\\\u09c7\\\\u09b8\\\\u09c7\\\\u099e\\\\u09cd\\\\u099c\\\\u09be\\\\u09b0\\\\u09c7 \\\\u099a\\\\u09cd\\\\u09af\\\\u09be\\\\u099f \\\\u0995\\\\u09b0\\\\u09c1\\\\u09a8\\\\\\\">\\\\u2709\\\\ufe0f<\\\\/a>\\\\r\\\\n  <button class=\\\\\\\"fab fab-top\\\\\\\" id=\\\\\\\"backTop\\\\\\\" aria-label=\\\\\\\"\\\\u0989\\\\u09aa\\\\u09b0\\\\u09c7 \\\\u09ab\\\\u09bf\\\\u09b0\\\\u09c7 \\\\u09af\\\\u09be\\\\u09a8\\\\\\\">\\\\u2191<\\\\/button>\\\\r\\\\n<\\\\/div>\\\\r\\\\n\\\\r\\\\n<!-- Mobile sticky CTA -->\\\\r\\\\n<div class=\\\\\\\"sticky-cta\\\\\\\" id=\\\\\\\"stickyCta\\\\\\\">\\\\r\\\\n  <div class=\\\\\\\"sc-price\\\\\\\"><b>\\\\u09f3\\\\u09e7,\\\\u09ea\\\\u09ef\\\\u09e6<\\\\/b><s>\\\\u09f3\\\\u09ea,\\\\u09ef\\\\u09ef\\\\u09e6<\\\\/s><\\\\/div>\\\\r\\\\n  <a href=\\\\\\\"#buy\\\\\\\" class=\\\\\\\"btn btn-primary\\\\\\\">\\\\u098f\\\\u0996\\\\u09a8\\\\u0987 \\\\u0995\\\\u09bf\\\\u09a8\\\\u09c1\\\\u09a8<\\\\/a>\\\\r\\\\n<\\\\/div>\\\\r\\\\n\\\\r\\\\n<script>\\\\r\\\\n(function(){\\\\r\\\\n  \\\\\\\"use strict\\\\\\\";\\\\r\\\\n\\\\r\\\\n  var bnDigits = ['\\\\u09e6','\\\\u09e7','\\\\u09e8','\\\\u09e9','\\\\u09ea','\\\\u09eb','\\\\u09ec','\\\\u09ed','\\\\u09ee','\\\\u09ef'];\\\\r\\\\n  function toBn(n){\\\\r\\\\n    return String(n).split('').map(function(d){ return bnDigits[+d] !== undefined ? bnDigits[+d] : d; }).join('');\\\\r\\\\n  }\\\\r\\\\n  function pad(n){ return n < 10 ? '0'+n : ''+n; }\\\\r\\\\n\\\\r\\\\n  \\\\/* ---------- Countdown timer ---------- *\\\\/\\\\r\\\\n  function startCountdown(prefixIds, seconds){\\\\r\\\\n    var end = Date.now() + seconds*1000;\\\\r\\\\n    function tick(){\\\\r\\\\n      var remain = Math.max(0, end - Date.now());\\\\r\\\\n      var h = Math.floor(remain\\\\/3600000);\\\\r\\\\n      var m = Math.floor((remain%3600000)\\\\/60000);\\\\r\\\\n      var s = Math.floor((remain%60000)\\\\/1000);\\\\r\\\\n      prefixIds.forEach(function(ids){\\\\r\\\\n        var eh=document.getElementById(ids[0]), em=document.getElementById(ids[1]), es=document.getElementById(ids[2]);\\\\r\\\\n        if(eh) eh.textContent = toBn(pad(h));\\\\r\\\\n        if(em) em.textContent = toBn(pad(m));\\\\r\\\\n        if(es) es.textContent = toBn(pad(s));\\\\r\\\\n      });\\\\r\\\\n      if(remain > 0){ requestAnimationFrame(function(){ setTimeout(tick, 250); }); }\\\\r\\\\n    }\\\\r\\\\n    tick();\\\\r\\\\n  }\\\\r\\\\n  startCountdown([['cdH','cdM','cdS'],['cdH2','cdM2','cdS2']], 8*3600 + 42*60 + 15);\\\\r\\\\n\\\\r\\\\n  \\\\/* ---------- Scroll reveal ---------- *\\\\/\\\\r\\\\n  var revealEls = document.querySelectorAll('.reveal');\\\\r\\\\n  if('IntersectionObserver' in window){\\\\r\\\\n    var io = new IntersectionObserver(function(entries){\\\\r\\\\n      entries.forEach(function(entry){\\\\r\\\\n        if(entry.isIntersecting){\\\\r\\\\n          entry.target.classList.add('in-view');\\\\r\\\\n          io.unobserve(entry.target);\\\\r\\\\n        }\\\\r\\\\n      });\\\\r\\\\n    }, {threshold:0.14, rootMargin:'0px 0px -40px 0px'});\\\\r\\\\n    revealEls.forEach(function(el){ io.observe(el); });\\\\r\\\\n  } else {\\\\r\\\\n    revealEls.forEach(function(el){ el.classList.add('in-view'); });\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  \\\\/* ---------- FAQ accordion ---------- *\\\\/\\\\r\\\\n  document.querySelectorAll('.faq-item').forEach(function(item){\\\\r\\\\n    var btn = item.querySelector('.faq-q');\\\\r\\\\n    var panel = item.querySelector('.faq-a');\\\\r\\\\n    btn.addEventListener('click', function(){\\\\r\\\\n      var isOpen = item.classList.contains('open');\\\\r\\\\n      document.querySelectorAll('.faq-item.open').forEach(function(openItem){\\\\r\\\\n        if(openItem !== item){\\\\r\\\\n          openItem.classList.remove('open');\\\\r\\\\n          openItem.querySelector('.faq-q').setAttribute('aria-expanded','false');\\\\r\\\\n          openItem.querySelector('.faq-a').style.maxHeight = null;\\\\r\\\\n        }\\\\r\\\\n      });\\\\r\\\\n      if(isOpen){\\\\r\\\\n        item.classList.remove('open');\\\\r\\\\n        btn.setAttribute('aria-expanded','false');\\\\r\\\\n        panel.style.maxHeight = null;\\\\r\\\\n      } else {\\\\r\\\\n        item.classList.add('open');\\\\r\\\\n        btn.setAttribute('aria-expanded','true');\\\\r\\\\n        panel.style.maxHeight = panel.scrollHeight + 'px';\\\\r\\\\n      }\\\\r\\\\n    });\\\\r\\\\n  });\\\\r\\\\n\\\\r\\\\n  \\\\/* ---------- Sticky elements on scroll ---------- *\\\\/\\\\r\\\\n  var stickyCta = document.getElementById('stickyCta');\\\\r\\\\n  var desktopBar = document.getElementById('desktopBar');\\\\r\\\\n  var fabStack = document.getElementById('fabStack');\\\\r\\\\n  var heroEl = document.querySelector('.hero');\\\\r\\\\n  var heroBottom = 0;\\\\r\\\\n  function measure(){ heroBottom = heroEl.getBoundingClientRect().height + heroEl.offsetTop; }\\\\r\\\\n  measure();\\\\r\\\\n  window.addEventListener('resize', measure);\\\\r\\\\n\\\\r\\\\n  function onScroll(){\\\\r\\\\n    var y = window.scrollY || window.pageYOffset;\\\\r\\\\n    var pastHero = y > heroBottom - 80;\\\\r\\\\n    if(stickyCta) stickyCta.classList.toggle('show', pastHero);\\\\r\\\\n    if(desktopBar) desktopBar.classList.toggle('show', pastHero);\\\\r\\\\n    fabStack.querySelectorAll('.fab').forEach(function(f){ f.classList.toggle('show', y > 240); });\\\\r\\\\n  }\\\\r\\\\n  document.addEventListener('scroll', onScroll, {passive:true});\\\\r\\\\n  onScroll();\\\\r\\\\n\\\\r\\\\n  \\\\/* ---------- Back to top ---------- *\\\\/\\\\r\\\\n  var backTop = document.getElementById('backTop');\\\\r\\\\n  if(backTop){\\\\r\\\\n    backTop.addEventListener('click', function(){\\\\r\\\\n      window.scrollTo({top:0, behavior:'smooth'});\\\\r\\\\n    });\\\\r\\\\n  }\\\\r\\\\n\\\\r\\\\n  \\\\/* ---------- Smooth scroll for in-page links ---------- *\\\\/\\\\r\\\\n  document.querySelectorAll('a[href^=\\\\\\\"#\\\\\\\"]').forEach(function(a){\\\\r\\\\n    a.addEventListener('click', function(e){\\\\r\\\\n      var id = a.getAttribute('href');\\\\r\\\\n      if(id.length > 1){\\\\r\\\\n        var target = document.querySelector(id);\\\\r\\\\n        if(target){\\\\r\\\\n          e.preventDefault();\\\\r\\\\n          var offset = 90;\\\\r\\\\n          var top = target.getBoundingClientRect().top + window.pageYOffset - offset;\\\\r\\\\n          window.scrollTo({top:top, behavior:'smooth'});\\\\r\\\\n        }\\\\r\\\\n      }\\\\r\\\\n    });\\\\r\\\\n  });\\\\r\\\\n})();\\\\r\\\\n<\\\\/script>\\\\r\\\\n<\\\\/body>\\\\r\\\\n<\\\\/html>\\\\t\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t<\\\\/section>\\\\n\\\\t\\\\t\\\\t\\\\t<section class=\\\\\\\"elementor-section elementor-top-section elementor-element elementor-element-be570b3 order elementor-section-boxed elementor-section-height-default elementor-section-height-default\\\\\\\" data-id=\\\\\\\"be570b3\\\\\\\" data-element_type=\\\\\\\"section\\\\\\\" data-e-type=\\\\\\\"section\\\\\\\" id=\\\\\\\"order-form\\\\\\\">\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t<div class=\\\\\\\"elementor-container elementor-column-gap-no\\\\\\\">\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t<div class=\\\\\\\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-4bea656d\\\\\\\" data-id=\\\\\\\"4bea656d\\\\\\\" data-element_type=\\\\\\\"column\\\\\\\" data-e-type=\\\\\\\"column\\\\\\\" data-settings=\\\\\\\"{&quot;background_background&quot;:&quot;classic&quot;}\\\\\\\">\\\\n\\\\t\\\\t\\\\t<div class=\\\\\\\"elementor-widget-wrap elementor-element-populated\\\\\\\">\\\\n\\\\t\\\\t\\\\t\\\\t[elementor-element k=\\\\\\\"92e4ac0eb02027586a495999807932b9\\\\\\\" data=\\\\\\\"eyJpZCI6ImEwM2RlNjIiLCJlbFR5cGUiOiJ3aWRnZXQiLCJzZXR0aW5ncyI6eyJsYXlvdXQiOiJ0d28tY29sdW1uIiwibm90ZV90ZXh0IjoiR2V0IFlvdXIgRlJFRSBjb3B5IG9mIENhcnRGbG93cyBpbiBqdXN0IGZldyBzdGVwcy4iLCJzdGVwX29uZV90aXRsZV90ZXh0IjoiU2hpcHBpbmciLCJzdGVwX29uZV9zdWJfdGl0bGVfdGV4dCI6IldoZXJlIHRvIHNoaXAgaXQ\\\\\\\\\\\"]\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t<\\\\/section>\\\\n\\\\t\\\\t\\\\t\\\\t<section class=\\\\\\\"elementor-section elementor-top-section elementor-element elementor-element-62ac697 elementor-section-boxed elementor-section-height-default elementor-section-height-default\\\\\\\" data-id=\\\\\\\"62ac697\\\\\\\" data-element_type=\\\\\\\"section\\\\\\\" data-e-type=\\\\\\\"section\\\\\\\" data-settings=\\\\\\\"{&quot;background_background&quot;:&quot;classic&quot;}\\\\\\\">\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t<div class=\\\\\\\"elementor-container elementor-column-gap-default\\\\\\\">\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t<div class=\\\\\\\"elementor-column elementor-col-100 elementor-top-column elementor-element elementor-element-1d12cb75\\\\\\\" data-id=\\\\\\\"1d12cb75\\\\\\\" data-element_type=\\\\\\\"column\\\\\\\" data-e-type=\\\\\\\"column\\\\\\\">\\\\n\\\\t\\\\t\\\\t<div class=\\\\\\\"elementor-widget-wrap elementor-element-populated\\\\\\\">\\\\n\\\\t\\\\t\\\\t\\\\t[elementor-element k=\\\\\\\"92e4ac0eb02027586a495999807932b9\\\\\\\" data=\\\\\\\"\\\\\\\"]\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t<\\\\/div>\\\\n\\\\t\\\\t<\\\\/section>\\\\n\\\\t\\\\t\\\",\\\"scripts\\\":[],\\\"styles\\\":[]}}\"]},\"post_content\":\"<!DOCTYPE html>\\n<html lang=\\\"bn\\\">\\n<head>\\n<meta charset=\\\"UTF-8\\\">\\n<meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0, viewport-fit=cover\\\">\\n<title>LaunchKit Pro — সম্পূর্ণ ডিজিটাল বিজনেস স্টার্টার সিস্টেম</title>\\n<meta name=\\\"description\\\" content=\\\"আপনার বিজনেস দ্রুত শুরু ও বড় করার জন্য দরকারি সব টেমপ্লেট, গাইড এবং টুলস — এক জায়গায়।\\\">\\n<link rel=\\\"preconnect\\\" href=\\\"https://fonts.googleapis.com\\\">\\n<link rel=\\\"preconnect\\\" href=\\\"https://fonts.gstatic.com\\\" crossorigin>\\n<link href=\\\"https://fonts.googleapis.com/css2?family=Hind+Siliguri:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap\\\" rel=\\\"stylesheet\\\">\\n<style>\\n  :root{\\n    --primary:#FF6B00;\\n    --primary-dark:#E35F00;\\n    --primary-tint:#FFF1E6;\\n    --ink:#111111;\\n    --ink-soft:#4B4B52;\\n    --bg:#FFFFFF;\\n    --bg-alt:#FAF9F8;\\n    --success:#22C55E;\\n    --danger:#EF4444;\\n    --accent:#2563EB;\\n    --line:#ECEAE7;\\n    --container:1200px;\\n    --radius:18px;\\n    --radius-btn:14px;\\n    --shadow-sm:0 2px 10px rgba(17,17,17,.05);\\n    --shadow-md:0 12px 32px rgba(17,17,17,.08);\\n    --shadow-lg:0 24px 60px rgba(17,17,17,.14);\\n    --shadow-primary:0 14px 30px rgba(255,107,0,.28);\\n    --font-display:'Hind Siliguri','Poppins', sans-serif;\\n    --font-body:'Hind Siliguri', sans-serif;\\n  }\\n  *{box-sizing:border-box;margin:0;padding:0;}\\n  html{scroll-behavior:smooth;}\\n  body{\\n    font-family:var(--font-body);\\n    color:var(--ink);\\n    background:var(--bg);\\n    -webkit-font-smoothing:antialiased;\\n    line-height:1.65;\\n    overflow-x:hidden;\\n  }\\n  img{max-width:100%;display:block;}\\n  a{color:inherit;text-decoration:none;}\\n  ul{list-style:none;}\\n  button{font-family:inherit;cursor:pointer;border:none;background:none;}\\n  .container{width:100%;max-width:var(--container);margin:0 auto;padding:0 24px;}\\n  section{position:relative;}\\n  h1,h2,h3,h4{font-family:var(--font-display);font-weight:700;line-height:1.28;letter-spacing:0;color:var(--ink);}\\n  .eng{font-family:'Poppins', sans-serif;}\\n  .eyebrow{\\n    display:inline-flex;align-items:center;gap:8px;\\n    font-size:13px;font-weight:600;letter-spacing:.02em;\\n    color:var(--primary-dark);\\n    background:var(--primary-tint);\\n    padding:7px 14px;border-radius:999px;\\n  }\\n  /* Buttons */\\n  .btn{\\n    display:inline-flex;align-items:center;justify-content:center;gap:10px;\\n    font-weight:700;font-size:16.5px;\\n    padding:16px 30px;border-radius:var(--radius-btn);\\n    transition:transform .22s ease, box-shadow .22s ease, background .22s ease;\\n    white-space:nowrap;\\n  }\\n  .btn-primary{\\n    background:linear-gradient(180deg,#FF7A1A,var(--primary));\\n    color:#fff;\\n    box-shadow:var(--shadow-primary);\\n  }\\n  .btn-primary:hover{transform:translateY(-2px);box-shadow:0 18px 38px rgba(255,107,0,.36);}\\n  .btn-primary:active{transform:translateY(0);}\\n  .btn-ghost{\\n    background:#fff;color:var(--ink);border:1.5px solid var(--line);\\n  }\\n  .btn-ghost:hover{border-color:var(--ink);transform:translateY(-2px);}\\n  .btn-block{width:100%;}\\n  .btn-lg{padding:19px 36px;font-size:19px;}\\n  /* Reveal animation */\\n  .reveal{opacity:0;transform:translateY(26px);transition:opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1);}\\n  .reveal.in-view{opacity:1;transform:translateY(0);}\\n  .reveal-delay-1{transition-delay:.08s;}\\n  .reveal-delay-2{transition-delay:.16s;}\\n  .reveal-delay-3{transition-delay:.24s;}\\n  .reveal-delay-4{transition-delay:.32s;}\\n  @media (prefers-reduced-motion: reduce){\\n    .reveal{opacity:1;transform:none;transition:none;}\\n    html{scroll-behavior:auto;}\\n  }\\n  /* ============ NAV ============ */\\n  .nav{\\n    position:sticky;top:0;z-index:60;\\n    background:rgba(255,255,255,.82);\\n    backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);\\n    border-bottom:1px solid var(--line);\\n  }\\n  .nav-inner{display:flex;align-items:center;justify-content:space-between;height:74px;}\\n  .brand{display:flex;align-items:center;gap:10px;font-family:var(--font-display);font-weight:800;font-size:19px;}\\n  .brand-mark{\\n    width:32px;height:32px;border-radius:9px;\\n    background:linear-gradient(135deg,var(--primary),#FFB25C);\\n    display:flex;align-items:center;justify-content:center;color:#fff;font-size:15px;font-weight:800;\\n  }\\n  .nav-cta{display:flex;align-items:center;gap:14px;}\\n  .nav-price{display:none;}\\n  @media(min-width:860px){.nav-price{display:inline-block;font-weight:700;color:var(--ink-soft);font-size:14px;}}\\n  /* ============ HERO ============ */\\n  .hero{\\n    padding:56px 0 64px;\\n    background:\\n      radial-gradient(680px 420px at 82% -8%, rgba(255,107,0,.10), transparent 60%),\\n      radial-gradient(520px 360px at -6% 30%, rgba(37,99,235,.06), transparent 60%),\\n      var(--bg);\\n    overflow:hidden;\\n  }\\n  .hero-grid{display:grid;grid-template-columns:1fr;gap:44px;align-items:center;}\\n  @media(min-width:960px){.hero-grid{grid-template-columns:1.05fr .95fr;gap:56px;}}\\n  .badge-pulse{\\n    display:inline-flex;align-items:center;gap:8px;\\n    background:var(--ink);color:#fff;font-weight:600;font-size:13.5px;\\n    padding:8px 16px;border-radius:999px;margin-bottom:22px;\\n  }\\n  .badge-dot{width:7px;height:7px;border-radius:50%;background:var(--primary);animation:pulseDot 1.6s infinite;}\\n  @keyframes pulseDot{0%,100%{opacity:1;transform:scale(1);}50%{opacity:.4;transform:scale(1.35);}}\\n  .hero h1{font-size:clamp(30px,4.6vw,48px);margin-bottom:18px;}\\n  .hero h1 .hl{color:var(--primary);position:relative;}\\n  .hero-sub{font-size:18px;color:var(--ink-soft);max-width:530px;margin-bottom:26px;}\\n  .hero-points{display:grid;grid-template-columns:1fr 1fr;gap:12px 20px;margin-bottom:32px;max-width:480px;}\\n  .hero-point{display:flex;align-items:center;gap:10px;font-weight:600;font-size:14.5px;}\\n  .check-ic{\\n    width:20px;height:20px;border-radius:50%;flex:none;\\n    background:rgba(34,197,94,.12);color:var(--success);\\n    display:flex;align-items:center;justify-content:center;font-size:12px;\\n  }\\n  .price-box{\\n    background:#fff;border:1.5px solid var(--line);border-radius:var(--radius);\\n    padding:24px;box-shadow:var(--shadow-md);max-width:460px;\\n  }\\n  .price-row{display:flex;align-items:flex-end;gap:14px;flex-wrap:wrap;margin-bottom:6px;}\\n  .price-old{font-size:19px;color:#9A9A9F;text-decoration:line-through;font-weight:600;}\\n  .price-now{font-size:36px;font-weight:800;font-family:var(--font-display);color:var(--ink);}\\n  .price-badge{\\n    background:rgba(34,197,94,.12);color:#158B44;font-weight:700;font-size:13px;\\n    padding:5px 11px;border-radius:999px;\\n  }\\n  .price-note{font-size:13.5px;color:var(--ink-soft);margin-bottom:16px;}\\n  .pay-icons{display:flex;gap:8px;margin-bottom:16px;flex-wrap:wrap;}\\n  .pay-icons span{\\n    font-size:11.5px;font-weight:700;padding:5px 10px;border-radius:8px;\\n    border:1px solid var(--line);color:var(--ink-soft);background:var(--bg-alt);\\n  }\\n  .countdown{display:flex;gap:10px;margin-bottom:18px;}\\n  .cd-unit{flex:1;background:var(--bg-alt);border-radius:12px;padding:10px 6px;text-align:center;}\\n  .cd-num{font-family:var(--font-display);font-weight:800;font-size:22px;color:var(--ink);font-variant-numeric:tabular-nums;}\\n  .cd-label{font-size:11px;color:var(--ink-soft);}\\n  .trust-row{display:flex;flex-wrap:wrap;gap:14px;margin-top:16px;font-size:12.5px;color:var(--ink-soft);font-weight:600;}\\n  .trust-row span{display:flex;align-items:center;gap:6px;}\\n  /* hero mockup — stacked deck signature */\\n  .hero-visual{position:relative;display:flex;justify-content:center;align-items:center;min-height:360px;}\\n  .deck{position:relative;width:100%;max-width:400px;aspect-ratio:4/5;}\\n  .deck-card{\\n    position:absolute;inset:0;border-radius:20px;\\n    box-shadow:var(--shadow-lg);\\n    display:flex;flex-direction:column;justify-content:space-between;padding:26px;\\n    transition:transform .5s cubic-bezier(.16,1,.3,1);\\n  }\\n  .deck-card:nth-child(1){background:linear-gradient(155deg,#FFFFFF,#FFF6EE);transform:rotate(-9deg) translate(-16px,10px);z-index:1;border:1px solid var(--line);}\\n  .deck-card:nth-child(2){background:linear-gradient(155deg,#11131A,#22252E);transform:rotate(5deg) translate(14px,2px);z-index:2;color:#fff;}\\n  .deck-card:nth-child(3){background:linear-gradient(160deg,var(--primary),#FF8A3D);transform:rotate(-1deg);z-index:3;color:#fff;}\\n  .hero-visual:hover .deck-card:nth-child(1){transform:rotate(-13deg) translate(-26px,16px);}\\n  .hero-visual:hover .deck-card:nth-child(2){transform:rotate(8deg) translate(22px,4px);}\\n  .hero-visual:hover .deck-card:nth-child(3){transform:rotate(-2deg) translate(0,-6px);}\\n  .deck-tag{font-size:11.5px;font-weight:700;opacity:.85;}\\n  .deck-title{font-family:var(--font-display);font-weight:800;font-size:20px;margin-top:6px;}\\n  .deck-glyph{font-size:34px;}\\n  /* ============ SOCIAL PROOF ============ */\\n  .proof{padding:40px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--bg-alt);}\\n  .proof-inner{display:flex;flex-wrap:wrap;gap:28px;align-items:center;justify-content:space-between;}\\n  .stars{color:var(--primary);font-size:18px;letter-spacing:2px;}\\n  .proof-stat{display:flex;flex-direction:column;}\\n  .proof-stat b{font-family:var(--font-display);font-size:22px;}\\n  .proof-stat span{font-size:13px;color:var(--ink-soft);}\\n  .avatars{display:flex;}\\n  .avatars span{\\n    width:38px;height:38px;border-radius:50%;border:2.5px solid #fff;\\n    background:linear-gradient(135deg,var(--accent),#6C9BFF);\\n    color:#fff;font-weight:700;font-size:13px;display:flex;align-items:center;justify-content:center;\\n    margin-left:-10px;box-shadow:var(--shadow-sm);\\n  }\\n  .avatars span:first-child{margin-left:0;}\\n  .badge-row{display:flex;gap:22px;flex-wrap:wrap;color:var(--ink-soft);font-size:13px;font-weight:600;}\\n  .badge-row span{display:flex;align-items:center;gap:6px;}\\n  /* ============ SECTION HEADERS ============ */\\n  .sec{padding:88px 0;}\\n  .sec-head{max-width:640px;margin:0 auto 48px;text-align:center;}\\n  .sec-head h2{font-size:clamp(25px,3.4vw,36px);margin-top:14px;}\\n  .sec-head p{color:var(--ink-soft);font-size:16.5px;margin-top:12px;}\\n  .sec-alt{background:var(--bg-alt);}\\n  /* ============ CARDS GRID ============ */\\n  .grid{display:grid;gap:22px;}\\n  .grid-2{grid-template-columns:1fr;}\\n  .grid-3{grid-template-columns:1fr;}\\n  .grid-4{grid-template-columns:1fr;}\\n  @media(min-width:640px){.grid-2{grid-template-columns:1fr 1fr;}.grid-4{grid-template-columns:1fr 1fr;}}\\n  @media(min-width:900px){.grid-3{grid-template-columns:repeat(3,1fr);}.grid-4{grid-template-columns:repeat(4,1fr);}}\\n  .card{\\n    background:#fff;border:1px solid var(--line);border-radius:var(--radius);\\n    padding:28px;transition:transform .3s ease, box-shadow .3s ease, border-color .3s ease;\\n  }\\n  .card:hover{transform:translateY(-5px);box-shadow:var(--shadow-md);border-color:transparent;}\\n  .card-ic{\\n    width:48px;height:48px;border-radius:13px;display:flex;align-items:center;justify-content:center;\\n    font-size:22px;margin-bottom:16px;\\n  }\\n  .ic-pain{background:rgba(239,68,68,.09);}\\n  .ic-good{background:var(--primary-tint);}\\n  .ic-blue{background:rgba(37,99,235,.09);}\\n  .card h3{font-size:17.5px;margin-bottom:8px;}\\n  .card p{color:var(--ink-soft);font-size:14.5px;}\\n  .pain-card{border-color:var(--line);}\\n  .pain-card .card-ic{color:var(--danger);}\\n  /* ============ SOLUTION ============ */\\n  .solution-wrap{display:grid;grid-template-columns:1fr;gap:40px;align-items:center;}\\n  @media(min-width:900px){.solution-wrap{grid-template-columns:1fr 1fr;}}\\n  .solution-art{\\n    background:linear-gradient(160deg,#11131A,#262a35);border-radius:var(--radius);\\n    padding:40px;color:#fff;min-height:340px;display:flex;flex-direction:column;justify-content:center;gap:18px;\\n    box-shadow:var(--shadow-lg);\\n  }\\n  .solution-row{display:flex;align-items:center;gap:14px;padding:14px 16px;background:rgba(255,255,255,.06);border-radius:12px;font-size:15px;}\\n  .solution-row .ok{color:var(--success);font-weight:800;}\\n  .solution-copy h2{margin-bottom:16px;}\\n  .solution-copy p{color:var(--ink-soft);margin-bottom:24px;font-size:16px;}\\n  /* ============ PREVIEW / device mockups ============ */\\n  .device-wrap{display:grid;grid-template-columns:1fr;gap:24px;align-items:end;}\\n  @media(min-width:900px){.device-wrap{grid-template-columns:2fr 1fr;}}\\n  .device{\\n    background:linear-gradient(160deg,#F4F2EF,#fff);border:1px solid var(--line);border-radius:var(--radius);\\n    box-shadow:var(--shadow-md);overflow:hidden;\\n  }\\n  .device-bar{height:34px;background:#EFEDEA;display:flex;align-items:center;gap:6px;padding:0 14px;}\\n  .device-bar i{width:9px;height:9px;border-radius:50%;background:#D9D6D1;}\\n  .device-screen{aspect-ratio:16/10;background:\\n    linear-gradient(135deg, rgba(255,107,0,.14), rgba(37,99,235,.10)),\\n    repeating-linear-gradient(45deg, rgba(17,17,17,.03) 0 2px, transparent 2px 26px);\\n  }\\n  .device-mobile .device-screen{aspect-ratio:9/16;}\\n  /* ============ FEATURES two-col ============ */\\n  .feat-wrap{display:grid;grid-template-columns:1fr;gap:40px;align-items:center;}\\n  @media(min-width:900px){.feat-wrap{grid-template-columns:1fr 1.1fr;}}\\n  .feat-art{\\n    aspect-ratio:1/1;border-radius:var(--radius);\\n    background:conic-gradient(from 200deg, var(--primary-tint), #fff 30%, rgba(37,99,235,.08) 70%, var(--primary-tint));\\n    border:1px solid var(--line);box-shadow:var(--shadow-md);\\n    display:flex;align-items:center;justify-content:center;font-size:64px;\\n  }\\n  .feat-list li{display:flex;gap:14px;padding:16px 0;border-bottom:1px solid var(--line);}\\n  .feat-list li:last-child{border-bottom:none;}\\n  .feat-list h4{font-size:15.5px;margin-bottom:4px;}\\n  .feat-list p{font-size:14px;color:var(--ink-soft);}\\n  /* ============ BONUSES ============ */\\n  .bonus-card{\\n    background:linear-gradient(160deg,#fff,var(--primary-tint));\\n    border:1.5px dashed #FFC896;border-radius:var(--radius);\\n    padding:26px;position:relative;overflow:hidden;\\n  }\\n  .bonus-value{position:absolute;top:18px;right:18px;background:var(--ink);color:#fff;font-size:11px;font-weight:700;padding:5px 10px;border-radius:8px;}\\n  .bonus-card .card-ic{background:#fff;}\\n  /* ============ COMPARISON ============ */\\n  .compare-table{width:100%;border-collapse:separate;border-spacing:0;background:#fff;border-radius:var(--radius);overflow:hidden;box-shadow:var(--shadow-sm);border:1px solid var(--line);}\\n  .compare-table th,.compare-table td{padding:16px 18px;text-align:left;font-size:14.5px;border-bottom:1px solid var(--line);}\\n  .compare-table th{font-family:var(--font-display);font-size:14.5px;background:var(--bg-alt);}\\n  .compare-table th.win{background:var(--primary);color:#fff;}\\n  .compare-table tr:last-child td{border-bottom:none;}\\n  .yes{color:var(--success);font-weight:800;}\\n  .no{color:var(--danger);font-weight:800;}\\n  .compare-scroll{overflow-x:auto;-webkit-overflow-scrolling:touch;}\\n  /* ============ TESTIMONIALS ============ */\\n  .test-card{background:#fff;border:1px solid var(--line);border-radius:var(--radius);padding:26px;}\\n  .test-stars{color:var(--primary);font-size:14px;margin-bottom:12px;}\\n  .test-quote{font-size:15.5px;color:var(--ink);margin-bottom:18px;}\\n  .test-who{display:flex;align-items:center;gap:12px;}\\n  .test-av{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#6C9BFF);color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;}\\n  .test-who b{font-size:13.5px;display:block;}\\n  .test-who span{font-size:12px;color:var(--ink-soft);}\\n  .video-badge{display:inline-flex;align-items:center;gap:6px;background:var(--ink);color:#fff;font-size:11.5px;font-weight:700;padding:4px 10px;border-radius:8px;margin-bottom:12px;}\\n  /* ============ HOW IT WORKS timeline ============ */\\n  .timeline{display:grid;grid-template-columns:1fr;gap:28px;position:relative;}\\n  @media(min-width:800px){.timeline{grid-template-columns:repeat(3,1fr);}\\n    .timeline::before{content:\\\"\\\";position:absolute;top:26px;left:12%;right:12%;height:2px;background:repeating-linear-gradient(90deg,var(--line) 0 8px,transparent 8px 16px);}\\n  }\\n  .tl-step{position:relative;text-align:center;}\\n  .tl-num{\\n    width:52px;height:52px;border-radius:50%;background:var(--ink);color:#fff;\\n    display:flex;align-items:center;justify-content:center;font-family:var(--font-display);font-weight:800;\\n    margin:0 auto 16px;position:relative;z-index:2;font-size:18px;\\n  }\\n  .tl-step:nth-child(2) .tl-num{background:var(--primary);}\\n  .tl-step h3{font-size:16.5px;margin-bottom:6px;}\\n  .tl-step p{font-size:14px;color:var(--ink-soft);max-width:230px;margin:0 auto;}\\n  /* ============ FAQ ============ */\\n  .faq-item{border-bottom:1px solid var(--line);}\\n  .faq-q{\\n    width:100%;display:flex;justify-content:space-between;align-items:center;gap:16px;\\n    padding:20px 4px;text-align:right;flex-direction:row-reverse;font-weight:600;font-size:15.5px;\\n  }\\n  .faq-q .plus{flex:none;width:26px;height:26px;border-radius:50%;background:var(--bg-alt);display:flex;align-items:center;justify-content:center;transition:transform .3s ease, background .3s ease;font-size:16px;color:var(--ink);}\\n  .faq-item.open .faq-q .plus{transform:rotate(45deg);background:var(--primary);color:#fff;}\\n  .faq-a{max-height:0;overflow:hidden;transition:max-height .35s ease;}\\n  .faq-a-inner{padding:0 4px 20px;color:var(--ink-soft);font-size:14.5px;max-width:640px;text-align:right;margin-right:0;margin-left:auto;}\\n  /* ============ GUARANTEE ============ */\\n  .guarantee{\\n    background:linear-gradient(160deg,#11131A,#22252E);border-radius:var(--radius);\\n    padding:56px 24px;text-align:center;color:#fff;box-shadow:var(--shadow-lg);\\n  }\\n  .guarantee-badge{\\n    width:96px;height:96px;border-radius:50%;background:rgba(255,107,0,.15);border:2px solid var(--primary);\\n    display:flex;align-items:center;justify-content:center;font-size:40px;margin:0 auto 22px;\\n  }\\n  .guarantee h2{color:#fff;font-size:26px;margin-bottom:12px;}\\n  .guarantee p{color:#B9B9C2;max-width:480px;margin:0 auto 22px;font-size:15.5px;}\\n  /* ============ FINAL CTA ============ */\\n  .final-cta{\\n    background:linear-gradient(155deg,var(--primary),#FF8A3D);\\n    border-radius:var(--radius);padding:56px 28px;text-align:center;color:#fff;position:relative;overflow:hidden;\\n  }\\n  .final-cta::after{content:\\\"\\\";position:absolute;inset:0;background:radial-gradient(400px 200px at 85% 0%, rgba(255,255,255,.22), transparent 70%);}\\n  .final-cta h2{color:#fff;font-size:clamp(23px,3.4vw,32px);margin-bottom:12px;}\\n  .final-cta p{color:rgba(255,255,255,.9);margin-bottom:26px;position:relative;}\\n  .stock-bar{max-width:420px;margin:0 auto 26px;position:relative;}\\n  .stock-track{height:9px;background:rgba(255,255,255,.28);border-radius:999px;overflow:hidden;}\\n  .stock-fill{height:100%;width:82%;background:#fff;border-radius:999px;}\\n  .stock-label{font-size:12.5px;margin-top:8px;color:rgba(255,255,255,.9);font-weight:600;}\\n  .final-cta .btn-primary{background:#111;box-shadow:0 14px 30px rgba(0,0,0,.28);}\\n  .final-cta .countdown{max-width:360px;margin:0 auto 22px;position:relative;}\\n  .final-cta .cd-unit{background:rgba(255,255,255,.14);}\\n  .final-cta .cd-num,.final-cta .cd-label{color:#fff;}\\n  /* ============ FLOATING ELEMENTS ============ */\\n  .fab-stack{position:fixed;right:20px;bottom:96px;display:flex;flex-direction:column;gap:12px;z-index:70;}\\n  @media(min-width:860px){.fab-stack{bottom:28px;}}\\n  .fab{\\n    width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;\\n    font-size:22px;color:#fff;box-shadow:var(--shadow-md);transition:transform .25s ease, opacity .25s ease;\\n    opacity:0;transform:translateY(14px) scale(.8);pointer-events:none;\\n  }\\n  .fab.show{opacity:1;transform:translateY(0) scale(1);pointer-events:auto;}\\n  .fab:hover{transform:translateY(-3px) scale(1.05);}\\n  .fab-wa{background:#25D366;}\\n  .fab-msg{background:linear-gradient(135deg,#0084FF,#00C6FF);}\\n  .fab-top{background:var(--ink);font-size:17px;}\\n  .sticky-cta{\\n    position:fixed;left:0;right:0;bottom:0;z-index:65;\\n    background:#fff;border-top:1px solid var(--line);box-shadow:0 -8px 24px rgba(17,17,17,.08);\\n    padding:12px 16px;display:flex;align-items:center;gap:14px;\\n    transform:translateY(110%);transition:transform .3s ease;\\n  }\\n  .sticky-cta.show{transform:translateY(0);}\\n  .sticky-cta .sc-price{flex:none;}\\n  .sticky-cta .sc-price b{display:block;font-family:var(--font-display);font-size:18px;}\\n  .sticky-cta .sc-price s{font-size:12px;color:#9A9A9F;}\\n  .sticky-cta .btn{flex:1;padding:14px 18px;font-size:15.5px;}\\n  @media(min-width:860px){.sticky-cta{display:none;}}\\n  .desktop-sticky-bar{\\n    position:fixed;top:0;left:0;right:0;z-index:59;\\n    background:#fff;border-bottom:1px solid var(--line);box-shadow:var(--shadow-sm);\\n    transform:translateY(-110%);transition:transform .3s ease;\\n  }\\n  .desktop-sticky-bar.show{transform:translateY(0);}\\n  .dsb-inner{display:flex;align-items:center;justify-content:space-between;height:70px;}\\n  .dsb-left{display:flex;align-items:center;gap:14px;}\\n  .dsb-left b{font-family:var(--font-display);font-size:15.5px;}\\n  .dsb-left span{font-size:13px;color:var(--ink-soft);}\\n  @media(max-width:859px){.desktop-sticky-bar{display:none;}}\\n  /* utility */\\n  .center{text-align:center;}\\n  .mt-32{margin-top:32px;}\\n  .muted{color:var(--ink-soft);}\\n  a:focus-visible,button:focus-visible{outline:2.5px solid var(--accent);outline-offset:3px;border-radius:8px;}\\n</style>\\n</head>\\n<body>\\n<!-- Desktop sticky buy bar (appears after scroll) -->\\n      LK\\n        <b>LaunchKit Pro</b>\\n        ডিজিটাল বিজনেস স্টার্টার সিস্টেম\\n    <a href=\\\"#buy\\\">এখনই কিনুন — ৳১,৪৯০</a>\\n<!-- ============ NAV ============ -->\\n<nav>\\n      LK\\n      LaunchKit&nbsp;Pro\\n      <s style=\\\"color:#9A9A9F;font-weight:500;\\\">৳৪,৯৯০</s>&nbsp; ৳১,৪৯০\\n      <a href=\\\"#buy\\\">এখনই কিনুন</a>\\n</nav>\\n<!-- ============ SECTION 1 — HERO ============ -->\\n<header>\\n       &#x1f525; লিমিটেড টাইম অফার — ৭০% ছাড়\\n      <h1>আপনার বিজনেসকে বদলে দিন এই পাওয়ারফুল ডিজিটাল সিস্টেম দিয়ে</h1>\\n      <p>সময় বাঁচাতে, বিক্রি বাড়াতে আর দ্রুত বড় হতে যা যা লাগবে — সবকিছু একসাথে। যারা প্রথম থেকে শুরু না করে সরাসরি লঞ্চ করতে চান, তাদের জন্য বানানো।</p>\\n        ✓ সাথে সাথে ডাউনলোড\\n        ✓ লাইফটাইম অ্যাক্সেস\\n        ✓ ফ্রি ফিউচার আপডেট\\n        ✓ বিগিনার ফ্রেন্ডলি\\n          ৳৪,৯৯০\\n          ৳১,৪৯০\\n          ৭০% সাশ্রয়\\n        <p>একবারই পেমেন্ট। কোনো সাবস্ক্রিপশন বা লুকানো চার্জ নেই।</p>\\n          bKashNagadRocketCardSSLCommerz\\n          ০৮ঘণ্টা\\n          ৪২মিনিট\\n          ১৫সেকেন্ড\\n        <a href=\\\"#buy-final\\\">এখনই কিনুন</a>\\n          &#x1f512; SSL সিকিউর পেমেন্ট\\n          &#x26a1; সাথে সাথে অ্যাক্সেস\\n          &#x1f3a7; ৭ দিন সাপোর্ট\\n            টেমপ্লেট\\n            32 সেলস পেজ\\n          &#x1f5c2;&#xfe0f;\\n            ভিডিও কোর্স\\n            ৬ ঘণ্টার ট্রেনিং\\n          &#x1f3ac;\\n            Toolkit\\n            LaunchKit Pro\\n          &#x1f680;\\n</header>\\n<!-- ============ SECTION 2 — SOCIAL PROOF ============ -->\\n<section>\\n      ★★★★★\\n    <b>৪.৯/৫</b>গড় রেটিং\\n    <b>১০,০০০+</b>সন্তুষ্ট গ্রাহক\\n      রাসামিতা+\\n      &#x1f512; ভেরিফায়েড পেমেন্ট\\n      &#x1f3c6; টপ রেটেড ২০২৬\\n      &#x1f6e1;&#xfe0f; মানি-ব্যাক গ্যারান্টি\\n</section>\\n<!-- ============ SECTION 3 — PROBLEM ============ -->\\n<section>\\n      সমস্যা\\n      <h2>চেনা লাগছে না?</h2>\\n      <p>বেশিরভাগ উদ্যোক্তা পরিশ্রমের অভাবে পিছিয়ে পড়েন না। প্রতিবার নতুন করে চাকা বানাতে গিয়ে, একা একা, সময় হারিয়ে ফেলেন।</p>\\n        &#x23f3;\\n        <h3>সেটআপেই সময় শেষ</h3>\\n        <p>কাস্টমারের সাথে কথা বলার চেয়ে বেশি সময় যায় ডকুমেন্ট ফরম্যাট করতে।</p>\\n        &#x1f9e9;\\n        <h3>এলোমেলো পরামর্শ</h3>\\n        <p>প্রতিটা ইউটিউব ভিডিও আগেরটার সাথে বিপরীত, আর কোনোটাই আপনার বিজনেসের জন্য ফিট না।</p>\\n        &#x1f4b8;\\n        <h3>ফ্রিল্যান্সারের খরচ</h3>\\n        <p>প্রতিটা টেমপ্লেট আর পেজের জন্য বাইরে থেকে বানাতে গেলে বাজেট শেষ, তাও লঞ্চের আগেই।</p>\\n        &#x1f4c9;\\n        <h3>মোমেন্টাম হারানো</h3>\\n        <p>সব কিছু \\\"রেডি\\\" হতে হতে যে উৎসাহ নিয়ে শুরু করেছিলেন, সেটাই আর থাকে না।</p>\\n</section>\\n<!-- ============ SECTION 4 — SOLUTION ============ -->\\n<section>\\n      সমাধান\\n      <h2>একটাই সিস্টেম, সব কিছু আগে থেকেই রেডি</h2>\\n      <p>LaunchKit Pro আন্দাজে চলা বাদ দিয়ে একটা রেডিমেড সিস্টেম দেয় — টেমপ্লেট, ট্রেনিং আর টুলস সব আগে থেকেই বানানো, শুধু আপনার বিজনেস বসিয়ে লাইভ করুন।</p>\\n      <a href=\\\"#buy-final\\\">ভেতরে কী আছে দেখুন</a>\\n      ✓ এক ঘণ্টার মধ্যে অফার পেজ রেডি করুন\\n      ✓ প্রমাণিত ধাপে ধাপে সিস্টেম ফলো করুন\\n      ✓ ট্রায়াল-অ্যান্ড-এরর সম্পূর্ণ এড়িয়ে যান\\n      ✓ আন্দাজে না, আত্মবিশ্বাস নিয়ে লঞ্চ করুন\\n</section>\\n<!-- ============ SECTION 5 — WHAT'S INCLUDED ============ -->\\n<section>\\n      প্যাকেজে যা যা আছে\\n      <h2>যা দরকার সবই আছে, বাড়তি কিছু নেই</h2>\\n      <p>ছয়টা অংশ, প্রথম দিন থেকেই একসাথে কাজ করার জন্য বানানো।</p>\\n        &#x1f3ac;\\n        <h3>ভিডিও কোর্স</h3>\\n        <p>৬ ঘণ্টার ধাপে ধাপে ট্রেনিং, ছোট ছোট প্র্যাকটিক্যাল লেসনে ভাগ করা।</p>\\n        &#x1f5c2;&#xfe0f;\\n        <h3>টেমপ্লেট</h3>\\n        <p>পেজ, অফার আর আউটরিচের জন্য ৩২টা রেডি-টু-এডিট টেমপ্লেট।</p>\\n        &#x1f381;\\n        <h3>বোনাস ফাইল</h3>\\n        <p>ট্র্যাকে থাকতে সোয়াইপ ফাইল, চেকলিস্ট আর প্ল্যানার।</p>\\n        &#x1f4c1;\\n        <h3>সোর্স ফাইল</h3>\\n        <p>সম্পূর্ণ এডিটেবল সোর্স ফাইল — Figma, Canva আর ডকুমেন্ট ফরম্যাটে।</p>\\n        &#x1f465;\\n        <h3>কমিউনিটি অ্যাক্সেস</h3>\\n        <p>ফিডব্যাক আর সাফল্য শেয়ার করা উদ্যোক্তাদের একটা প্রাইভেট গ্রুপ।</p>\\n        &#x1f504;\\n        <h3>ফ্রি আপডেট</h3>\\n        <p>কিটের প্রতিটা ভবিষ্যৎ আপডেট, লাইফটাইমের জন্য, কোনো বাড়তি খরচ ছাড়াই।</p>\\n</section>\\n<!-- ============ SECTION 6 — PRODUCT PREVIEW ============ -->\\n<section>\\n      ভেতরে একবার দেখে নিন\\n      <h2>যেখানেই দেখুন, দেখতে সুন্দর লাগবে</h2>\\n      <p>প্রতিটা টেমপ্লেট ডেস্কটপ থেকে মোবাইল পর্যন্ত ঠিকঠাক মানিয়ে যায়।</p>\\n        <i></i><i></i><i></i>\\n        <i></i><i></i><i></i>\\n</section>\\n<!-- ============ SECTION 7 — FEATURES ============ -->\\n<section>\\n    &#x1f9ed;\\n      ফিচার\\n      <h2 style=\\\"margin-bottom:22px;\\\">ডিজাইনারদের জন্য না, উদ্যোক্তাদের জন্য বানানো</h2>\\n      <ul>\\n        <li>✓<h4>ডিজাইন স্কিল লাগবে না</h4><p>প্রতিটা টেমপ্লেট আগে থেকেই স্টাইল করা — শুধু টেক্সট আর ছবি বদলে দিন।</p></li>\\n        <li>✓<h4>যেকোনো প্ল্যাটফর্মে কাজ করে</h4><p>আপনি এখন যেসব টুল ব্যবহার করেন তাতেই ঠিকঠাক এক্সপোর্ট হয়, কোনো লক-ইন নেই।</p></li>\\n        <li>✓<h4>ধাপে ধাপে গাইডেন্স</h4><p>প্রতিটা মডিউল ঠিক বলে দেয় পরের ধাপে কী করতে হবে।</p></li>\\n        <li>✓<h4>লাইফটাইম অ্যাক্সেস</h4><p>একবার পেমেন্ট করে কিটের সব আপডেট চিরকালের জন্য রাখুন।</p></li>\\n      </ul>\\n</section>\\n<!-- ============ SECTION 8 — BONUSES ============ -->\\n<section>\\n      বোনাস\\n      <h2>৳১৫,৬০০ মূল্যের বোনাস, একদম ফ্রি</h2>\\n      <p>আজই কিনলে এগুলো আপনার অর্ডারের সাথে ফ্রি পাবেন।</p>\\n        মূল্য ৳৩,৫০০\\n        &#x1f39f;&#xfe0f;\\n        <h3>লঞ্চ চেকলিস্ট</h3>\\n        <p>লাইভ যাওয়ার আগে রিভিউ করার জন্য ঠিক ২১টা পয়েন্টের লিস্ট।</p>\\n        মূল্য ৳৬,৯০০\\n        &#x1f4ac;\\n        <h3>আউটরিচ স্ক্রিপ্ট</h3>\\n        <p>কোল্ড আউটরিচ আর ফলো-আপের জন্য ২০টা মেসেজ স্ক্রিপ্ট।</p>\\n        মূল্য ৳৫,২০০\\n        &#x1f4ca;\\n        <h3>প্রাইসিং ক্যালকুলেটর</h3>\\n        <p>আত্মবিশ্বাসের সাথে অফার প্রাইস করার জন্য রেডিমেড শিট।</p>\\n</section>\\n<!-- ============ SECTION 9 — COMPARISON ============ -->\\n<section>\\n      কেন LaunchKit Pro\\n      <h2>পার্থক্যটা স্পষ্ট</h2>\\n      <table>\\n        <thead>\\n          <tr><th>&nbsp;</th><th>LaunchKit ছাড়া</th><th>LaunchKit Pro সহ</th></tr>\\n        </thead>\\n        <tbody>\\n          <tr><td>লঞ্চ করতে সময়</td><td>✕ ৪–৬ সপ্তাহ</td><td>✓ ১–২ দিন</td></tr>\\n          <tr><td>ডিজাইন খরচ</td><td>✕ ৳২০,০০০+</td><td>✓ ইনক্লুডেড</td></tr>\\n          <tr><td>গাইডেন্স</td><td>✕ এলোমেলো ভিডিও</td><td>✓ স্ট্রাকচার্ড কোর্স</td></tr>\\n          <tr><td>এডিটেবল সোর্স ফাইল</td><td>✕ কালেভদ্রে</td><td>✓ সবসময়</td></tr>\\n          <tr><td>ভবিষ্যৎ আপডেট</td><td>✕ আবার পেমেন্ট</td><td>✓ লাইফটাইম ফ্রি</td></tr>\\n        </tbody>\\n      </table>\\n</section>\\n<!-- ============ SECTION 10 — TESTIMONIALS ============ -->\\n<section>\\n      গ্রাহকদের মতামত\\n      <h2>যারা দ্রুত লঞ্চ করে ফেলেছেন</h2>\\n        &#x25b6; ভিডিও রিভিউ\\n        ★★★★★\\n        <p>ছয় সপ্তাহের লঞ্চ টাইমলাইন একটা উইকেন্ডে নামিয়ে এনেছি। প্রতিটা পেজ নিয়ে আর সন্দেহ করতে হয়নি।</p>\\n        রফি<b>রফিউল আ.</b>ফাউন্ডার, পোশাক ব্র্যান্ড\\n        &#x1f5bc;&#xfe0f; স্ক্রিনশট রিভিউ\\n        ★★★★★\\n        <p>শুধু টেমপ্লেটগুলোই কিটের দাম উসুল করে দিয়েছে। বাকি সব যেন বোনাস।</p>\\n        সাদি<b>সাদিয়া ন.</b>কোর্স ক্রিয়েটর\\n        ★★★★★\\n        <p>প্রতিটা প্রশ্নের উত্তর একদিনের মধ্যেই পেয়েছি। এক-দফা পেমেন্টের প্রোডাক্টে এমন সাপোর্ট আশাই করিনি।</p>\\n        তন্ব<b>তানভীর হ.</b>এজেন্সি মালিক\\n</section>\\n<!-- ============ SECTION 11 — HOW IT WORKS ============ -->\\n<section>\\n      যেভাবে কাজ করে\\n      <h2>লঞ্চ করতে তিনটা ধাপ</h2>\\n      ১<h3>কিনুন</h3><p>সিকিউর চেকআউট, এক মিনিটেরও কম সময়ে।</p>\\n      ২<h3>ডাউনলোড করুন</h3><p>প্রতিটা ফাইল আর মডিউল সাথে সাথে অ্যাক্সেস করুন।</p>\\n      ৩<h3>ব্যবহার শুরু করুন</h3><p>কোর্স ফলো করে এই সপ্তাহেই লঞ্চ করুন।</p>\\n</section>\\n<!-- ============ SECTION 12 — FAQ ============ -->\\n<section>\\n      সাধারণ জিজ্ঞাসা\\n      <h2>প্রশ্নের উত্তর</h2>\\n        <button aria-expanded=\\\"false\\\">+ কেনার পর ঠিক কী কী পাব?</button>\\n        ভিডিও কোর্স, সবগুলো ৩২টা টেমপ্লেট, বোনাস ফাইল, সোর্স ফাইল, কমিউনিটি ইনভাইট আর প্রতিটা ভবিষ্যৎ আপডেটের সাথে সাথে অ্যাক্সেস।\\n        <button aria-expanded=\\\"false\\\">+ এটা কি কোনো সাবস্ক্রিপশন?</button>\\n        না। এটা একবার পেমেন্টের বিনিময়ে লাইফটাইম অ্যাক্সেস — কোনো বারবার চার্জ নেই।\\n        <button aria-expanded=\\\"false\\\">+ ডিজাইন বা টেকনিক্যাল স্কিল লাগবে কি?</button>\\n        একদমই না। প্রতিটা টেমপ্লেট আগে থেকেই বানানো — শুধু টেক্সট এডিট করুন আর ছবি বদলান, কোনো ডিজাইন এক্সপেরিয়েন্স লাগবে না।\\n        <button aria-expanded=\\\"false\\\">+ এটা কোন কোন টুলে কাজ করে?</button>\\n        সোর্স ফাইল আপনার পরিচিত ডিজাইন আর ডকুমেন্ট টুলে ঠিকঠাক এক্সপোর্ট হয়, তাই কোনো লক-ইন নেই।\\n        <button aria-expanded=\\\"false\\\">+ ডেলিভারি কত দ্রুত পাব?</button>\\n        পেমেন্টের সাথে সাথেই। কয়েক সেকেন্ডের মধ্যে ডাউনলোড লিংক আর অ্যাক্সেস ডিটেইলস পেয়ে যাবেন।\\n        <button aria-expanded=\\\"false\\\">+ কোনো গ্যারান্টি আছে?</button>\\n        হ্যাঁ — ৭ দিনের মানি-ব্যাক গ্যারান্টি। পছন্দ না হলে কোনো প্রশ্ন ছাড়াই রিফান্ড রিকোয়েস্ট করতে পারবেন।\\n        <button aria-expanded=\\\"false\\\">+ ফিউচার আপডেট কি ফ্রি পাব?</button>\\n        হ্যাঁ, LaunchKit Pro-র প্রতিটা ভবিষ্যৎ ভার্সন যতদিন এটা থাকবে ততদিন কোনো বাড়তি খরচ ছাড়াই পাবেন।\\n        <button aria-expanded=\\\"false\\\">+ একাধিক বিজনেসের জন্য ব্যবহার করতে পারব?</button>\\n        হ্যাঁ, আপনার লাইসেন্স যেকোনো সংখ্যক পার্সোনাল আর ক্লায়েন্ট প্রজেক্টে কভার করে।\\n        <button aria-expanded=\\\"false\\\">+ কোথাও আটকে গেলে কী করব?</button>\\n        ৭ দিনের সরাসরি সাপোর্ট পাবেন, সাথে কমিউনিটি থেকে সবসময় পিয়ার হেল্প।\\n        <button aria-expanded=\\\"false\\\">+ কীভাবে পেমেন্ট করব?</button>\\n        bKash, Nagad, Rocket, কার্ড এবং SSLCommerz-এর মাধ্যমে একটা SSL-সিকিউর চেকআউটে পেমেন্ট করতে পারবেন।\\n</section>\\n<!-- ============ SECTION 13 — MONEY BACK GUARANTEE ============ -->\\n<section>\\n      &#x1f6e1;&#xfe0f;\\n      <h2>৭ দিনের মানি-ব্যাক গ্যারান্টি</h2>\\n      <p>LaunchKit Pro একদম রিস্ক-ফ্রি ট্রাই করুন। ৭ দিনের মধ্যে মনে না ধরলে, কোনো ফর্ম বা ঝামেলা ছাড়াই পুরো টাকা ফেরত পাবেন।</p>\\n        &#x1f512; সিকিউর পারচেজ\\n        &#x1f4b3; এনক্রিপ্টেড চেকআউট\\n</section>\\n<!-- ============ SECTION 14 — FINAL CTA ============ -->\\n<section id=\\\"buy-final\\\" style=\\\"padding-top:0;\\\">\\n      &#x23f0; অফার শেষ হয়ে আসছে\\n      <h2>এই সুযোগ হাতছাড়া করবেন না</h2>\\n      <p>১০,০০০+ উদ্যোক্তা ইতিমধ্যে LaunchKit Pro দিয়ে লঞ্চ করে ফেলেছেন — আজই ৭০% ছাড়ে।</p>\\n        আজকের ডিসকাউন্ট স্পটের ৮২% বুকড\\n        ০৮ঘণ্টা\\n        ৪২মিনিট\\n        ১৫সেকেন্ড\\n      <a href=\\\"#buy\\\">এখনই কিনুন — ৳১,৪৯০</a>\\n</section>\\n<!-- ============ FLOATING ELEMENTS ============ -->\\n  <a href=\\\"https://wa.me/8801XXXXXXXXX\\\" aria-label=\\\"হোয়াটসঅ্যাপে চ্যাট করুন\\\">&#x1f4ac;</a>\\n  <a href=\\\"#\\\" aria-label=\\\"মেসেঞ্জারে চ্যাট করুন\\\">&#x2709;&#xfe0f;</a>\\n  <button id=\\\"backTop\\\" aria-label=\\\"উপরে ফিরে যান\\\">↑</button>\\n<!-- Mobile sticky CTA -->\\n  <b>৳১,৪৯০</b><s>৳৪,৯৯০</s>\\n  <a href=\\\"#buy\\\">এখনই কিনুন</a>\\n</body>\\n</html>\\t\\t\\t\\t\\n<!-- CHECKOUT SHORTCODE -->\\n<form name=\\\"checkout\\\" method=\\\"post\\\" action=\\\"https://ds.austagram.com/checkout/\\\" enctype=\\\"multipart/form-data\\\">\\n\\t<h3 id=\\\"your_products_heading\\\"> Your Products </h3>\\nE-COMMERCE COMBO1\\n\\t\\t&minus;\\n\\t\\t<input autocomplete=\\\"off\\\" type=\\\"number\\\" value=\\\"1\\\" step=\\\"1\\\" min=\\\"1\\\" name=\\\"wcf_qty_selection\\\" placeholder=\\\"1\\\" data-sale-limit=\\\"false\\\" title=\\\"\\\"  >\\n\\t\\t&plus;\\n\\t199.00&#2547;&nbsp;\\n\\t\\t\\t\\t<wc-order-attribution-inputs></wc-order-attribution-inputs>\\n\\t\\t<h3 id=\\\"billing_fields_heading\\\">Billing details</h3>\\n\\t\\t<p id=\\\"billing_first_name_field\\\" data-priority=\\\"10\\\"><label for=\\\"billing_first_name\\\">আপনার নামঃ&nbsp;*</label><input type=\\\"text\\\" name=\\\"billing_first_name\\\" id=\\\"billing_first_name\\\" placeholder=\\\"\\\"  value=\\\"dream\\\" aria-required=\\\"true\\\" autocomplete=\\\"given-name\\\" /></p><p id=\\\"billing_phone_field\\\" data-priority=\\\"100\\\"><label for=\\\"billing_pho