# ==============================================================================
# Production Environment Configuration Template
# Copy this file to .env on your VPS / CloudPanel instance and update values.
# ==============================================================================

# Application Environment (production / development)
NODE_ENV=production

# Application HTTP Port (Nginx reverse proxy targets this port)
PORT=3000

# Server Host Binding (127.0.0.1 recommended behind Nginx)
HOST=127.0.0.1

# Admin Panel Credentials
ADMIN_EMAIL=admin@gmail.com
ADMIN_PASSWORD=change_this_to_a_strong_password_in_production
ADMIN_SECRET_KEY=generate_a_random_64_character_hex_string_for_tokens

# Google Tag Manager Web & Server Configuration
GTM_CONTAINER_ID=GTM-XXXXXXX
GTM_SERVER_URL=https://track.YOUR_DOMAIN/
SGTM_CONTAINER_CONFIG=YOUR_SGTM_CONTAINER_CONFIG_STRING

# Meta Pixel & Conversions API Configuration (Secret - configure inside Server GTM / .env only)
META_PIXEL_ID=YOUR_PIXEL_ID
META_ACCESS_TOKEN=YOUR_META_ACCESS_TOKEN

# Database Storage Directory
DATABASE_PATH=./data/database.sqlite
BACKUP_PATH=./data/backups

# Request Rate Limiting (Requests per minute per IP for /api/orders)
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Courier & Fraud Check API (BD Courier: Steadfast, Pathao, RedX, Paperfly verification)
BD_COURIER_API_KEY=YOUR_BD_COURIER_BEARER_API_KEY

